# the Free Software Foundation; either version 3 of the License, or
# (at your option) any later version.
#
# Spot is distributed in the hope that it will be useful, but WITHOUT
# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
# or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
# License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

. ./defs || exit 1

set -e

# Make sure sort isn't affected by the user's LC_COLLATE
LC_ALL=C
export LC_ALL

ltlmix -fGa -fFb --tree-size=4 -n 50 -o out.ltl 2>stderr && exit 1
grep 'failed to generate a new unique formula' stderr
test 34 -eq `wc -l < out.ltl`

ltlmix -fGa -fFb --tree-size=4 -n 500 -L -o out.ltl 2>stderr && exit 1
grep 'failed to generate a new unique formula' stderr
test 448 -eq `wc -l < out.ltl`

P=--boolean-priorities=not=0,xor=0,equiv=0,implies=0
ltlmix -fGa -fFb --tree-size=4 -n 10 $P -o out.ltl 2>stderr && exit 1
grep 'failed to generate a new unique formula' stderr
test 4 -eq `wc -l < out.ltl`

ltlmix -fa -A9 --tree-size=1 -n9 | sort > list1
ltlmix -fa -P9 --tree-size=1 -n18 | sort > list2
grep -v '!' list2 > list3
diff list1 list3

# The following message appears only if run from a tty.
if (: > /dev/tty) >/dev/null 2>&1 ; then
   ltlmix -A9 -n10 </dev/tty 2>err && exit 2
   grep 'No formula to combine' err
fi


genltl --gf-equiv-xn=1..3 | ltlmix --tree-size=1 -A2 -n6 | sort >out
cat >expected <<EOF
GF(p0 <-> XXXp0)
GF(p0 <-> XXp0)
GF(p0 <-> Xp0)
GF(p1 <-> XXXp1)
GF(p1 <-> XXp1)
GF(p1 <-> Xp1)
EOF
diff out expected


genltl --and-gf=4 > in.ltl
ltlmix in.ltl --tree-size=1 -A1 --stats=%x > out.txt
ltlmix in.ltl --tree-size=1 -A2 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -A3 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -A4 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -A5 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -A6 --stats=%x >> out.txt

cat >expected <<EOF
1
2
3
4
4
4
EOF
diff out.txt expected

# Using -P won't change the number of atomic propositions
ltlmix in.ltl --tree-size=1 -P1 --stats=%x > out.txt
ltlmix in.ltl --tree-size=1 -P2 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -P3 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -P4 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -P5 --stats=%x >> out.txt
ltlmix in.ltl --tree-size=1 -P6 --stats=%x >> out.txt
diff out.txt expected

ltlmix -fa -A500 $P,or=0 -n10 | tee out
test 10 -eq `grep '&.*&' < out | wc -l`

ltlmix -fa -A500 -C3 -n10 | tee out2
diff out out2


ltlmix -fGi -fFo -A3,3 -C4 -n10 | tee out
cat >expected <<EOF
Fo1 & Gi1 & Gi2 & Fo0
Gi1 & Fo0 & Fo2
Fo1 & Gi1 & Gi2 & Fo2
Gi1 & Fo0 & Gi0
Fo1 & Gi1 & Gi2 & Gi0
Fo1 & Gi1 & Fo0 & Fo2
Fo1 & Gi1 & Fo2
Gi1 & Gi2 & Gi0
Fo1 & Gi1 & Fo0
Fo1 & Fo2 & Gi0
EOF
diff out expected

ltlmix -fGa -fFz -A3,3 --ins='/[a-m]/' -C4 -n10 > out
diff out expected

ltlmix -fGa -fFz -A3,3 --outs='/[m-o]/,z' -C4 -n10 > out
diff out expected


ltlmix -fGa -fFz -A3,3 -C4 -n10 2> err && exit 1
cat err
grep 'ins.*outs' err

echo '.inputs a c .outputs b d ' > part.part
ltlmix -fXa -fGb -f'c U d' --part-file=part.part -C4 -A3,3 -n10 >out
cat >expected <<EOF
(i1 U o2) & Go1 & (i0 U o2)
Go1 & (i0 U o2) & Xi1 & Go2
Go2 & (i2 U o1) & Xi2 & Go0
Go2 & Go0 & (i1 U o0) & Xi0
Go1 & Xi2 & Xi0 & (i0 U o0)
Xi1 & Xi2 & Go0 & (i2 U o0)
Xi1 & (i1 U o0) & Xi0 & (i1 U o1)
Go2 & Xi2 & (i0 U o0)
(i0 U o2) & (i0 U o0) & (i0 U o1)
Go1 & Xi0 & (i0 U o0) & (i0 U o1)
EOF
diff out expected

ltlmix -fXa -fGb -f'c U d' --part-file=part.part -C4 -A3 -n10 2>err && exit 1
grep 'two-argument version' err

ltlmix -B --seed=42 -fXa -fXb -fXc -n4 >out-B
cat >expect-B <<\EOF
Xb -> Xa
Xb
Xc xor (Xa & Xc)
Xa
EOF
diff out-B expect-B

P=--boolean-priorities=not=0,xor=0,equiv=0,implies=0
ltlmix $P -B --allow-dups --seed=42 -fXa -fXb -fXc -n4 >out-B2
cat >expect-B2 <<\EOF
Xa & Xb
Xa & Xb
Xc & (Xa | Xc)
Xb & (Xa | Xb)
EOF
diff out-B2 expect-B2

ltlmix $P -B --seed=42 -fXa -fXb -fXc -n4 >out-B3
cat >expect-B3 <<\EOF
Xa & Xb
Xc & (Xa | Xc)
Xb & (Xa | Xb)
Xa | (Xa & Xc)
EOF
diff out-B3 expect-B3

ltlmix $P -B --seed=42 --tree-size=5..2 -fXa -fXb -fXc -n4 >out-B4
cat >expect-B4 <<\EOF
Xb | Xc
Xa & Xb
Xc
Xa & Xc
EOF
diff out-B4 expect-B4

echo | ltlmix 2>err && exit 1
grep 'the set of subformulas to build from is empty' err

# --dump-priorities with -L (LTL output)
ltlmix -L -fGa --dump-priorities >out
grep 'Use --ltl-priorities' out

# --dump-priorities with -B (Boolean output)
ltlmix -B -fGa --dump-priorities >out
grep 'Use --boolean-priorities' out

# Reading a TLSF specification with --tlsf.  The signals of the
# specification below start with neither 'i' nor 'o', so they can only
# be classified thanks to the partition of the specification.
cat >up.tlsf <<EOF
INFO {
  TITLE:       "Upper"
  DESCRIPTION: "a game whose signals start with neither i nor o"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { AIn; }
  OUTPUTS { BOut; }
  GUARANTEES { G(AIn <-> X BOut) }
}
EOF
cat >up.part <<EOF
.inputs AIn
.outputs BOut
EOF

# Two specifications with conflicting partitions: 'a' and 'b' swap
# roles between them.
cat >a.tlsf <<EOF
INFO {
  TITLE:       "A"
  DESCRIPTION: "a is an input, b is an output"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { b; }
  GUARANTEES { G(a <-> X b) }
}
EOF
cat >c.tlsf <<EOF
INFO {
  TITLE:       "C"
  DESCRIPTION: "b is an input, a is an output"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { b; }
  OUTPUTS { a; }
  GUARANTEES { F(b); G(a) }
}
EOF

# Run the checks with both TLSF backends.
backends=spot
if syfco --version >/dev/null 2>&1; then
  backends="spot syfco"
fi

for backend in $backends; do
  export SPOT_TLSF_PARSER=$backend

  # The formula that the specification is converted to, and the same
  # formula with its propositions renamed after the partition.
  ltlfilt --tlsf up.tlsf -p >conv.ltl
  ltlfilt --tlsf up.tlsf --relabel=io -p >conv-io.ltl
  # The syfco backend lower-cases the propositions, the built-in
  # parser preserves them; the renamed formula is the same either way.
  case $backend in
  spot) grep 'AIn' conv.ltl ;;
  syfco) grep 'ain' conv.ltl ;;
  esac
  grep 'i0' conv-io.ltl

  # Without the two-argument form of -A, all propositions are drawn from
  # a single pool, so the partition of the specification is not needed
  # and is not used.
  ltlmix -A 3 --tlsf up.tlsf -n1 -o out.ltl
  grep 'p[0-9]' out.ltl

  # With -A N,M, the propositions of the specification are renamed
  # after its partition, which makes the result indistinguishable from
  # mixing the already relabeled formula.
  ltlmix -A 1,1 --tlsf up.tlsf -n1 -o out.ltl
  ltlmix -A 3,3 --tlsf up.tlsf -n1 --seed 1 -o out.ltl
  ! grep 'p[0-9]' out.ltl
  grep 'i[0-9]' out.ltl
  grep 'o[0-9]' out.ltl
  ltlmix -A 3,3 -f "`cat conv-io.ltl`" -n1 --seed 1 -o ref.ltl
  diff out.ltl ref.ltl

  # A partition passed on the command-line wins over the one of the
  # specification, which is then ignored.  Check this with the built-in
  # parser only: the syfco backend lower-cases the propositions of the
  # formula it produces, so a partition mentioning 'AIn' would not
  # match 'ain'.
  if test $backend = spot; then
    ltlmix -A 1,1 --tlsf up.tlsf --ins AIn -n1 -o out.ltl
    ltlmix -A 1,1 --tlsf up.tlsf --outs BOut -n1 -o out.ltl
    ltlmix -A 1,1 --tlsf up.tlsf --part-file=up.part -n1 -o out.ltl
  fi

  # Two specifications whose partitions conflict: 'a' is an input in
  # the first one and an output in the second, and 'b' is an output in
  # the first one and an input in the second.  Each specification is
  # renamed after its own partition, so mixing them gives the same
  # result as mixing the two renamed formulas.  Had the partition of
  # the first specification still been in effect while the second one
  # was read, both propositions of the latter would have been taken
  # for inputs, giving (Fi0) & (Gi0) instead of (Fi0) & (Go0).
  ltlfilt --tlsf a.tlsf --relabel=io -p >a-io.ltl
  ltlfilt --tlsf c.tlsf --relabel=io -p >c-io.ltl
  grep 'G((i0) <-> (X(o0)))' a-io.ltl
  grep '(F(i0)) & (G(o0))' c-io.ltl
  # The two renamed formulas are distinct, so the command below really
  # mixes two different subformulas.
  diff a-io.ltl c-io.ltl && exit 1
  ltlmix -A 3,3 --tlsf a.tlsf --tlsf c.tlsf -n1 --seed 1 -o out.ltl
  ltlmix -A 3,3 -f "`cat a-io.ltl`" -f "`cat c-io.ltl`" -n1 --seed 1 \
         -o ref.ltl
  diff out.ltl ref.ltl
done
unset SPOT_TLSF_PARSER

# A partition is required as soon as -A N,M is used, since there is
# then no default convention to fall back on.
ltlmix -A 1,1 -f 'G(zz)' 2>err && exit 1
grep "does not start with 'i' or 'o'" err

:
