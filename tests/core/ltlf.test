. ./defs
set -e

# The existing test blocks below verify the original De Giacomo & Vardi
# translation.  Force algo=0 so they are unaffected by the new default.
export SPOT_FROM_LTLF=0

# ltlfilt --from-ltlf is also tested in ltlfilt.test
ltlfilt --from-ltlf=A -f 'a & Xa' -f 'a & X[!]a' \
        -f '(a U b) & (F(c) | F(d & X(0)))' >out
cat >expected<<EOF
A & a & X(!A | a) & (A U G!A)
A & a & X(A & a) & (A U G!A)
A & (a U (A & b)) & (F(A & c) | F(A & d & X!A)) & (A U G!A)
EOF
diff expected out

ltl2tgba -B -F out > out2
cat >expected2<<EOF
HOA: v1
name: "A & a & X(!A | a) & (A U G!A)"
States: 4
Start: 1
AP: 2 "A" "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
properties: very-weak
--BODY--
State: 0 {0}
[!0] 0
State: 1
[0&1] 2
State: 2
[!0] 0
[0&1] 3
State: 3
[!0] 0
[0] 3
--END--
HOA: v1
name: "a & X(A & a) & (A U G!A)"
States: 4
Start: 3
AP: 2 "A" "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
properties: very-weak
--BODY--
State: 0 {0}
[!0] 0
State: 1
[!0] 0
[0] 1
State: 2
[0&1] 1
State: 3
[0&1] 2
--END--
HOA: v1
name: "(a U (A & b)) & (A U G!A) & F((A & c) | (A & d & X!A))"
States: 5
Start: 0
AP: 5 "A" "b" "a" "c" "d"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc very-weak
--BODY--
State: 0
[0&!1&2&!3] 0
[0&1&3] 1
[0&1&!3] 2
[0&!1&2&3] 3
[0&1&!3&4] 4
State: 1
[0] 1
[!0] 4
State: 2
[0&3] 1
[0&!3] 2
[0&!3&4] 4
State: 3
[0&1] 1
[0&!1&2] 3
State: 4 {0}
[!0] 4
--END--
EOF
diff expected2 out2

autfilt --to-finite=A out2 >out3
cat >expected3 <<EOF
HOA: v1
States: 3
Start: 0
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0
[0] 1
State: 1 {0}
[0] 2
State: 2 {0}
[t] 2
--END--
HOA: v1
States: 3
Start: 2
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0 {0}
[t] 0
State: 1
[0] 0
State: 2
[0] 1
--END--
HOA: v1
States: 5
Start: 0
AP: 4 "b" "a" "c" "d"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc
--BODY--
State: 0
[!0&1&!2] 0
[0&2] 1
[0&!2] 2
[!0&1&2] 3
[0&!2&3] 4
State: 1 {0}
[t] 1
State: 2
[2] 1
[!2] 2
[!2&3] 4
State: 3
[0] 1
[!0&1] 3
State: 4 {0}
[f] 4
--END--
EOF
diff expected3 out3

autfilt out3 > out4
diff out3 out4

# ltl2tgba --ltlf should have a similar output
cat >expected3b <<EOF
HOA: v1
name: "a & Xa"
States: 3
Start: 0
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0
[0] 2
State: 1 {0}
[t] 1
State: 2 {0}
[0] 1
--END--
HOA: v1
name: "a & X[!]a"
States: 3
Start: 2
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0 {0}
[t] 0
State: 1
[0] 0
State: 2
[0] 1
--END--
HOA: v1
name: "(a U b) & (Fc | F(d & X(0)))"
States: 5
Start: 4
AP: 4 "b" "a" "c" "d"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0
[!2&!3] 0
[2] 2
[!2&3] 3
State: 1
[!0&1] 1
[0] 2
State: 2 {0}
[t] 2
State: 3 {0}
[!2&!3] 0
[2] 2
[!2&3] 3
State: 4
[0&!2&!3] 0
[!0&1&2] 1
[0&2] 2
[0&!2&3] 3
[!0&1&!2] 4
--END--
EOF
ltl2tgba --ltlf 'a & Xa' 'a & X[!]a' '(a U b) & (F(c) | F(d & X(0)))' >out4b
diff out4b expected3b

# Removing the [f] lines should not change anything for autfilt
grep -v '\[f\]' out4 > out3
cmp out3 out4 && exit 1 # make sure we did remove something
autfilt out3 > out4
diff out4 expected3

# Issue #526 and Issue #596
ltlfilt -f '(i->XXo)|G(i<->Xo2)' -f XXXo --from-ltlf | ltl2tgba -D |\
    autfilt -C --to-finite > out
cat >exp <<EOF
HOA: v1
States: 8
Start: 0
AP: 3 "o" "o2" "i"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0
[2] 6
[!2] 7
State: 1
[!1&!2] 1
[!1&2] 5
State: 2 {0}
[0] 7
State: 3 {0}
[!0&!1&!2] 1
[!0&!1&2] 5
[0] 7
State: 4 {0}
[!0&1&!2] 1
[!0&1&2] 5
[0] 7
State: 5 {0}
[1&!2] 1
[1&2] 5
State: 6 {0}
[!1] 2
[1&!2] 3
[1&2] 4
State: 7 {0}
[t] 7
--END--
HOA: v1
States: 5
Start: 0
AP: 1 "o"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels state-acc deterministic
--BODY--
State: 0
[t] 4
State: 1 {0}
[0] 3
State: 2 {0}
[t] 1
State: 3 {0}
[t] 3
State: 4 {0}
[t] 2
--END--
EOF
diff out exp

# ---------- Tests for the new syntactic-obligation translation (algo=1) ------
export SPOT_FROM_LTLF=1

# All nesting combinations of F, G, U, R, W, M — one formula per line so
# wc -l gives the exact count for the obligation check below.
cat > formulas_o.ltl << 'EOF'
G(a)
F(a)
a U b
a R b
a W b
a M b
G(F(a))
F(G(a))
G(a U b)
G(a R b)
G(a W b)
G(a M b)
F(a U b)
F(a R b)
F(a W b)
F(a M b)
F(a) U b
G(a) U b
F(a) R b
G(a) R b
F(a) W b
G(a) W b
F(a) M b
G(a) M b
a U F(b)
a U G(b)
a R F(b)
a R G(b)
a W F(b)
a W G(b)
a M F(b)
a M G(b)
(a U b) U c
(a U b) R c
(a U b) W c
(a U b) M c
(a R b) U c
(a R b) R c
(a R b) W c
(a R b) M c
(a W b) U c
(a W b) R c
(a W b) W c
(a W b) M c
(a M b) U c
(a M b) R c
(a M b) W c
(a M b) M c
a U (b U c)
a U (b R c)
a U (b W c)
a U (b M c)
a R (b U c)
a R (b R c)
a R (b W c)
a R (b M c)
a W (b U c)
a W (b R c)
a W (b W c)
a W (b M c)
a M (b U c)
a M (b R c)
a M (b W c)
a M (b M c)
G(F(G(a)))
F(G(F(a)))
G(F(G(F(a))))
G(a U G(b))
F(a R F(b))
G(a W G(b))
F(a M F(b))
(G(a) U b) W c
a M (G(b) R c)
G(a) & F(b)
F(a) | G(b)
(a U b) & G(c)
(a R b) | F(c)
G(a & F(b))
F(a | G(b))
EOF

# Verify that every from_ltlf(algo=1) result is a syntactic obligation.
total=$(wc -l < formulas_o.ltl)
ltlfilt --from-ltlf -F formulas_o.ltl |
    ltlfilt --syntactic-obligation -c > oblig_count
count=$(cat oblig_count)
test "$total" = "$count" || {
  echo "Not all from_ltlf(algo=1) results are obligations."
  echo "Expected $total, got $count"
  ltlfilt --from-ltlf -F formulas_o.ltl >&2
  exit 1
}

# Semantic equivalence: algo=0 and algo=1 produce language-equivalent formulae.
# Each tool translates the LTLf formula to an LTL automaton; ltlcross
# cross-checks that both automata accept the same language.
# --no-complement is required because the LTLf-to-LTL encoding is NOT a
# proper LTL encoding: words like cycle{!alive} (which start already dead)
# are rejected by *both* the positive and the negative translations,
# violating ltlcross's normal assumption that they are complementary.
# With --no-complement, ltlcross only checks P0≡P1 and N0≡N1, skipping the
# Comp(Pi)∩Comp(Ni)=∅ sanity check that does not apply here.
ltlcross --no-complement \
  'SPOT_FROM_LTLF=0 ltlfilt --from-ltlf -f %f | ltl2tgba >%O' \
  'SPOT_FROM_LTLF=1 ltlfilt --from-ltlf -f %f | ltl2tgba >%O' \
  -F formulas_o.ltl

# Random formulas: use randltl to cover additional operator combinations.
randltl --seed=42 --tree-size=5..10 -n 100 a b c | \
  ltlcross --no-complement \
    'SPOT_FROM_LTLF=0 ltlfilt --from-ltlf -f %f | ltl2tgba >%O' \
    'SPOT_FROM_LTLF=1 ltlfilt --from-ltlf -f %f | ltl2tgba >%O'
