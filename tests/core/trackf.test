. ./defs

set -e

ltl2tgba -D 'Ga | Gb | Gc' |
  autfilt --track-formula='Ga | Gb | Gc' > out
cat >exp <<EOF
HOA: v1
name: "Ga | Gb | Gc"
States: 7
Start: 0
AP: 3 "a" "b" "c"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
properties: stutter-invariant weak
--BODY--
State: 0 "Ga | Gb | Gc"
[!0&!1&2] 1
[!0&1&!2] 2
[!0&1&2] 3
[0&!1&!2] 4
[0&!1&2] 5
[0&1&!2] 6
[0&1&2] 0
State: 1 "Gc"
[2] 1
State: 2 "Gb"
[1] 2
State: 3 "Gb | Gc"
[!1&2] 1
[1&!2] 2
[1&2] 3
State: 4 "Ga"
[0] 4
State: 5 "Ga | Gc"
[!0&2] 1
[0&!2] 4
[0&2] 5
State: 6 "Ga | Gb"
[!0&1] 2
[0&!1] 4
[0&1] 6
--END--
EOF
diff out exp
