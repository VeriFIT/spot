. ./defs || exit 1

set -e

# LTL synthesis with universal quantification

for algo in ds sd; do

ltlsynt --algo=$algo -f 'G(u <-> X!u) & XF(u <-> o)' && exit 0
ltlsynt --algo=$algo --real -f 'G(u <-> X!u) -> XF(u <-> o)'

cat >exp <<EOF
REALIZABLE
HOA: v1
States: 2
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic weak
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[0] 1
--END--
/*Strategy was verified*/
EOF

ltlsynt --algo=$algo --verify -f 'G(u <-> X!u) -> XF(u <-> o)' >out
diff out exp

ltlsynt --algo=$algo --verify \
        -f 'G(u <-> X!u) -> X(F(u <-> o) && F(u <-> !o))' >out
diff out exp


cat >exp <<EOF
REALIZABLE
HOA: v1
States: 2
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[!0] 1
--END--
/*Strategy was verified*/
EOF

ltlsynt --algo=$algo --verify --obligation-synthesis=no \
        -f 'G(u <-> X!u) -> XF(u <-> o)' >out
diff out exp
ltlsynt --algo=$algo --verify --obligation-synthesis=no \
        -f 'G(u <-> X!u) -> X(F(u <-> o) && F(u <-> !o))' >out
diff out exp



cat >exp <<EOF
REALIZABLE
HOA: v1
States: 4
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic weak
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[0] 2
State: 2
[!0] 3
State: 3
[0] 1
--END--
/*Strategy was verified*/
EOF

ltlsynt --algo=$algo --verify \
        -f 'G(u<->X!u)->XF((u->(o&X!o))&(!u->(!o&Xo)))' >out
diff out exp

cat >exp <<EOF
REALIZABLE
HOA: v1
States: 4
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[!0] 2
State: 2
[0] 3
State: 3
[0] 1
--END--
/*Strategy was verified*/
EOF

ltlsynt --algo=$algo --verify --obligation-synthesis=no \
        -f 'G(u<->X!u)->XF((u->(o&X!o))&(!u->(!o&Xo)))' >out
diff out exp

done

:
