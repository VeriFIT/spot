. ./defs
set -e

cat >in <<EOF
a
Ga
a U b
GFa
a R (b W c)
(a U b) & (c R (d W e))
EOF

ltlf2dfa --keep-names -F in >out.hoa
cat <<EOF >exp.hoa
HOA: v1
name: "a"
States: 2
Start: 0
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc colored
properties: deterministic
--BODY--
State: 0 "a"
[0] 1 {0}
State: 1 "1"
[t] 1 {0}
--END--
HOA: v1
name: "Ga"
States: 1
Start: 0
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc colored
properties: deterministic
--BODY--
State: 0 "Ga"
[0] 0 {0}
--END--
HOA: v1
name: "a U b"
States: 2
Start: 0
AP: 2 "a" "b"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc deterministic
--BODY--
State: 0 "a U b"
[0&!1] 0
[1] 1 {0}
State: 1 "1"
[t] 1 {0}
--END--
HOA: v1
name: "GFa"
States: 1
Start: 0
AP: 1 "a"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc complete
properties: deterministic
--BODY--
State: 0 "GFa"
[!0] 0
[0] 0 {0}
--END--
HOA: v1
name: "a R (b W c)"
States: 3
Start: 0
AP: 3 "a" "b" "c"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc colored
properties: deterministic
--BODY--
State: 0 "a R (b W c)"
[!0&1 | !0&2] 0 {0}
[0&1&!2] 1 {0}
[0&2] 2 {0}
State: 1 "b W c"
[1&!2] 1 {0}
[2] 2 {0}
State: 2 "1"
[t] 2 {0}
--END--
HOA: v1
name: "(a U b) & (c R (d W e))"
States: 6
Start: 0
AP: 5 "a" "b" "c" "d" "e"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc deterministic
--BODY--
State: 0 "(a U b) & (c R (d W e))"
[0&!1&!2&3 | 0&!1&!2&4] 0
[1&!2&3 | 1&!2&4] 1 {0}
[1&2&3&!4] 2 {0}
[0&!1&2&4] 3
[0&!1&2&3&!4] 4
[1&2&4] 5 {0}
State: 1 "c R (d W e)"
[!2&3 | !2&4] 1 {0}
[2&3&!4] 2 {0}
[2&4] 5 {0}
State: 2 "d W e"
[3&!4] 2 {0}
[4] 5 {0}
State: 3 "a U b"
[0&!1] 3
[1] 5 {0}
State: 4 "(a U b) & (d W e)"
[1&3&!4] 2 {0}
[0&!1&4] 3
[0&!1&3&!4] 4
[1&4] 5 {0}
State: 5 "1"
[t] 5 {0}
--END--
EOF
diff out.hoa exp.hoa

# The next translation should not preserve names.
sed '/State:/s/ ".*$//' exp.hoa > exp2.hoa
ltlf2dfa --composition=size >out.hoa <in
diff out.hoa exp2.hoa


ltlf2dfa -f '\forall a: (a U b) | (b U !a)' --keep-names > out.hoa
cat >exp.hoa <<\EOF
HOA: v1
name: "\\forall a: ((a U b) | (b U !a))"
States: 3
Start: 0
AP: 1 "b"
acc-name: Buchi
Acceptance: 1 Inf(0)
properties: trans-labels explicit-labels trans-acc deterministic
--BODY--
State: 0 "\forall a: ((a U b) | (b U !a))"
[!0] 1
[0] 2 {0}
State: 1 "b"
[0] 2 {0}
State: 2 "1"
[t] 2 {0}
--END--
EOF
diff out.hoa exp.hoa

ltlf2dfa -f '\forall a: (a U b) | (b U !a)' --trans=compo 2>err && exit 2
grep 'does not support' err

# We also use different minimization/simplify/translation algorithms,
# but because the formulas are very simple, the result is expected to
# be identical.
ltlf2dfa - --minimize=true --translation=direct --simplify=yes >out2.hoa <in
diff out2.hoa exp2.hoa
ltlf2dfa -F- --minimize=no --translation=direct --simplify=false >out2.hoa <in
diff out2.hoa exp2.hoa

ltlf2dfa GFa -q >out
test "" = "`cat out`"

# PSL is currently not supported
ltlf2dfa '{(1;1)[*]}!' 2>err && exit 1
grep 'not an LTLf formula' err

ltlf2dfa -f 'Ga' --mtdfa-stats=paths | sed '/edges:/q' >out
ltlf2dfa -f 'Fa' --mtdfa-stats=paths | sed '/edges:/q' >>out
cat >expected <<\EOF
states: 1
aps: 1
internal nodes: 1
terminal nodes: 1
constant nodes: 1 (true)
total nodes: 3 (0KB)
paths: 1
edges: 1
states: 1
aps: 1
internal nodes: 1
terminal nodes: 1
constant nodes: 1 (false)
total nodes: 3 (0KB)
paths: 2
edges: 2
EOF
diff out expected
