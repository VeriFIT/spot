# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
# or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
# License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

. ./defs || exit 1

set -e

# LTLf synthesis with universal quantification

ltlfsynt --real -f 'G((!u | X!u) & (u | Xu)) -> X[!]F(u <-> o)'

ltlfsynt -f 'G((!u | X!u) & (u | Xu)) -> X[!]F(u <-> o)' >out
cat >exp <<EOF
REALIZABLE
HOA: v1
States: 3
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[0] 2
State: 2
[0] 2
--END--
EOF
diff out exp

ltlfsynt -f 'G((!u | X!u) & (u | Xu)) -> X[!](F(u <-> o) && F(u <-> !o))' >out
diff out exp

ltlfsynt -f 'G((!u|X!u)&(u|Xu))->X[!]F((u->(o&X[!]!o))&(!u->(!o&X[!]o)))' >out
cat >exp <<EOF
REALIZABLE
HOA: v1
States: 6
Start: 0
AP: 1 "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 0
--BODY--
State: 0
[t] 1
State: 1
[0] 2
State: 2
[!0] 3
State: 3
[0] 4
State: 4
[0] 5
State: 5
[!0] 5
--END--
EOF
diff out exp

ltlfsynt -f 'G((!u | X!u) & (u | Xu)) & X[!]F(u <-> o)' && exit 0


# derived from
# https://github.com/whitemech/ltlf-synth-unrel-input-aaai2025/
# blob/main/tests/hiker-3-solv/
tr -d '\n' >formula <<EOF
(!(!a1 & !a3 & !a4 & G(X[!]a4 <-> (X[!]1 & ((a4 & !(a3 & o2)) | (a0 &
z0 & X[!]o1)))) & XXXa1 & XXXX(a1 & Ga1) & G(!a0 | !a1) & X!a1 & XX!a1
& G(a0 | !z0) & G(!a0 | !a2) & G(X[!]a3 <-> (X[!]1 & ((a3 & !o2) | (a2
& X[!]o0)))) & XXa2) | (G(!(a0 & !z0) | Xo1) & Fa1)) & (!(!a1 & !a3 &
!a4 & G(X[!]a4 <-> (X[!]1 & ((a4 & !(a3 & o2)) | (a0 & z0 & X[!]o1))))
& XXXa1 & XXXX(a1 & Ga1) & G(!a0 | !a1) & X!a1 & XX!a1 & G(a0 | !z0) &
G(!a0 | !a2) & G(X[!]a3 <-> (X[!]1 & ((a3 & !o2) | (a2 & X[!]o0)))) &
XXa2) | F(a1 & !a4))
EOF
cat >part <<EOF
.inputs a0 a1 /a[2-4]/
.outputs o0 o1 o2
.unobservables z0
EOF
ltlfsynt --semantics=moore -Fformula --real --part=part

# same source
# blob/main/tests/hiker-4-unsolv/
tr -d '\n' >formula <<EOF
(!(!i1 & !i3 & !i4 & G(X[!]i4 <-> (X[!]1 & ((i4 & !(i3 & o2)) | (i0 &
u0 & X[!]o1)))) & XXXXi1 & XXXXX(i1 & Gi1) & G(!i0 | !i1) & X!i1 &
XX!i1 & XXX!i1 & G(i0 | !u0) & G(!i0 | !i2) & G(X[!]i3 <-> (X[!]1 &
((i3 & !o2) | (i2 & X[!]o0))))) | (G(!(i0 & !u0) | Xo1) & Fi1)) &
(!(!i1 & !i3 & !i4 & G(X[!]i4 <-> (X[!]1 & ((i4 & !(i3 & o2)) | (i0 &
u0 & X[!]o1)))) & XXXXi1 & XXXXX(i1 & Gi1) & G(!i0 | !i1) & X!i1 &
XX!i1 & XXX!i1 & G(i0 | !u0) & G(!i0 | !i2) & G(X[!]i3 <-> (X[!]1 &
((i3 & !o2) | (i2 & X[!]o0))))) | F(i1 & !i4))
EOF

ltlfsynt --semantics=moore -Fformula && exit 1


f='((u<->(i2 xor i3))&(Fi)&G(X[!]1->((Xu)<->(u xor i))))->(G((o<->u)&Fo))'
ltlfsynt -f "$f" > out
cat >expect <<EOF
REALIZABLE
HOA: v1
States: 2
Start: 0
AP: 4 "i2" "i3" "i" "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 3
--BODY--
State: 0
[!0&1&3 | 0&!1&3 | !2] 0
[!0&!1&2&!3 | 0&1&2&!3] 1
State: 1
[3] 1
--END--
EOF
diff out expect

ltlfsynt -f "$f" --non-terminating > out
cat >expect <<EOF
REALIZABLE
HOA: v1
States: 2
Start: 0
AP: 4 "i2" "i3" "i" "o"
acc-name: all
Acceptance: 0 t
properties: trans-labels explicit-labels state-acc deterministic
controllable-AP: 3
--BODY--
State: 0
[!0&1&3 | 0&!1&3] 0
[!0&!1&!3 | 0&1&!3] 1
State: 1
[3] 1
--END--
EOF
diff out expect


# example formula from Shufang that caused a crash because
# of a bug in the an early implementation of bdd_mt_quantify
run 1 ltlfsynt -f '(u & !o & XG(u|o)) | (!u & !o & X[!]F!o)'

# Issue #637
run 1 ltlfsynt -f '!(F(!i -> u) <-> (Fo R Gu))' --ins=i --unob=u

# Issue #639
run 1 ltlfsynt -f 'X(Xi xor Gi) <-> (Gi U (o & Fu))' \
               -f 'Gi R !X!((i -> o) xor (o <-> XXu))'

# --verbose: verify output goes to stderr
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --verbose >out 2>verbose.out
grep 'using Mealy semantics' verbose.out
grep 'translation to MTDFA' verbose.out
grep 'Mealy machine' verbose.out

# --semantics=Moore with --verbose
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --semantics=Moore --verbose \
  >out 2>verbose-moore.out
grep 'using Moore semantics' verbose-moore.out

# --backprop=trival-states with --realizability
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --trans=full \
  --backprop=trival-states --real >out 2>verbose-bp.out
grep 'REALIZABLE' out

# --dot=game output
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --dot=game >out.dot
grep 'digraph' out.dot

# --translation=full with --unobservables should error
# (the unobs AP must appear in the formula for the error to trigger)
ltlfsynt -f 'G(u & i -> X o)' --outs=o --ins=i --unobs=u \
  --trans=full 2>err && exit 1
grep 'does not support.*unobserv' err

# --translation=compositional with --unobservables should error
ltlfsynt -f 'G(u & i -> X o)' --outs=o --ins=i --unobs=u \
  --trans=compositional 2>err && exit 1
grep 'does not support.*unobserv' err

# --trans=restricted works with --unobs (only full/compositional check)
ltlfsynt -f 'G(u & i -> X o)' --outs=o --ins=i --unobs=u --trans=restricted >out
grep 'REALIZABLE' out

# --translation=direct with --one-step=no
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --trans=direct --one-step=no >out
grep 'REALIZABLE' out

# --translation=direct --minimize=yes (covers minimize path for restricted)
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --trans=direct --minimize=yes >out
grep 'REALIZABLE' out

# --simplify-formula=no (covers the opt_simplify_ltl == false path)
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --trans=direct \
  --simplify-formula=no >out
grep 'REALIZABLE' out

# --aiger output
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --aiger >out.aig
grep 'aag' out.aig

# -q (quiet) mode: no output, just exit status
ltlfsynt -q -f 'G(i -> o)' --outs=o --ins=i >out
test -z "$(cat out)"

# --hide-status
ltlfsynt -f 'G(i -> o)' --outs=o --ins=i --hide-status >out
test -z "$(cat out)" || grep 'HOA' out

# --verbose with --trans=direct-full --real (covers full translation verbose)
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --trans=full \
  --verbose --real >out 2>verbose-full.out
grep 'starting full translation' verbose-full.out

# --verbose with --trans=compositional and --composition=ap
ltlfsynt -f 'G(i <-> o) & G(j <-> k)' --outs=o,k --ins=i,j \
  --trans=compositional --composition=ap --verbose --real \
  >out 2>verbose-comp.out
grep 'AP-based ordering' verbose-comp.out

# --verbose with --trans=restricted and --minimize=yes --real
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --trans=restricted \
  --minimize=yes --verbose --real >out 2>verbose-min.out
grep 'minimization of MTDFA' verbose-min.out

# --decompose=yes --verbose with a formula having multiple output groups
ltlfsynt -f '(G(i1 <-> o1)) & (G(i2 <-> o2))' \
  --outs=o1,o2 --ins=i1,i2 --decompose=yes --verbose --real \
  >out 2>verbose-decomp.out
grep -E 'subformulas|decomposition' verbose-decomp.out

# --verbose with --aiger
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --aiger --verbose \
  >out.aig 2>verbose-aig.out
grep 'AIG circuit' verbose-aig.out

# --polarity=before-decompose --verbose
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i \
  --polarity=before-decompose --verbose --real \
  >out 2>verbose-pol.out
grep 'using Mealy' verbose-pol.out

# --global-equivalence=before-decompose --verbose
ltlfsynt -f 'G(i <-> o) & G(j <-> k)' --outs=o,k --ins=i,j \
  --global-equivalence=before-decompose --verbose --real \
  >out 2>verbose-geq.out
grep 'using Mealy' verbose-geq.out

# --terminating semantics in AIGER output
# Default: __SigAlive__ should appear in output names
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --aiger --hide-status >out_term.aig
grep '__SigAlive__' out_term.aig

# With --terminating=MySig, MySig should appear
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --aiger --terminating=MySig \
  --hide-status >out_mysig.aig
grep 'MySig' out_mysig.aig

# With --non-terminating, __SigAlive__ should NOT appear
ltlfsynt -f 'G(i <-> o)' --outs=o --ins=i --aiger --non-terminating \
  --hide-status >out_nonterm.aig
! grep -q '__SigAlive__' out_nonterm.aig

# Terminating semantics adds 1 extra latch and 1 extra output.
# Extract L and O fields from the aag header: aag M I L O A
head -1 out_nonterm.aig > header_nonterm
head -1 out_term.aig > header_term
L_nonterm=$(awk '{print $4}' header_nonterm)
O_nonterm=$(awk '{print $5}' header_nonterm)
L_term=$(awk '{print $4}' header_term)
O_term=$(awk '{print $5}' header_term)
test $((L_term)) -eq $((L_nonterm + 1))
test $((O_term)) -eq $((O_nonterm + 1))

# --verify --terminating with HOA output (Mealy strategy)
for f in \
  'G((!u | X!u) & (u | Xu)) -> X[!]F(u <-> o)' \
  '(u & !o & XG(u|o)) | (!u & !o & X[!]F!o)' \
; do
  for tra in restr dfs bfs; do
    rc=0
    ltlfsynt -f "$f" --trans=$tra --verify --terminating -H > out 2>err || rc=$?
    test $rc -le 1 || exit 2
  done
done

# --verify --terminating with Moore semantics
for f in \
  'G((!u | X!u) & (u | Xu)) -> X[!]F(u <-> o)' \
; do
  for tra in restr dfs bfs; do
    rc=0
    ltlfsynt -f "$f" --trans=$tra --semantics=Moore \
             --verify --terminating -H > out 2>err || rc=$?
    test $rc -le 1 || exit 2
  done
done

# --verify --terminating with AIG output
for f in \
  'G((!u | X!u) & (u | Xu)) -> X[!]F(u <-> o)' \
; do
  for tra in dfs bfs; do
    rc=0
    ltlfsynt -f "$f" --outs=o --ins=u,i2,i3,i --trans=$tra \
             --verify --terminating --aiger > out 2>err || rc=$?
    test $rc -le 1 || exit 2
  done
done

:
