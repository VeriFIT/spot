# along with this program.  If not, see <http://www.gnu.org/licenses/>.

. ./defs
set -e

# Basic pass-through: autdo with autfilt should reproduce the input.
ltl2tgba 'Ga' 'Fb' 'a U b' | tee expected | autdo autfilt >output
diff output expected

# Multiple tools: check all outputs are produced (no --smallest/--greatest).
ltl2tgba 'Ga' | autdo 'autfilt' 'autfilt --tgba' >output
test 2 = `grep -c '^HOA:' output`

# --smallest: select the automaton with fewer states.
ltl2tgba -D 'a U b' |
  autdo --smallest 'autfilt' 'autfilt --tgba' >output
test 1 = `grep -c '^HOA:' output`

# --greatest: select the automaton with more states.
ltl2tgba -D 'GFa & GFb' |
  autdo --greatest 'autfilt' 'autfilt -B' >output
test 1 = `grep -c '^HOA:' output`

# --smallest with custom format string
ltl2tgba 'Ga' | autdo --smallest='%e' 'autfilt' 'autfilt --tgba' >output
test 1 = `grep -c '^HOA:' output`

# --errors=ignore: non-zero exit from tool does not abort
ltl2tgba 'Ga' |
  autdo --errors=ignore 'false %H>%O' >output 2>/dev/null
test -z "$(cat output)"

# --errors=warn: non-zero exit warns but does not abort
ltl2tgba 'Ga' |
  autdo --errors=warn 'false %H>%O' >output 2>warn.err
test -z "$(cat output)"
grep -E 'exit code|failed to run' warn.err

# Register many tools to trigger tool_spec copy on vector reallocation
ltl2tgba 'Ga' | autdo --errors=ignore \
  'autfilt %H>%O' 'autfilt --tgba %H>%O' \
  'autfilt -B %H>%O' 'autfilt -C %H>%O' \
  'autfilt --small %H>%O' 'autfilt --high %H>%O' \
  'autfilt -S %H>%O' 'autfilt -D %H>%O' >output 2>/dev/null
test 8 = `grep -c '^HOA:' output`

# --max-count: limit output to N automata.
ltl2tgba 'Ga' 'Fb' 'a U b' |
  autdo -n 2 'autfilt %H>%O' >output
test 2 = `grep -c '^HOA:' output`

# Test timeout handling: should produce no automata (tools time out), no error.
ltl2tgba 'Ga' |
  autdo -T 1 'sleep 10; autfilt %H>%O' >output 2>stderr
test -z "$(cat output)"
grep -q 'timeout' stderr

# Test --fail-on-timeout: timed-out tool is an error, but --errors=warn
# prevents hard abort.
ltl2tgba 'Ga' |
  autdo -T 1 'sleep 10; autfilt %H>%O' \
    --fail-on-timeout --errors=warn >output 2>stderr
test -z "$(cat output)"
grep -q 'timeout' stderr

# Test --errors=ignore: non-zero exit does not abort.
ltl2tgba 'Ga' |
  autdo --errors=ignore \
    'autfilt --unknown-option %H>%O' >output 2>/dev/null
test -z "$(cat output)"

# Test stdin as input (- means stdin).
ltl2tgba 'Ga' |
  autdo - 'autfilt %H>%O' >output
test 1 = `grep -c '^HOA:' output`

# Test %M (automaton name) and %# (serial number) in output stats.
ltl2tgba 'Ga' 'Fb' |
  autdo --stats '%#: %M' 'autfilt %H>%O' >output
cat >expected <<EOF
1: Ga
2: Fb
EOF
diff output expected

# Test -F option: read automata from a file.
ltl2tgba 'Ga' >aut.in
run 0 autdo -F aut.in 'autfilt %H>%O' >output
test 1 = `grep -c '^HOA:' output`

# Test -F with a pipe (read from stdin using -).
ltl2tgba 'Fb' | autdo -F - 'autfilt %H>%O' >output
test 1 = `grep -c '^HOA:' output`

# Test -F with --stats: serial number should be correct.
ltl2tgba 'Ga' 'Fb' >aut.in
autdo -F aut.in --stats '%F,%#: %M' 'autfilt %H>%O' >output
cat >expected <<EOF
aut.in,1: Ga
aut.in,2: Fb
EOF
diff output expected

# Test -F with CSV column extraction (FILENAME/N reads column N from CSV).
# The "%h" format specifier contains quotes, so it must be quoted in the
# CSV output to produce a proper RFC 4180 CSV file.
ltl2tgba --stats='%f,"%h",%d' FGa 'a U b' >csv.csv
autdo -F csv.csv/2 'autfilt %H>%O' >output
test 2 = `grep -c '^HOA:' output`

# Test -F with CSV column extraction and --stats: verify %< captures
# the prefix (the part of the CSV line before the extracted column).
ltl2tgba --stats='%f,"%h",%d' FGa 'a U b' >csv.csv
autdo -F csv.csv/2 --stats '%<|%#' 'autfilt %H>%O' >output
cat >expected <<EOF
FGa|1
a U b|2
EOF
diff output expected

# --list-shorthands for automata tools
autdo --list-shorthands >out
grep 'autfilt' out
grep 'dstar2tgba' out

# Test upper-case (input) vs lower-case (output) escape sequences:
# %S,%T = input automaton stats; %s,%t = output automaton stats; %K = tool name.
ltl2tgba 'GFa & GFb' |
  autdo 'autfilt -B' --stats="%S,%T --[%K]-> %s,%t" >output
cat >expected <<EOF
1,4 --[autfilt -B]-> 3,12
EOF
diff output expected

# Also verify that %E/%e (edges) and %a/%a (acc sets) work for input/output.
ltl2tgba 'GFa & GFb' |
  autdo 'autfilt -B' --stats="%E edges,%a acc --[%K]-> %e edges,%a acc" >output
cat >expected <<EOF
4 edges,1 acc --[autfilt -B]-> 8 edges,1 acc
EOF
diff output expected

# --errors=abort with failing tool (default behavior - non-zero exit)
ltl2tgba 'Ga' | autdo 'false %H>%O' 2>err && exit 1
grep -E 'exit code|failed to run' err

# --greatest with custom format (%e instead of default %s,%e)
ltl2tgba -D 'GFa & GFb' |
  autdo --greatest='%e' 'autfilt' 'autfilt -B' >output
test 1 = `grep -c '^HOA:' output`

# --fail-on-timeout with --errors=abort (default, should hard-fail)
ltl2tgba 'Ga' |
  autdo -T 1 'sleep 10; autfilt %H>%O' --fail-on-timeout >output 2>err && exit 1
grep 'timeout' err

# Unparseable automaton from tool: --errors=abort (default) should fail
ltl2tgba 'Ga' | autdo 'echo "garbage" %H>%O' 2>err && exit 1
cat err
grep 'failed to parse' err

# Unparseable automaton: --errors=warn should warn but continue
ltl2tgba 'Ga' |
  autdo --errors=warn 'echo "garbage" %H>%O' >output 2>err
test -z "$(cat output)"
grep 'failed to parse' err

# Unparseable automaton: --errors=ignore should silently skip
ltl2tgba 'Ga' |
    autdo --errors=ignore 'echo "garbage" %H>%O' >output 2>/dev/null
test -z "$(cat output)"

# Truncated HOA (--ABORT--): --errors=abort (default) should fail
ltl2tgba 'Ga' | autdo 'echo "HOA: v1 --ABORT--" %H>%O' 2>err && exit 1
grep 'aborted its output' err

# Truncated HOA (--ABORT--): --errors=warn should warn but continue
ltl2tgba 'Ga' |
  autdo --errors=warn 'echo "HOA: v1 --ABORT--" %H>%O' >output 2>err
test -z "$(cat output)"
grep 'aborted its output' err

# Truncated HOA (--ABORT--): --errors=ignore should silently skip
ltl2tgba 'Ga' | autdo --errors=ignore \
                      'echo "HOA: v1 --ABORT--" %H>%O' >output 2>err
test -z "$(cat output)"
test -z "$(cat err)"

# The following message appears only if run from a tty.
if (: > /dev/tty) >/dev/null 2>&1 ; then
    autdo </dev/tty 2>stderr && exit 1
    grep 'No automaton to process' stderr
fi

autdo - 2>stderr && exit 1
grep 'No tool to run' stderr

:
