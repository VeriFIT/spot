conversion of folded.tlsf failed
aritynest.tlsf:16.15-26: definition 'unit' expects 1 argument(s); call
ed with 2
conversion of aritynest.tlsf failed
3 of 3 files failed
EOF
fold -w 70 defn.err | sed 's/ *$//' > defn.err.fold
diff -u defn.err.exp defn.err.fold

# A zero-argument definition used as a bus size evaluates in integer
# position: ALL of MIN/MAX/SUM/PROD, the logical-not of a literal, a
# membership, and the comparison operators are usable as sizes.
cat >intok.tlsf <<'EOF'
INFO {
  TITLE: "integer positions"
  DESCRIPTION: "builtins via zero-arg defs as bus sizes"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    siz3() = MIN(3, 5);
    siz5() = MAX(3, 5);
    tot6() = SUM(1, 2, 3);
    prd24() = PROD(2, 3, 4);
    one() = !0;
    in3() = 2 IN {0, 1, 2};
    lt1() = 2 < 3;
    le1() = 2 <= 2;
  }
}
MAIN {
  INPUTS { sc; }
  OUTPUTS {
    o1[siz3()];
    o2[siz5()];
    o3[tot6()];
    o4[prd24()];
    o5[one()];
    o6[in3()];
    o7[lt1()];
    o8[le1()];
  }
  GUARANTEE { G (sc -> o1[0]); }
}
EOF
../parsetlsf intok.tlsf > intok.f
cat >intok.f.exp <<'EOF'
G(sc -> o1_0)
EOF
diff -u intok.f.exp intok.f

# Invalid integer positions: SIZEOF of a literal/scalar/unknown/output
# AP, a set, a Boolean And, MIN() with no argument, and a bus index.
cat >interr.tlsf <<'EOF'
INFO {
  TITLE: "integer position errors"
  DESCRIPTION: "diagnosed at translate time"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    q1() = SIZEOF 3;
    q3() = SIZEOF scalar;
    q6() = SIZEOF nope;
    q7() = SIZEOF bout;
    q4() = {0, 1};
    q5() = 1 && 1;
    q8() = MIN();
    q9() = a0[0];
  }
}
MAIN {
  INPUTS {
    a0[2];
    scalar;
    r2[q1()];
    r3[q3()];
    r4[q6()];
    r5[q7()];
    r6[q4()];
    r7[q5()];
    r8[q8()];
    r9[q9()];
  }
  OUTPUTS { bout; }
  GUARANTEE { G a0[0]; }
}
EOF
# A definition that requires an argument, used bare in an integer
# position (bus index), is diagnosed.
cat >defbare.tlsf <<'EOF'
INFO {
  TITLE: "bare argumentful def"
  DESCRIPTION: "definition used without arguments"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    gen(x) = x >= 1 : a;
  }
}
MAIN {
  INPUTS { a[2]; }
  OUTPUTS { z; }
  GUARANTEE { G(a[gen]); }
}
EOF
# Cyclic parameters are diagnosed (once per actor in the cycle);
# forward-referenced parameters evaluate fine; an unresolvable
# parameter used in a bus size propagates a failure.
cat >cyclic.tlsf <<'EOF'
INFO {
  TITLE: "cyclic parameters"
  DESCRIPTION: "A = B + 1; B = A + 1"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    A = B + 1;
    B = A + 1;
  }
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF
( set +x
  run 2 ../parsetlsf interr.tlsf defbare.tlsf cyclic.tlsf \
    > /dev/null 2>intpos.err )
