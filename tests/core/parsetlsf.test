cat >clash2.tlsf <<'EOF'
// The diagnostic points at the declaration written first, whichever
// declaration space each of the two belongs to.
INFO {
  TITLE:       "clash2"
  DESCRIPTION: "a signal in both INPUTS and OUTPUTS"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { sig; }
  OUTPUTS { sig; }
  GUARANTEE { G(sig); }
}
EOF

cat >clash3.tlsf <<'EOF'
// An enumeration and a definition of the same name collide too, and
// the enumeration is reported as the later one only when it is
// written after the definition.
GLOBAL {
  DEFINITIONS {
    e = 2;
    enum e = E: 0*;
  }
}
MAIN {
  INPUTS  { q; }
  OUTPUTS { o; }
  GUARANTEE { G(q); }
}
EOF

cat >noinfo.tlsf <<'EOF'
// The four mandatory INFO items are required under --check-info, and
// each missing one is named once, at the INFO section.
INFO {
  TITLE: "no info"
}
GLOBAL {
  PARAMETERS { N = 2; }
}
MAIN {
  INPUTS  { a[N]; }
  OUTPUTS { b[N]; }
  GUARANTEE { &&[0 <= i < N] (a[i] -> b[i]); }
}
EOF

cat >noinfosection.tlsf <<'EOF'
// A file without an INFO section at all reports the four items at the
// start of the file.
GLOBAL {
}
MAIN {
}
EOF

cat >dupinfo.tlsf <<'EOF'
// A duplicated INFO item is a mistake whatever --check-info says.  The
// grammar already knows the item, so the second one is reported and
// dropped, and the first one keeps the value it set.
INFO {
  TITLE:       "first"
  TITLE:       "second"
  TAGS:        t1
  TAGS:        t2
  DESCRIPTION: "duplicate INFO items"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >tagsmany.tlsf <<'EOF'
// Several of them at once, and with the comments and newlines that a
// list may contain; the words around it stay words.
INFO {
  TITLE:       "many tags"
  DESCRIPTION: "every entry is an identifier"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  /* a comment */ TAGS: G, U, // another one
    AND, true, MAIN, TAGS /* and one more */
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >tagsnone.tlsf <<'EOF'
// The list may be empty -- syfco builds it with `commaSep`, which takes
// no element at all -- and an entry need not name anything the file
// declares.
INFO {
  TITLE:       "no tags"
  DESCRIPTION: "an empty list, then a name of nothing"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS:
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >tagsmid.tlsf <<'EOF'
// `TAGS:` is not the only thing a tag list may be followed by, and the
// item it is followed by is read as that item, not as a tag.
INFO {
  TAGS:        X
  TITLE:       "tags first"
  DESCRIPTION: "the list ends at the next item"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >tagscolon.tlsf <<'EOF'
// A colon that no item key explains is diagnosed where it is, and the
// state is left behind, so the rest of the INFO section is not
// mis-lexed.
INFO {
  TITLE:       "stray colon"
  DESCRIPTION: "a word that is not an item key"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS: FOO: "x"
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >mismatch.tlsf <<'EOF'
// SEMANTICS and TARGET must agree on the system model.  A file that
// contradicts itself is ambiguous, not unusable: the composition named
// by SEMANTICS is built, and the mismatch is a warning, so the
// translation still succeeds.
INFO {
  TITLE:       "mismatch"
  DESCRIPTION: "Moore semantics with a Mealy target"
  SEMANTICS:   Moore
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >mismatch2.tlsf <<'EOF'
// The strict and finite modifiers do not change the system model, so
// they are matched against the target the same way.
INFO {
  TITLE:       "mismatch2"
  DESCRIPTION: "Mealy,Finite semantics with a Moore target"
  SEMANTICS:   Mealy,Finite
  TARGET:      Moore
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >nosemantics.tlsf <<'EOF'
// A specification that spells out only one of the two cannot be
// compared, so the missing one is not an ambiguity (it is a missing
// mandatory item, which the tools below diagnose).
INFO {
  TITLE:       "nosemantics"
  DESCRIPTION: "a Mealy target with no SEMANTICS item"
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF

cat >ambiguous.tlsf <<'EOF'
// A warning is not an error: the tools that diagnose it keep going.
INFO {
  TITLE:       "ambiguous"
  DESCRIPTION: "Mealy,Finite semantics with a Moore target"
  SEMANTICS:   Mealy,Finite
  TARGET:      Moore
}
GLOBAL {
  PARAMETERS { N = 1; }
}
MAIN {
  INPUTS  { a[N]; }
  OUTPUTS { b[N]; }
  GUARANTEE { &&[0 <= i < N] (a[i] -> b[i]); }
}
EOF

cat >clidiag.tlsf <<'EOF'
// A diagnostic raised by the translation, as opposed to by the parser,
// is prefixed with the file name by the tools as well, not only by
// ../parsetlsf: a spot::location does not record a file name, so the
// printer supplies it, and bin/common_tlsf.cc does the same as
// ../parsetlsf does.  The spec must be Finite for ltlf2dfa, which is
// what gets it as far as the translation.
INFO {
  TITLE:       "translation diagnostic through a CLI"
  DESCRIPTION: "the name is printed by the tool, not stored"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    enum E = A: 00 B: 01;
  }
}
MAIN {
  INPUTS  { E b; }
  OUTPUTS { z; }
  GUARANTEE { G((b == NOPE) -> z); }
}
EOF

cat >subst_multi.tlsf <<'EOF'
// A formal used more than once in the body is replaced everywhere,
// and the actual tree is spliced in without being re-substituted.
GLOBAL {
  DEFINITIONS {
    both(x) = x && x;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { both(a); }
}
EOF

cat >subst_two.tlsf <<'EOF'
// Two formals in one definition: each occurrence maps to its own
// actual, and the order of the bindings does not matter.
GLOBAL {
  DEFINITIONS {
    pair(x, y) = x -> y;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { pair(a, b); }
}
EOF

cat >subst_nested.tlsf <<'EOF'
// A formal bound inside an actual must NOT be substituted again by
// the outer definition: the actual is spliced verbatim, so the inner
// parameter keeps its own name and is bound by the inner call.
GLOBAL {
  DEFINITIONS {
    inner(u) = u && u;
    outer(v) = inner(v);
  }
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { z; }
  GUARANTEE { outer(a); }
}
EOF

cat >subst_capture.tlsf <<'EOF'
// A quantifier inside the body binds its own loop variable: the loop
// variable is local to the body and must not be captured by the
// formal.  Here the body quantifies over `b`, which is also a formal
// name, so the two would be indistinguishable without the scope.
GLOBAL {
  DEFINITIONS {
    wrap(b) = FORALL[b IN {0, 1}] b;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { wrap(a); }
}
EOF

cat >subst_busref.tlsf <<'EOF'
// A BusRef base that names a formal is renamed when the actual is a
// plain identifier, and left alone otherwise (its index is resolved
// later, in integer position).
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    use(s) = s[0];
  }
}
MAIN {
  INPUTS  { a[n]; b[n]; }
  OUTPUTS { z; }
  GUARANTEE { use(a); }
}
EOF

cat >toomany.tlsf <<'EOF'
// A specification pathological enough to blow past spot's formula
// child limit must produce a diagnostic, not take the tool down: the
// fnode layer throws std::runtime_error once a formula reaches
// max_formula_children, and tlsf_to_ltl turns that into an error
// entry.  A binder over 70000 values folds into a single conjunction
// with one child per value, which is the cheapest way past the limit.
INFO {
  TITLE:       "too many children"
  DESCRIPTION: "child-limit stress via a binder fold"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { n = 70000; }
}
MAIN {
  INPUTS  { a[n]; }
  OUTPUTS { g; }
  GUARANTEE { &&[0 <= i < n] a[i]; }
}
EOF
# The specifications derived from the ones above, by a sed
# that only reads its source and so may run before anything
# consumes it, and by the helpers that write one.  They come
# first so that the merged invocations below find every file
# they name.
# --------------------------------------------------------------------------
sed 's/SEMANTICS:   Mealy,Strict/SEMANTICS:   Mealy/' strict.tlsf \
  > standard.tlsf

# Same specification with the `;` restored: the formula must not
# depend on the terminator.
sed 's/      INVALID: 1111/      INVALID: 1111;/' enumnosemi.tlsf \
  > enumsemi.tlsf

# The `;` is optional only for the LAST item of the block, so a `;`-less
# enum may not be followed by anything.  syfco rejects these too.
sed 's/      INVALID: 1111/      INVALID: 1111\n    m(x) = x;/' \
  enumnosemi.tlsf > enumnosemi2.tlsf

# A parameterless definition is rejected the same way.  It used to be
# reported as "unexpected character '2'" instead, because the `=`
# trailing context of the enumdecl identifier rule took `m =` for the
# enumeration's name and stranded the scanner inside the enum body,
# where `2` is not a pattern.  The name is now scanned in a state of
# its own, so the diagnostic points at the `m` that opens the item.
sed 's/      INVALID: 1111/      INVALID: 1111\n    m = 2;/' \
  enumnosemi.tlsf > enumnosemi3.tlsf

# With the `;` there is no problem, and in particular the `=` of a
# parameterless definition does not reopen the enum body.
sed 's/      INVALID: 1111/      INVALID: 1111;\n    m = 2;/' \
  enumnosemi.tlsf > enumsemi3.tlsf

# The same, with a parameterised definition, and it really is a
# definition: the guarantee below calls it, and the identity
# `m(x) = x` gives back the argument.
sed 's/      INVALID: 1111/      INVALID: 1111;\n    m(x) = x;/' \
  enumnosemi.tlsf > enumsemi2.tlsf

sed 's/G(grant <-> req)/m(req)/' enumsemi2.tlsf > enumsemi4.tlsf

# Restoring the separators makes the same specification valid.
sed -e 's/      INVALID: 1111/      INVALID: 1111;/' \
    -e 's/    enum Other = X: 00/    enum Other = X: 00;/' \
    -e 's/    enum Last = Y: 11/    enum Last = Y: 11;/' \
  enumnested.tlsf > enumnested.f

# A character that cannot occur in an enum body is diagnosed once,
# and the enumdecl state is left behind, so a stray character does
# not cascade over the rest of the file.
sed 's/      INVALID: 1111/      INVALID: 1111 ?/' enumnosemi.tlsf \
  > enumstray.tlsf

# `AND` in the same file is still the word, and not a tag: writing it
# symbolically has to give the same formula.
sed 's/b\[0\] AND c/b[0] \&\& c/' enumkwnear.tlsf > enumkwnearref.tlsf
sed -e 's/enum GLOBAL =/enum E =/' \
    -e 's/INPUTS  { GLOBAL b; }/INPUTS  { E b; }/' \
    enumkwsec.tlsf > enumkwsecref.tlsf

# ... and a comment may stand between a section keyword and its brace,
# which is the whole trigger: both spellings give the same formula.
sed -e 's/^GLOBAL {/GLOBAL \/* c *\/ {/' -e 's/^MAIN {/MAIN \/\/ c\n{/' \
  shadowsec.tlsf > shadowseccmt.tlsf
sed 's/f = c U = c;/f = c; U = c;/' shadowsemi.tlsf > shadowsemi2.tlsf

# A word that is declared but not a value of the enumeration is still
# a word: only a declared tag or name may be an identifier.
sed 's/b == U/b == Uu/' enumkw.tlsf > enumkwbad.tlsf
sed 's/  SEMANTICS:   MAIN/  SEMANTICS:   Main/' semvalbad.tlsf \
  > semvalbad2.tlsf
sed 's/enum C = { A: 00, B: 01 };/enum C = ;/' enumbad.tlsf \
  > enumbad2.tlsf
sed 's/enum C = { A: 00, B: 01 };/enum C = A: 0* B: 01;/' enumbad.tlsf \
  > enumbad3.tlsf
sed 's/enum C = { A: 00, B: 01 };/enum C = A: 0 B: 01;/' enumbad.tlsf \
  > enumbad4.tlsf

# A pattern is a single maximal run of `0`, `1` and `*` characters
# (TLSF v1.2 SS4.4), so two juxtaposed runs are a misparse: they must
# not be merged into one longer pattern (which would also redefine the
# enum's width), and the missing separator is reported once, where the
# second run starts.
sed 's/enum C = { A: 00, B: 01 };/enum C = A: 10 01 B: 11;/' enumbad.tlsf \
  > enumjoin.tlsf

# A comment does not separate two runs either.
sed 's/enum C = { A: 00, B: 01 };/enum C = A: 10 \/* c *\/ 01;/' enumbad.tlsf \
  > enumjoin2.tlsf
sed 's/enum C = { A: 00, B: 01 };/enum C = A: 10, 01 B: 11;/' enumbad.tlsf \
  > enumjoin3.tlsf

# Out-of-range index via a zero-arg-def size is a diagnostic.
sed 's/G(!grant\[3\]);/G(!grant[m]);/' typedbus.tlsf > typedbus5.tlsf

# Unknown enum type in a declaration, and un-indexed typed-bus use,
# are diagnosed.
sed 's/hburst HBURST;/noenum HBURST;/' typedbus.tlsf > typedbus3.tlsf

sed 's/G(req\[3\]);/G(HBURST);/' typedbus.tlsf > typedbus4.tlsf

# Unknown function in a size, and wrong arity, are diagnosed at the
# declaration even when the bus is never referenced.
sed 's/request\[nbits(n)\]/request[nope(n)]/' defsize.tlsf > defsize2.tlsf

sed 's/request\[nbits(n)\]/request[nbits(n, n)]/' defsize.tlsf > defsize3.tlsf

# The `;` is still required between two statements ...
sed 's/ASSUME { a -> HBURST\[0\] }/ASSUME { a b }/' \
  semifinal.tlsf > semifinal_bad.tlsf

# ... and between two bus declarations.
sed 's/INPUTS  { a; HBURST\[2\] }/INPUTS { a[2] b[2] }/' \
  semifinal.tlsf > semifinal_bad2.tlsf
check_temporal_fail()
{
  body="$1"
  name="$2"
  cat >"$name.tlsf" <<EOF
INFO {
  TITLE: "t"
  DESCRIPTION: "temporal bounds"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL { PARAMETERS { n = 3; } }
MAIN {
  INPUTS { a; }
  OUTPUTS { b; }
  GUARANTEE { $body; }
}
EOF
}

check_temporal_fail 'F[0:0-1] a' temporal1
check_temporal_fail 'F[0 1] a' temporal2
check_temporal_fail 'F[0:nope(1)] a' temporal3
check_strong_fail()
{
  body="$1"
  name="$2"
  semantics="${3:-Mealy,Finite}"
  cat >"$name.tlsf" <<EOF
INFO {
  TITLE: "t"
  DESCRIPTION: "strong temporal bounds"
  SEMANTICS: $semantics
  TARGET: Mealy
}
GLOBAL { PARAMETERS { n = 3; } }
MAIN {
  INPUTS { a; }
  OUTPUTS { b; }
  GUARANTEE { $body; }
}
EOF
}

check_strong_fail 'F[!1:3!] a' strong1
check_strong_fail 'G[!1:3!] a' strong2
check_strong_fail 'X[!2!] a' strong3
check_strong_fail 'F[!1:3' strong4
check_strong_fail 'X[!2' strong5
check_strong_fail 'F[1:3! ] a' strong6
check_strong_fail 'F[ !1:3] a' strong7
check_strong_fail 'F[!] a' strong8
check_strong_fail 'X[!] a' nonfinite1 Mealy
check_strong_fail 'X[!2] a' nonfinite2 Mealy
check_strong_fail 'X[2!] a' nonfinite3 Mealy
check_strong_fail 'F[!1:3] a' nonfinite4 Mealy
check_strong_fail 'F[1:3!] a' nonfinite5 Mealy
check_strong_fail 'G[!1:3] a' nonfinite6 Mealy
check_strong_fail 'G[1:2!] a' nonfinite7 Mealy

# Unknown enum type on an unreferenced bus is still a diagnostic.
sed 's/hburst HB;/noenum HB;/' unused.tlsf > unusedbad.tlsf

# Bad size expression on an unreferenced bus is still a diagnostic.
sed 's/y\[n\];/y[zz];/' unused.tlsf > unusedbad2.tlsf

# The valid bound on the third line must still translate cleanly.
sed '/&&\[1\.\.5\]/d;/||\[0\.\.3\]/d' qrange.tlsf > qrange-ok.tlsf

# F[1:3] a is X(a | X(a | Xa)) and G[1:N] b is X(b & X(b & X(b & Xb)))
# for N=4.
# A boolean expression in a bound is still rejected, with a location.
sed 's/F\[1:3\] a/F[a:b] a/' boundsize.tlsf > boundsize2.tlsf

# The same for the prefix extrema.
sed 's/G |{1, 2}|;/MIN {1, 2} \&\& a;/' setsizeltl.tlsf > setminltl.tlsf
oneguards() {
  cat > "$1" <<EOF
INFO {
  TITLE: "a minimal spec with one GUARANTEE"
  DESCRIPTION: "used by the multiple-binder tests"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    N = 1;
    M = 1;
  }
}
MAIN {
  INPUTS { a[4]; b[2]; }
  OUTPUTS { z; }
  GUARANTEE { $2; }
}
EOF
}

oneguards mb1.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb2.tlsf  '&&[i IN {0, 1}] &&[j IN {0, 1}] a[i + j]'
oneguards mb3.tlsf  '||[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb4.tlsf  'OR[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb5.tlsf  'EXISTS[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb6.tlsf  'FORALL[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb7.tlsf  '&&[0 <= i < 2, 0 <= j < 2] a[i + j]'
oneguards mb8.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] ||[k IN {0, 1}] a[i + j]'
oneguards mb9.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] a[i] && b[0]'
oneguards mb10.tlsf 'AND[i IN {0, 1}, j IN {0, 1}, k IN {0, 1}] a[i + j + k]'
oneguards mberr1.tlsf '&&[i IN {0, 1},] a[0]'
oneguards mberr2.tlsf 'X[N, N] a[0]'
oneguards mberr3.tlsf 'F[1:2, 3:4] a[0]'
oneguards bnd1.tlsf '&&[0 <= i < 2] X[i] a[0]'
oneguards bnd2.tlsf '&&[0 <= i < 2] F[i:1] a[0]'
oneguards bnd3.tlsf '||[i IN {0, 1}, j IN {0, 1}] X[i + j] a[0]'
oneguards bnd4.tlsf '||[i IN {0, 1}] &&[j IN {0, 1}] G[j:1] a[0]'
oneguards xstack.tlsf 'X[N] X[M] a[0]'
bigop() {
  cat > "$1" <<EOF
INFO {
  TITLE: "a minimal spec with one GUARANTEE"
  DESCRIPTION: "used by the big-operator tests"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    N = 3;
    M = 2;
  }
}
MAIN {
  INPUTS { a[4]; }
  OUTPUTS { z; }
  GUARANTEE { $2; }
}
EOF
}
bigop bo1.tlsf  'SUM[i IN {0..N-1}] i == 3'
bigop bo2.tlsf  'PROD[i IN {0..N-1}] (i + 1) == 6'
bigop bo3.tlsf  '+[i IN {0..N-1}] i == 3'
bigop bo4.tlsf  '*[i IN {0..N-1}] (i + 1) == 6'
bigop bo5.tlsf  'SUM[0 <= i < N] i == 3'
bigop bo6.tlsf  'SUM[i IN {0, 1}, j IN {0..i}] j == 1'
bigop bo7.tlsf  '|CUP[i IN {0..N-1}] {i, i + N}| == 6'
bigop bo8.tlsf  '|CAP[i IN {0..N-1}] {0, 1, i}| == 2'
bigop bo9.tlsf  '|SETMINUS[i IN {0..N-1}] {0, 1, i}| == 0'
bigop bo10.tlsf '|(+)[i IN {0..N-1}] {i, i + N}| == 6'
bigop bo11.tlsf '|(*)[i IN {0..N-1}] {0, 1, i}| == 2'
bigop bo12.tlsf '|(-)[i IN {0..N-1}] {0, 1, i}| == 0'
bigop bo13.tlsf 'SUM[i IN {1..0}] i == 0'
bigop bo14.tlsf 'PROD[i IN {1..0}] i == 1'
bigop bo15.tlsf '|CUP[i IN {1..0}] {i}| == 0'
bigop bnd5.tlsf 'SUM[i IN {0, 1}] (i + 1) == 5'
bigop bnd6.tlsf '|CUP[i IN {0, 1}, j IN {0, 1}] {i, j}| == 2'
bigop boerr1.tlsf '|CAP[i IN {1..0}] {i}| == 0'
bigop boerr2.tlsf '|SETMINUS[i IN {1..0}] {i}| == 0'
bigop boerr3.tlsf 'SUM[i IN {0..N-1}] a[i]'
bigop boerr4.tlsf 'SUM[N] i == 0'
bigop boerr5.tlsf 'CUP[i IN {0, 1}] a[i]'
sed 's/  TAGS:/  TAGS: nosuchdefinition/' tagsnone.tlsf > tagsundef.tlsf
# The specifications below are grouped by what ../parsetlsf
# does with them, not by what they are about: one invocation
# for the ones that translate cleanly under the default
# options, one for the ones it rejects.  They come after
# every derivation above, so each file is in the state it
# was in when its own invocation used to read it, and
# neither of them writes a specification the other reads.
# Both streams are compared whole, which also pins the order
# the files were given in.

( set +x
  run 0 ../parsetlsf enumkw.tlsf enumkwnear.tlsf enumkwnearref.tlsf \
    enumkwname.tlsf enumkwboth.tlsf shadowparam.tlsf shadowudef.tlsf \
    shadoweqarg.tlsf shadowanddef.tlsf shadowmixed.tlsf shadowres.tlsf \
    shadowsemi2.tlsf shadowsec.tlsf shadowseccmt.tlsf siginfu.tlsf \
    siginfand.tlsf sigbusword.tlsf mb1.tlsf mb2.tlsf mb3.tlsf mb4.tlsf \
    mb5.tlsf mb6.tlsf mb7.tlsf mb8.tlsf mb9.tlsf mb10.tlsf bnd1.tlsf \
    bnd2.tlsf bnd3.tlsf bnd4.tlsf xstack.tlsf bnd5.tlsf bnd6.tlsf \
    enumjoin3.tlsf noinfo.tlsf mismatch.tlsf mismatch2.tlsf \
    nosemantics.tlsf subst_multi.tlsf subst_two.tlsf subst_nested.tlsf \
    subst_busref.tlsf intcmp.tlsf intcmpf.tlsf enumnosemi.tlsf \
    enumsemi.tlsf enumsemi3.tlsf enumsemi4.tlsf enumnested.f \
    > p0.out 2>p0.err )
( set +x
