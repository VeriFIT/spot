cat >unresolved.tlsf <<'EOF'
INFO {
  TITLE: "unresolvable parameter"
  DESCRIPTION: "P = Q; Q = unknown"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    P = Q;
    Q = unknown;
  }
}
MAIN {
  INPUTS { a[P]; }
  OUTPUTS { z; }
  GUARANTEE { G a[0]; }
}
EOF
# Arithmetic overflow variants: the checked_add/sub/mul/mod helpers
# reject every overflow shape (crossing MIN/MAX in both directions and
# MIN / -1 in division-free operators) instead of relying on the C++
# signed-overflow behavior.
cat >overflow.tlsf <<'EOF'
INFO {
  TITLE: "checked arithmetic"
  DESCRIPTION: "overflow in add/sub/mul/mod"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    MAXI = 9223372036854775807;
    MINI = 0 - 9223372036854775807 - 1;
    p_add = MINI + (0 - 1);
    p_sub = MAXI - (0 - 1);
    p_mul1 = (0 - 1) * MINI;
    p_mul2 = MINI * (0 - 1);
    p_mul3 = 4611686018427387905 * (0 - 2);
    p_mul4 = (0 - 4611686018427387905) * 2;
    p_mul5 = MINI * (0 - 2);
    p_mod = MINI % (0 - 1);
    p_ok1 = (0 - 1) * 5;
    p_ok2 = 5 * (0 - 1);
  }
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF
# LTL-position diagnostics: a literal, a parameter, a loop variable,
# an argumentful def called bare, arithmetic/comparison, a guard
# clause, unknown X[...] / bounds, oversized quantifier ranges, and
# set literals.
cat >ltlerr.tlsf <<'EOF'
INFO {
  TITLE: "LTL position errors"
  DESCRIPTION: "translate-time diagnostics"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    gen(x) = x >= 1 : a b;
  }
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS { z; }
  GUARANTEE {
    G 5;
    G(n);
    &&[0 <= i < 2] G(i);
    G(gen);
    G(a == b);
    G(a : b);
    G(a IN {0, 1});
    X[nope] a;
    X[0 - 1] a;
    X[9999999999] a;
    F[5000000000:6000000000] a;
    &&[nope <= i < 2] a;
    &&[0 <= i < 2000000] a;
    &&[i IN 5] a[0];
    &&[i IN {0..2000000}] a[i];
    G({0, 1});
    G({0..5});
  }
}
EOF
( set +x
  run 2 ../parsetlsf unresolved.tlsf overflow.tlsf ltlerr.tlsf \
    > /dev/null 2>eval.err )
