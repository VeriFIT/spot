diff -u defsize.in.exp defsize.in
../parsetlsf --print-output-signals defsize.tlsf > defsize.out
cat >defsize.out.exp <<'EOF'
grant_0,grant_1,grant_2,grant_3
EOF
diff -u defsize.out.exp defsize.out
# Print -> reparse -> print is stable (the converter asserts it).
../parsetlsf defsize.tlsf > defsize.f2
cmp defsize.f defsize.f2

