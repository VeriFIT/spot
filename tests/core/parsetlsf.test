# Spot is distributed in the hope that it will be useful, but WITHOUT
# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
# or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
# License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

# Exercise the TLSF parser, printer, and translator through the
# tests/core/parsetlsf program.  Some checks also cross-check our
# signals, target, and formula against syfco, the reference
# implementation; those are opt-in, see below.
#
# Specifications that are expected to translate alike, and
# specifications that are expected to be rejected alike, are handed to
# ../parsetlsf in a single invocation: several file names on one command
# line cost one process startup, and under valgrind a startup costs an
# order of magnitude more than the conversion itself (see the comment in
# ../parsetlsf.cc).  In that mode the tool labels each file's output with
# a `=== FILE ===` header, so the whole merged stream is compared against
# an expectation written out inline.  Comparing the entire stream rather
# than one file at a time pins more: the exact text of every file, the
# order the files were given in, and -- for a rejected batch -- the
# column of every diagnostic and the trailing "N of M files failed"
# line, so a diagnostic that fired twice would add a line and fail.
#
# Two things are deliberately not compared whole.  A batch whose file
# names come from a glob is reached in whatever order the shell expands
# it, so only the count of matching lines is pinned.  And a stream long
# enough to break the 80-column limit is folded at the same width on
# both sides before the comparison.

. ./defs || exit 1

set -e

# syfco is the reference implementation of TLSF, and a number of checks
# below compare our reading of a specification against its, either to
# confirm that a file we accept is accepted there too or that a file we
# reject is rejected there for the same reason.  Those comparisons are
# opt-in: syfco is a third-party binary Spot does not ship and does not
# control, so a newer release that changes its mind about a file, or
# that has a bug of its own, must not be able to fail this test suite.
# Set TEST_SYFCO in the environment to run them; they additionally need
# syfco to be installed.
if test -n "$TEST_SYFCO" && syfco --version >/dev/null 2>&1; then
  test_syfco=true
else
  test_syfco=false
fi

cat >bad.tlsf <<'EOF'
// The base specifications, written first so that what follows reads
// as a flat list of what is checked against what.  A specification
// derived from another one is left with the invocations that consume
// it: deriving it is itself one step of the test.
// --------------------------------------------------------------------------
// Malformed input must be diagnosed.
INFO { TITLE: "broken
EOF

cat >small.tlsf <<'EOF'
// A small specification provides a positive end-to-end check.
INFO {
  TITLE:       "native TLSF test"
  DESCRIPTION: "small native TLSF cross-check"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {}
MAIN {
  INPUTS { request[1]; }
  OUTPUTS { grant[1]; }
  GUARANTEE { G(request[0] -> F grant[0]); }
}
EOF

cat >strict.tlsf <<'EOF'
// Strict semantics has a different composition from standard semantics:
// ASSERT is required only while REQUIRE holds, and is represented by
// ASSERT W !REQUIRE rather than G(ASSERT).
INFO {
  TITLE:       "strict TLSF test"
  DESCRIPTION: "strict semantics cross-check"
  SEMANTICS:   Mealy,Strict
  TARGET:      Mealy
}
GLOBAL {}
MAIN {
  INPUTS { request; env; }
  OUTPUTS { grant; }
  INITIALLY { request; }
  PRESET { grant; }
  REQUIRE { G(request); }
  ASSUME { env; }
  ASSERT { grant; }
  GUARANTEE { F grant; }
}
EOF

cat >chomp.tlsf <<'EOF'
// The real-world benchmark specifications are embedded here rather
// than read from the top-level source directory, so that the test
// does not depend on files that may be absent from a distribution.
INFO {
  TITLE:       "Chomp Game"
  DESCRIPTION: "Parameteric Chomp Game over a NxM grid"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}

GLOBAL {
  PARAMETERS {
    N = 3;
    M = 3;
  }
  DEFINITIONS {
    Pos(grid, i, j) = grid[i + j * N];
    PickOne(sel) = ||[0 <= k < (SIZEOF sel)] sel[k];
    // if sel[i] is true, sel[i+1] should be too.
    AboveToo(sel) = &&[0 <= i < ((SIZEOF sel) - 1)] (sel[i] -> sel[i+1]);
    // if it's the other's turn, all values of sel should be false
    OtherTurn(other, sel) = other -> (&&[0 <= k < (SIZEOF sel)](!sel[k]));
    // if it's the other's turn and square (0,0) still exists, our
    // choices for sx and sy on next turn depend on what square is
    // available in the grid.
    NextChoices(grid, other, sx, sy) =
      (Pos(grid, 0, 0) && other) ->
        (||[0 <= x < N] ||[0 <= y < M] (Pos(grid, x, y) && X(sx[x] && sy[y])));
    // Rules that both players should obey
    PlayerRules(grid, other, sx, sy) =
       AboveToo(sx) &&
       AboveToo(sy) &&
       OtherTurn(other, sx) &&
       OtherTurn(other, sy) &&
       NextChoices(grid, other, sx, sy);
  }
}

MAIN {
  INPUTS {
    // When it's the input player's turn, they
    // use ix[I] iy[J] to select square (I,J).
    ix[N];
    iy[M];
  }
  OUTPUTS {
    // When it's the output player's turn, they
    // use ox[I] oy[J] to select square (I,J).
    ox[N];
    oy[M];
    // whether a square is available
    os[N*M];
    // turn
    oti; // input turn
    oto; // output turn
  }
  PRESET {
    // The output player is the first player.
    !oti && oto;
    // The output player has to choose a square.
    PickOne(ox);
    PickOne(oy);
    // The squares that are taken initially depend on the first choice.
    &&[0 <= i < N] &&[0 <= j < M] (Pos(os, i, j) <-> !(ox[i] && oy[j]));

    // Turns alternate between players.
    // (Writing G(oto <-> X oti) would be ok in LTL, but not LTLf.)
    G(oti <-> !oto);
    G(oto -> X oti);
    G(oti -> X oto);
  }
  REQUIRE {
    PlayerRules(os, oto, ix, iy);
  }
  ASSERT {
    PlayerRules(os, oti, ox, oy);
    // If (i,j) is selected by either player, then (i,j) should become false.
    &&[0 <= i < N] &&[0 <= j < M]
      (((ox[i] && oy[j]) || (ix[i] && iy[j])) -> !Pos(os,i,j));
    // if (i,j) is not available now, it's not available on next turn.
    &&[0 <= i < N] &&[0 <= j < M] ((!Pos(os,i,j)) -> X !(Pos(os,i,j)));
    // if (i,j) is available now, it might not be on next turn.
    &&[0 <= i < N] &&[0 <= j < M]
      (Pos(os,i,j) -> X(Pos(os,i,j) || (ox[i] && oy[j]) || (ix[i] && iy[j])));
  }
  GUARANTEE {
    // The game finishes once square (0, 0) has been taken, and since
    // this square is poisonous, we want the input player to take it.
    Pos(os,0,0) U (!Pos(os,0,0) && oti);
  }
}
EOF

cat >tictactoe.tlsf <<'EOF'
INFO {
  TITLE:       "Tic Tac Toe"
  DESCRIPTION: "Tic Tac Toe Game, Finite version"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}

GLOBAL {
  DEFINITIONS {
    PickOne(A) = (||[0 <= i < 9] A[i]) && (&&[0 <= i < 9]
                 (A[i] -> &&[i <= j < 9] !A[j]));
    // Keep the value of A[b...e] for next step.
    NoChange(A,b,e) = &&[b <= i < e] ((A[i] && X(A[i])) || (!A[i] && X(!A[i])));
    // change a single cell in A that isn't used in B.
    ChangeOne(A, B) = (||[0 <= i < 9] ((!A[i] && !B[i]) -> X(A[i]))) &&
      (&&[0 <= i < 9] ((!A[i] && X(A[i])) -> NoChange(A, i+1, 9)));
    // all cells are taken by one of the player
    AllTaken(A, B) = &&[0 <= i < 9] (A[i] || B[i]);
    // check for three aligned cells
    Aligned(A) = (A[0] && A[1] && A[2]) ||
                 (A[3] && A[4] && A[5]) ||
                 (A[6] && A[7] && A[8]) ||
                 (A[0] && A[3] && A[6]) ||
                 (A[1] && A[4] && A[7]) ||
                 (A[2] && A[5] && A[8]) ||
                 (A[0] && A[4] && A[8]) ||
                 (A[2] && A[4] && A[6]);
  }
}

MAIN {
  // The cells are numbered as follows:
  //   0 1 2
  //   3 4 5
  //   6 7 8
  // pi[n] is true iff the input player marked cell n.
  // po[n] is true iff the output player marked cell n.
  INPUTS {
    pi[9];
  }
  OUTPUTS {
    po[9];
    turno; // false = input's turn, true = output's turn
  }
  PRESET {
    // The output player is the first player.
    turno;
    // Turn alternate betwen players
    // (The number of turns is odd, so it's OK to use an equivalence
    // with weak X here, it means that if turno is false the next step must
    // exist.)
    G(turno <-> X !turno);
    // The player should select a single cell.
    PickOne(po);
  }
  INITIALLY {
    // the input player does not select any value on first turn.
    &&[0 <= i < 9] !pi[i];
  }
  REQUIRE {
    // if the next turn is the input's player turn, they
    // should change exactly one cell that isn't taken by any player
    X(!turno) -> ChangeOne(pi, po);
    // If it not the input's turn, we do not want to see any change.
    X(turno) -> NoChange(pi, 0, 9);
  }
  ASSERT {
    // if the next turn is the outut's player turn, they
    // should change exactly one cell that isn't taken by any player
    X[!](turno) -> ChangeOne(po, pi);
    // If it not the output's turn, we do not want to see any change.
    X[!](!turno) -> NoChange(po, 0, 9);
  }
  GUARANTEE {
    // The game finishes all cells are taken, or if the output player
    // has aligned 3 cells.
    F(AllTaken(pi,po) || Aligned(po));
    // The output player should never align 3 cells.
    G(!Aligned(pi));
  }
}
EOF

cat >quantunary.tlsf <<'EOF'
// A quantifier (&&[...] or ||[...]) below a unary operator used to
// make tlsf_print oscillate: the UnaryOp deparse case wrapped the
// unparenthesized quantifier child in parens, but the Quantifier case
// reprinted a parenthesized quantifier bare, so print -> parse -> print
// alternated between the two spellings forever.  The three MAIN
// spellings below are adapted from existing TLSF benchmarks
// (generalized buffer, load balancer, round-robin arbiter).
INFO {
  TITLE:       "quantifier under unary operator"
  DESCRIPTION: "printer round-trip regression"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS {
    N = 2;
  }
}
MAIN {
  INPUTS {
    req[N];
  }
  OUTPUTS {
    ack[N];
    idle;
  }
  ASSUME {
    G &&[0 <= i < N] (req[i] -> X req[i]);
    G (idle && X &&[0 <= i < N] ! ack[i] -> X idle);
    ! idle -> X (&&[0 <= i < N] ! ack[i]);
    &&[0 <= i < N] (req[i] -> X F ||[0 <= i < N] ack[i]);
    G idle -> &&[0 <= i < N] ack[i];
  }
  GUARANTEE {
    G (idle <-> &&[0 <= i < N] ! req[i]);
  }
}
EOF

cat >enum.tlsf <<'EOF'
// Brace-less enum declarations (Sec. 4.4 of the TLSF specification):
// entries whitespace-separated, commas extend one tag's pattern list,
// width fixed by the first pattern.  The `U` tag exercises the
// scanner's `enumdecl` state (no LTL keyword reservation in tag
// position).  The enum pattern shape below comes from a bus-arbiter
// benchmark.
GLOBAL {
  DEFINITIONS {
    enum hburst =
      SINGLE: 01
      INCR:   00
      BURST4: 10;
    enum cover = U: 11*, 1*1, *11;
    enum dup = A: 00 A: 11;
  }
}
MAIN {
  INPUTS {
    req;
  }
  OUTPUTS {
    grant;
  }
  GUARANTEE {
    G(grant <-> req);
  }
}
EOF

cat >enumnosemi.tlsf <<'EOF'
// The enum grammar of TLSF v1.2 SS4.4 has no terminator, so the `;`
// is optional when the enum is the last item of the DEFINITIONS
// block.  This is the paper's own `Position` example, verbatim but
// without the `;`, followed by a `MAIN` section: the `}` that closes
// DEFINITIONS must end the enum body.
GLOBAL {
  DEFINITIONS {
    enum Position =
      ZERO:    0000
      ONE:     0001
      TWO:     0010
      THREE:   0011
      INVALID: 1111
  }
}
MAIN {
  INPUTS  { req; }
  OUTPUTS { grant; }
  GUARANTEE {
    G(grant <-> req);
  }
}
EOF

cat >enumnested.tlsf <<'EOF'
// Two `;`-less enums cannot be juxtaposed either: the keyword is neither
// a tag nor the end of the body, and the following declaration is not
// reachable without a separator.
GLOBAL {
  DEFINITIONS {
    enum Position =
      ZERO:    0000
      ONE:     0001
      TWO:     0010
      THREE:   0011
      INVALID: 1111
    enum Other = X: 00
    enum Last = Y: 11
  }
}
MAIN {
  INPUTS  { req; }
  OUTPUTS { grant; }
  GUARANTEE {
    G(grant <-> req);
  }
}
EOF

cat >enumkw.tlsf <<'EOF'
// TLSF's list of words is a scanner convention, not a reservation: a
// word that the file itself declares as the name or a tag of an `enum`
// is an identifier wherever it is used, as syfco does.  The scanner
// collects those words in `tlsf_result` and consults that set before
// returning a keyword, so `U` and the rest of TLSF's word list stop
// being reserved in this file only.
GLOBAL {
  DEFINITIONS {
    enum E = U: 00 V: 01;
  }
}
MAIN {
  INPUTS  { E b; }
  OUTPUTS { grant; }
  GUARANTEE {
    G((b == U) -> grant);
    G(b != V);
  }
}
EOF

cat >enumkwnear.tlsf <<'EOF'
// A word must not match by prefix: `U2` is a plain identifier, even
// though `U` is one of TLSF's words.
GLOBAL {
  DEFINITIONS {
    enum E = U2: 00;
  }
}
MAIN {
  INPUTS  { E b; c; }
  OUTPUTS { grant; }
  GUARANTEE {
    G((b == U2) && (b[0] AND c)) -> grant;
  }
}
EOF

cat >enumkwname.tlsf <<'EOF'
// The same, for a word used as the *name* of an enumeration: `b`'s type
// is spelled `EQ`, and `==` is still the equality word.
GLOBAL {
  DEFINITIONS {
    enum EQ = A: 00;
  }
}
MAIN {
  INPUTS  { EQ b; }
  OUTPUTS { grant; }
  GUARANTEE {
    G((b == A) -> grant);
  }
}
EOF

cat >enumkwboth.tlsf <<'EOF'
// A word may keep its other meanings: `AND` and `OR` are both the
// infix word and the bracketed form, so with a tag named AND in scope
// `b AND c` must still be the conjunction.
GLOBAL {
  DEFINITIONS {
    enum E = AND: 00;
  }
}
MAIN {
  INPUTS  { b; c; E d; }
  OUTPUTS { grant; }
  GUARANTEE {
    G(((b AND c) && (d == AND)) -> grant);
  }
}
EOF

cat >enumkwsec.tlsf <<'EOF'
// ... and a section keyword is shadowed the same way: an enumeration
// may be named GLOBAL and used as a bus type, and the `GLOBAL {` that
// opens this very file's global section is still that section.  The
// neutral-name reference is the same specification, so the two must
// give the same formula.
INFO {
  TITLE:       "an enum named after a section keyword"
  DESCRIPTION: "GLOBAL is an enum here and a section there"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    enum GLOBAL = A: 00 B: 11;
  }
}
MAIN {
  INPUTS  { GLOBAL b; }
  OUTPUTS { grant; }
  GUARANTEE {
    G((b == A) -> grant);
  }
}
EOF

cat >shadowparam.tlsf <<'EOF'
// A word may also be shadowed by the other name kinds the file declares:
// a parameter, a definition, or one of a definition's formal arguments
// are recorded in `declared_words` like enum names and tags.
GLOBAL {
  PARAMETERS {
    AND = 1;
  }
}
MAIN {
  INPUTS  { b[2]; }
  OUTPUTS { d; }
  GUARANTEE {
    G(b[AND] -> d);
  }
}
EOF

cat >shadowudef.tlsf <<'EOF'
// A definition named U is an identifier, while `U` immediately after an
// expression is still the until word.
GLOBAL {
  DEFINITIONS {
    U = c;
  }
}
MAIN {
  INPUTS  { a; b; c; }
  OUTPUTS { d; }
  GUARANTEE {
    G((a U b) -> U);
  }
}
EOF

cat >shadoweqarg.tlsf <<'EOF'
// A definition and a formal argument may both be words: `EQ(AND) = AND`
// reads the name EQ, the formal AND, and the body AND as identifiers.
GLOBAL {
  DEFINITIONS {
    EQ(AND) = AND;
  }
}
MAIN {
  INPUTS  { v; }
  OUTPUTS { d; }
  GUARANTEE {
    G(EQ(v) -> d);
  }
}
EOF

cat >shadowanddef.tlsf <<'EOF'
// A definition named AND keeps the infix AND: `(c AND d) AND AND` is the
// conjunction of c, d, and the definition.
GLOBAL {
  DEFINITIONS {
    AND = b;
  }
}
MAIN {
  INPUTS  { b; c; d; }
  OUTPUTS { out; }
  GUARANTEE {
    G((c AND d) AND AND);
  }
}
EOF

cat >shadowmixed.tlsf <<'EOF'
// The three name kinds are recorded together: a parameter AND, a
// definition EQ, and a parameterized definition plus(x) are all found
// in one file.
GLOBAL {
  PARAMETERS {
    AND = 1;
  }
  DEFINITIONS {
    EQ = b;
    plus(x) = x;
  }
}
MAIN {
  INPUTS  { b[2]; v; }
  OUTPUTS { d; }
  GUARANTEE {
    G((plus(v) OR EQ) -> b[AND]);
  }
}
EOF

cat >shadowres.tlsf <<'EOF'
// The words with no scanner trigger stay reserved as names of these
// kinds too: a parameter may be *declared* G (the declaration is read
// contextually) but never *referenced*.
GLOBAL {
  PARAMETERS {
    G = 1;
  }
}
MAIN {
  INPUTS  { b; }
  OUTPUTS { d; }
  GUARANTEE {
    G(b -> d);
  }
}
EOF

cat >shadowresneg.tlsf <<'EOF'
// ... and referencing one is a syntax error.
GLOBAL {
  PARAMETERS {
    X = 2;
  }
}
MAIN {
  INPUTS  { b[3]; }
  OUTPUTS { d; }
  GUARANTEE {
    G(X -> d);
  }
}
EOF

cat >shadowsec.tlsf <<'EOF'
// A section keyword is a name like any other when no brace of its
// section follows, so a definition named GLOBAL is an identifier here...
INFO {
  TITLE:       "a definition named after a section keyword"
  DESCRIPTION: "GLOBAL is a definition here and a section there"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    GLOBAL = c;
  }
}
MAIN {
  INPUTS  { c; }
  OUTPUTS { d; }
  GUARANTEE {
    G(GLOBAL -> d);
  }
}
EOF

cat >nested.tlsf <<'EOF'
// TLSF v1.2 SS4.9: "Multi line comments can be nested", so a block
// comment may contain block comments, and only the closing pair that
// matches the innermost one closes it.  The fixture below puts a nested
// comment in every position the scanner reads one, and is kept
// spellable by syfco so that the opt-in cross-checks below mean
// something.  Two positions are avoided deliberately: syfco rejects a
// comment that follows the `(` of an expression with no space in
// between -- it takes `G( /* c */ x)` but not `G(/* c */ x)`, whatever
// the comment nests -- so every comment below follows either a space or
// something else.  Spot accepts that spelling too; it is exercised in
// tests/python/parsetlsf.py.
INFO /* a /* b */ c */ {
  TITLE:       "nested comments"
  DESCRIPTION: "one nested comment in every position the scanner has one"
  SEMANTICS:   /* d /* e */ f */ Mealy
  TARGET:      Mealy
  /* g /* h */ i */ TAGS: x, /* j /* k */ l */ y
}
GLOBAL {
  PARAMETERS /* m /* n */ o */ {
    /* p */ N /* q /* r */ s */ = /* t /* u */ v */ 2;
  }
  DEFINITIONS {
    /* w */ enum /* x /* y */ z */ Mode = /* a /* b */ c */ U:
       /* d /* e */ f */ 00*, // g
       /* h /* i */ j */ 1*0;
    m( /* k /* l */ m */ x) = G( /* n /* o */ p */ x);
  }
}
MAIN {
  INPUTS /* q /* r */ s */ {
    /* t /* u */ v */ req[N];
    /* w /* x /* y */ z */ a /* b /* c */ d /* e */ f */ g */
  }
  OUTPUTS { ack; /* e /* f */ g */ }
  GUARANTEE {
    /* h /* i */ j */ G(req[0] -> F ack); /* k /* l /* m */ n /* o */ p */ q */
  }
}
EOF

cat >nestedplain.tlsf <<'EOF'
// The comments are gone from the canonical form, so the file parses to
// what the same specification without any comment parses to.
INFO {
  TITLE:       "nested comments"
  DESCRIPTION: "one nested comment in every position the scanner has one"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS: x, y
}
GLOBAL {
  PARAMETERS {
    N = 2;
  }
  DEFINITIONS {
    enum Mode = U: 00*, 1*0;
    m(x) = G(x);
  }
}
MAIN {
  INPUTS {
    req[N];
  }
  OUTPUTS { ack; }
  GUARANTEE {
    G(req[0] -> F ack);
  }
}
EOF

# A nested comment that spans several lines moves the line counter like
# any other multi-line comment does, so the diagnostic below points at
# line 15 -- before, when the comment was matched by a single flat
# regular expression, every newline inside it counted as one column and
# the same diagnostic named line 12.  syfco names line 15 as well.
cat >nestedlines.tlsf <<'EOF'
INFO {
  TITLE:       "multi-line nested comment"
  DESCRIPTION: "the line counter follows the comment"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { x; }
  OUTPUTS { o; }
  GUARANTEE {
    /* line 11
       line 12 /* nested
       line 13 */
       line 14 */
    o @;
  }
}
EOF

cat >nestedunclosed.tlsf <<'EOF'
// nestedlines: the syntax error of the fixture above.
// nestedunclosed: the outer comment of the next one is never closed, so
// the scanner reaches the end of the file inside it and says so.
INFO {
  TITLE:       "unclosed nested comment"
  DESCRIPTION: "the outer comment is never closed"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { x; }
  OUTPUTS { o; }
  GUARANTEE { /* a /* b */ c
G(x -> o); }
}
EOF

cat >shadowsemi.tlsf <<'EOF'
// Two adjacent `;`-less definitions are read as one item, so the second
// name gets no declaration context: `f = c U = c` cannot name the
// definition U.  Writing the `;` makes it parse.
GLOBAL {
  DEFINITIONS {
    f = c U = c;
  }
}
MAIN {
  INPUTS  { c; }
  OUTPUTS { d; }
  GUARANTEE {
    G(U -> d);
  }
}
EOF

cat >siginfu.tlsf <<'EOF'
// The word-shadowing of SPEC rule 18 extends to the INPUTS/OUTPUTS
// signal lists: a signal named like a shadowable word (U, AND, EQ, ...)
// is declared there and usable in the bodies, exactly like a parameter
// or definition name -- while a word-shaped enumeration type is read in
// the same context, it is only ever a reference and never shadows
// anything (test `sigtypebad` below).
GLOBAL {
}
MAIN {
  INPUTS  { U; a; b; }
  OUTPUTS { d; }
  GUARANTEE {
    G((a U b) -> (a U U));
  }
}
EOF
cat >siginfand.tlsf <<'EOF'
GLOBAL {
}
MAIN {
  INPUTS  { AND; c; d; }
  OUTPUTS { out; }
  GUARANTEE {
    G((c AND d) AND AND);
  }
}
EOF

cat >sigbusword.tlsf <<'EOF'
// A bus named U with a width bounded by the parameter AND reads both
// words: the name position and the width expression shadow separately.
GLOBAL {
  PARAMETERS { AND = 1; }
}
MAIN {
  INPUTS  { U[2]; }
  OUTPUTS { out; }
  GUARANTEE {
    G(U[0] -> (U[AND] OR out));
  }
}
EOF

cat >sigtypedu.tlsf <<'EOF'
// A typed bus may give a word-shaped name to its signal; the name is
// recorded, the type is not (it is a reference, not a declaration).
GLOBAL {
  DEFINITIONS {
    enum EQ = A: 00 B: 01;
  }
}
MAIN {
  INPUTS  { EQ AND; }
  OUTPUTS { d; }
  GUARANTEE {
    G(d);
  }
}
EOF

cat >sigtypebad.tlsf <<'EOF'
// A word-shaped enumeration type is NOT a declaration: spilling `U`
// into `declared_words` would break `a U b`.  The file fails on the
// undeclared type, but not with a syntax error in the until.
GLOBAL {
}
MAIN {
  INPUTS  { U st; }
  OUTPUTS { d; }
  GUARANTEE {
    G((a U b) -> st);
  }
}
EOF

cat >sigresname.tlsf <<'EOF'
// An unreservable word stays its keyword token inside a signal list,
// both as the name and as the type of a typed bus.
GLOBAL {
}
MAIN {
  INPUTS  { G; b; }
  OUTPUTS { d; }
  GUARANTEE {
    G(b -> d);
  }
}
EOF

cat >sigsecshadow.tlsf <<'EOF'
// The other name kinds are shadowed the same way, and a section
// keyword may be a name and a section in one file: MAIN is a signal
// here, INFO a parameter, PRESET an enumeration, ASSERT and GUARANTEE
// its tags, while the GLOBAL, MAIN, INITIALLY, PRESET and GUARANTEE
// sections of this very file are still those sections.
INFO {
  TITLE:       "a section keyword is a name and a section"
  DESCRIPTION: "the same spelling is both, in one file"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS {
    INFO = 2;
  }
  DEFINITIONS {
    enum PRESET = ASSERT: 00 GUARANTEE: 11;
  }
}
MAIN {
  INPUTS  { MAIN; b[INFO]; PRESET p; }
  OUTPUTS { d; }
  INITIALLY { true; }
  PRESET { p == GUARANTEE; }
  GUARANTEE {
    G(MAIN -> b[0] && (p == ASSERT) && (p != GUARANTEE));
  }
}
EOF

cat >enumkwstate.tlsf <<'EOF'
// `enum` is one of the two words the declared-word test is applied to
// without a trigger (the keyword reading switches start condition), so
// a signal named enum is that signal where it is used, while the
// `enum E = ...;` of the same file is still that declaration.
INFO {
  TITLE:       "a signal named enum"
  DESCRIPTION: "enum is a signal here and a keyword there"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    enum E = A: 00;
  }
}
MAIN {
  INPUTS  { enum; b; E p; }
  OUTPUTS { d; }
  GUARANTEE {
    G((enum -> b) && (p == A));
  }
}
EOF

cat >semvalbad.tlsf <<'EOF'
// An invalid value is still rejected, and the diagnostic names the
// words a value may be made of.  The value is read in the initial
// condition, where MAIN is the section keyword it is and Main a plain
// identifier.  syfco rejects both.
INFO {
  TITLE:       "an invalid SEMANTICS value"
  DESCRIPTION: "MAIN is a section keyword, not a machine kind"
  SEMANTICS:   MAIN
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { b; }
  OUTPUTS { d; }
  GUARANTEE {
    G(b -> d);
  }
}
EOF

cat >enumbad.tlsf <<'EOF'
// Negative cases: braced form, empty enum, cross-tag overlap, and
// width mismatch must all be rejected (strict syfco parity).
GLOBAL {
  DEFINITIONS {
    enum C = { A: 00, B: 01 };
  }
}
MAIN {
  INPUTS {
    req;
  }
  OUTPUTS {
    grant;
  }
  GUARANTEE {
    G(grant <-> req);
  }
}
EOF

cat >typedbus.tlsf <<'EOF'
// Typed enum buses (TLSF v1.2 SS4.5) and parameterless definitions
// (syfco's reminderParser x [] pos), in the shapes used by
// amba_case_study.tlsf: a typed input bus expanded to NAME_i APs, an
// enum comparison folded to bit patterns, a parameterless definition
// (`m = log2(n);`) whose recursive body is evaluated in integer
// position for a bus size, and a bare zero-arg macro in LTL position.
GLOBAL {
  PARAMETERS {
    n = 8;
  }
  DEFINITIONS {
    enum hburst =
      SINGLE: 01
      INCR:   00
      BURST4: 10;
    m = log2(n);
    log2(x) =
      x <= 1     : 1
      otherwise : 1 + log2(x / 2);
    g(x) = G x;
  }
}
MAIN {
  INPUTS {
    req[n];
    hburst HBURST;
  }
  OUTPUTS {
    grant[m];
    ack;
  }
  GUARANTEE {
    g(ack);
    G((HBURST == INCR) -> ack);
    G((HBURST != SINGLE) || grant[0]);
    G(req[3]);
    G(!grant[3]);
  }
}
EOF

cat >wideenum2.tlsf <<'EOF'
// The single tag pins all 17 bits, so the constraint is exactly that
// conjunction: one literal per bit, one term, and no valuation loop.
// A 32-bit enum with two tags: one disjunct per tag, and no
// valuation-sized blow-up.
GLOBAL {
  DEFINITIONS {
    enum E32 =
      LOW:  0000000000000000000000000000000
      HIGH: 1111111111111111111111111111111;
  }
}
MAIN {
  INPUTS  { E32 b; }
  OUTPUTS { o; }
  GUARANTEE { o; }
}
EOF

cat >wideenum3.tlsf <<'EOF'
// A tag made only of wildcards covers every valuation, so a wide bus
// needs no constraint at all.
GLOBAL {
  DEFINITIONS {
    enum E20 =
      ANY: ********************;
  }
}
MAIN {
  INPUTS  { E20 b; }
  OUTPUTS { o; }
  GUARANTEE { o; }
}
EOF

cat >defsize.tlsf <<'EOF'
// Definition calls in bus-size expressions (the shapes used by
// amba_case_study.tlsf, simple_arbiter_enc8.tlsf, and robot_grid.tlsf):
// `HMASTER[nbits(n)]` with a recursive guarded definition, a nested call
// `grant[nbits(n+1)]`, and a call with an arithmetic argument.  The App
// node is part of the integer `expr` and is evaluated at declaration
// time.
GLOBAL {
  PARAMETERS {
    n = 8;
  }
  DEFINITIONS {
    log2_dn(x) =
      x <= 1    : 0
      otherwise : 1 + log2_dn(x / 2);
    nbits(x) =
      x == 0    : 0
      otherwise : 1 + log2_dn(x - 1);
  }
}
MAIN {
  INPUTS { request[nbits(n)]; }
  OUTPUTS { grant[nbits(n+1)]; }
  GUARANTEE { G(request[0] -> grant[0]); }
}
EOF

cat >semifinal.tlsf <<'EOF'
// The semicolon of the LAST statement before `}` is optional in every
// MAIN body, and likewise for the last declaration of an INPUTS/OUTPUTS
// list (shapes used by amba_decomposed_lock*.tlsf,
// amba_decomposed_decode.tlsf, lilydemo03.tlsf, ltl2dpa22.tlsf, ...).
// The semicolon remains mandatory BETWEEN two statements/declarations.
GLOBAL {}
MAIN {
  INPUTS  { a; HBURST[2] }
  OUTPUTS { ok[2] }
  INITIALLY { a }
  PRESET { !ok[0] }
  REQUIRE { G a }
  ASSUME { a -> HBURST[0] }
  ASSERT { !(a && HBURST[1]) }
  GUARANTEE { G (a -> F ok[0]) }
}
EOF

cat >semifinal_semi.tlsf <<'EOF'
// The same spec, fully punctuated, must yield the same translation.
GLOBAL {}
MAIN {
  INPUTS  { a; HBURST[2]; }
  OUTPUTS { ok[2]; }
  INITIALLY { a; }
  PRESET { !ok[0]; }
  REQUIRE { G a; }
  ASSUME { a -> HBURST[0]; }
  ASSERT { !(a && HBURST[1]); }
  GUARANTEE { G (a -> F ok[0]); }
}
EOF

cat >temporal.tlsf <<'EOF'
// Bounded temporal operators `F[a:b] phi` / `G[a:b] phi`
// and the stacked next `X[n] phi`.  Bounds are integer
// expressions (parameters allowed) and are lowered with the
// spot::formula::F/G/X overloads taking a level argument; an empty range
// (a > b) is vacuously true, matching syfco.
//
// Every supported operator appears once in a single guarantee, guarded by
// its own bit of the bus `b`, so that one translation covers them all and
// a wrong conjunct names the operator that produced it.  The list is
// b[0] F[2:3], b[1] G[1:2], b[2] F[0:0], b[3] F[0:n-1], b[4] G[0:n-2],
// b[5] F[2:1], b[6] G[3:1], b[7] X[0], b[8] X[2], b[9] X[n], and
// b[10] a bounded operator under `!`, which must keep its grouping.
//
// The two empty ranges are the ones with the guard the other way round:
// `F[2:1] a -> b[5]` rather than `b[5] -> F[2:1] a`.  An empty range is
// vacuously true, so the first form reduces to the bare literal b_5 and
// the fold shows up in the expectation, whereas the second would reduce
// to tt and leave no trace at all.  Were the range not empty the
// conjunct would read (XXa -> b_5) instead, so the two are told apart by
// the expectation rather than by an absence.
GLOBAL { PARAMETERS { n = 3; } }
MAIN {
  INPUTS { a; b[11]; }
  OUTPUTS { c; }
  GUARANTEE {
    b[0] -> F[2:3] a;
    b[1] -> G[1:2] a;
    b[2] -> F[0:0] a;
    b[3] -> F[0:n-1] a;
    b[4] -> G[0:n-2] a;
    F[2:1] a -> b[5];
    G[3:1] a -> b[6];
    b[7] -> X[0] a;
    b[8] -> X[2] a;
    b[9] -> X[n] a;
    b[10] -> !(F[0:1] a);
  }
}
EOF

cat >strong.tlsf <<'EOF'
// The strong (LTLf) flavour of the stacked next and of the bounded
// temporal operators, TLSF v1.2 SS4.8: `X[!n]` / `X[n!]`,
// `F[!a:b]` / `F[a:b!]`, and likewise for G.  The `!` is a marker next
// to one of the brackets, and TLSF spells it on either side; both
// spellings denote the same operator, so each pair of bits below maps
// to a single conjunct.  Every expectation here was cross-checked
// against `syfco -f ltlxba-fin` on this very guarantee; the only
// differences are notation (syfco writes `||`, `&&`, `true` and keeps
// the parentheses around a nested `X[!]`, we write `|`, `&`, `1` and
// drop them).
//
// Strong next is only defined over a finite run, so unlike the block
// above this one needs SEMANTICS: Mealy,Finite; the tail of the block
// checks that every strong spelling is rejected under Mealy alone.
INFO {
  TITLE: "t"
  DESCRIPTION: "strong temporal bounds"
  SEMANTICS: Mealy,Finite
  TARGET: Mealy
}
GLOBAL { PARAMETERS { n = 3; } }
MAIN {
  INPUTS { a; b[10]; }
  OUTPUTS { c; }
  GUARANTEE {
    b[0] -> F[!2:3] a;
    b[1] -> F[2:3!] a;
    b[2] -> G[!1:2] a;
    b[3] -> G[1:2!] a;
    b[4] -> X[!2] a;
    b[5] -> X[2!] a;
    b[6] -> F[!0:n-1] a;
    b[7] -> G[!0:n-2] a;
    b[8] -> X[!n] a;
    F[!2:1] a -> b[9];
  }
}
EOF

cat >unused.tlsf <<'EOF'
// Declared signals are registered eagerly, in the spirit of syfco:
// an unused scalar, sized bus, or typed bus still appears in the
// signal list, and a bad bus size or unknown enum type is diagnosed
// at declaration even when the bus is never referenced.  (The order
// in which syfco lists signals differs from ours; only the sets must
// agree.)
GLOBAL {
  PARAMETERS {
    n = 2;
  }
  DEFINITIONS {
    enum hburst =
      SINGLE: 01
      INCR:   00
      BURST4: 10;
  }
}
MAIN {
  INPUTS {
    b;
    y[n];
    hburst HB;
  }
  OUTPUTS {
    w[2];
    z;
  }
  GUARANTEE { G(b -> z); }
}
EOF

cat >qrange.tlsf <<'EOF'
// The un-braced quantifier range `&&[lo..hi]` is not valid TLSF
MAIN {
  INPUTS  { a; }
  OUTPUTS { ok; }
  GUARANTEE {
    &&[1..5] a;
    ||[0..3] a;
    &&[0 <= i < 2] a;
  }
}
EOF

cat >builtsize.tlsf <<'EOF'
// Every integer position of the language accepts the same `expr`: the
// builtins MIN, MAX, and SIZEOF, a set-literal membership test, and a
// PARAMETER whose own value is an expression.  Nothing outside the
// integer language is accepted, and a rejection is diagnosed with a
// location at translation time, by eval_int.
GLOBAL {
  PARAMETERS {
    N = 4;
    M = 2;
    L = MIN(N, M);
  }
  DEFINITIONS {
    nbits(x) = x + 1;
  }
}
MAIN {
  INPUTS {
    a;
    bus[N];
    c[MIN(N, M)];
    d[MAX(N, M)];
    e[SIZEOF bus];
    f[nbits(N)];
    g[N IN {2, 3, 4}];
    h[L];
  }
  OUTPUTS { z; }
  GUARANTEE { G(a -> z); }
}
EOF

cat >boundsize.tlsf <<'EOF'
// The same language in the bounds of F[a:b] and G[a:b], and in X[n].
GLOBAL {
  PARAMETERS {
    N = 4;
  }
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS { z; }
  GUARANTEE {
    F[1:3] a;
    G[1:N] b;
    X[2] a;
  }
}
EOF

cat >groupedsize.tlsf <<'EOF'
// Bus-size expressions are parsed ASTs, not strings: user parentheses
// around a subterm must survive the print -> reparse round-trip and
// keep their grouping.  With N=4, M=2 the size (N+1)*M is 10 while
// the left-associative misprint N+1*M would be 6, so the flattened
// signal list pins the correct evaluation.
GLOBAL {
  PARAMETERS {
    N = 4;
    M = 2;
  }
}
MAIN {
  INPUTS { a[(N+1)*M]; }
  OUTPUTS { z; }
  GUARANTEE { G(z -> a[9]); }
}
EOF

cat >negspan.tlsf <<'EOF'
// A quantifier whose comparison chain has a negative lower bound: the
// span is still 0 <= i < 3, but the loop variable i starts at 0 - 1
// (the -1 is part of the bound, not of i's range).  The body indexes
// a[i+1], so the unfolded conjunction covers a_0..a_3 and their next
// values.
GLOBAL {}
MAIN {
  INPUTS { a[4]; }
  OUTPUTS { z; }
  GUARANTEE { G &&[0 - 1 <= i < 3] (a[i + 1] && X a[i + 1]); }
}
EOF

cat >inbody.tlsf <<'EOF'
// A membership quantifier inside a DEFINITION body: the inner `i` is
// bound by the quantifier, not a formal of the enclosing definition,
// so substitution must leave it intact.
GLOBAL {
  DEFINITIONS {
    qsel(x) = &&[i IN {0, 1}] x[i];
  }
}
MAIN {
  INPUTS { b[2]; }
  OUTPUTS { z; }
  GUARANTEE { G(b[0] -> qsel(b)); }
}
EOF

cat >guards.tlsf <<'EOF'
// Every guard shape of a guarded definition: a literal, true/false, a
// parameter, its negation, an And whose truth is decided by either
// side, an Or, !=, >=, and a membership.
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    lit1(x) = 1 : a;
    lit0(x) = 0 : b a;
    tru(x) = true : a;
    fal(x) = false : a b;
    par(x) = n : a;
    nt(x) = !(x == 0) : a b;
    andg(x) = (x > 0 && x <= 2) : a;
    andf(x) = (x > 1 && x < 1) : a b;
    org(x) = (x < 3 || x > 5) : a;
    orf(x) = (x < 1 || x > 5) : a b;
    neqg(x) = (x != 0) : a;
    geg(x) = (x >= 2) : a;
    ing(x) = (x IN {1}) : a;
    inf(x) = (x IN {7}) : a b;
  }
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS { z; }
  GUARANTEE {
    G(lit1(0) && lit0(0) && tru(0) && fal(0) && par(0) && nt(1)
      && andg(2) && andf(0) && org(2) && orf(2) && neqg(3) && geg(3)
      && ing(1) && inf(4));
  }
}
EOF

cat >guardbad.tlsf <<'EOF'
// A definition whose guard mentions an AP (or mixes an AP with an
// undecidable integer comparison) is not statically decidable; an
// unguarded remainder with no true guard is "no guard holds".
GLOBAL {
  DEFINITIONS {
    greq(x) = req : a b;
    ghalf(x) = x > 5 : a x < 2 : b;
    gmix(x) = (req && x > 1) : a;
    gor(x) = (req || x == 0) : a b;
  }
}
MAIN {
  INPUTS { req; a; b; }
  OUTPUTS { z; }
  GUARANTEE { G(greq(0) && ghalf(3) && gmix(2) && gor(2)); }
}
EOF

cat >dexpand.tlsf <<'EOF'
// Definition expansion through an identity wrapper: guarded bodies,
// multi-clause bodies, and plain bus conjunctions all flow through the
// same substitution path.
GLOBAL {
  DEFINITIONS {
    wrap(y) = y;
    gdef(z) = z >= 1 : a;
    hdef(w) = w >= 1 : a
             w < 1   : b;
  }
}
MAIN {
  INPUTS { bus[2]; a; b; }
  OUTPUTS { z; }
  GUARANTEE {
    G(wrap(gdef(2)));
    G(wrap(hdef(1)));
    G(wrap(bus[0]) && wrap(bus[1]));
  }
}
EOF

cat >folded.tlsf <<'EOF'
// A constant actual passed to a macro is folded to a literal before
// substitution; a not-yet-known name inside a macro actual is left for
// the outer expansion to diagnose.
GLOBAL {
  DEFINITIONS {
    wrap2(y) = y;
  }
}
MAIN {
  INPUTS { bus[3]; }
  OUTPUTS { z; }
  GUARANTEE {
    G(wrap2(2) && wrap2(bus[0]));
    G(wrap2(MAX(bus[0], 1)));
    G(wrap2(nope(1)));
  }
}
EOF

cat >aritynest.tlsf <<'EOF'
// An inner macro call with the wrong number of actuals is passed
// through expansion unchanged and diagnosed by the outer App case.
GLOBAL {
  DEFINITIONS {
    wrap2(y) = y;
    unit(x) = G x;
  }
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G(wrap2(unit(1, 2))); }
}
EOF

cat >badguard.tlsf <<'EOF'
// An identifier in a clause guard must be declared.  A guard is
// evaluated at translation time, so a name that resolves to nothing can
// never hold; the translator says exactly that, but only for the
// clauses its scan reaches.  A misspelt `otherwise` is therefore
// invisible, because the intended catch-all is usually the last clause
// of a body -- and the specification still translates, to the value of
// whichever earlier clause did match.  syfco rejects the name while
// binding identifiers, before any clause is selected.
//
// The first file below is the reported case: the first clause matches,
// so the misspelt second clause is never evaluated, yet the name must
// still be resolved.
INFO
{
  TITLE:       "bad guard"
  DESCRIPTION: "a misspelt otherwise"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL
{
  DEFINITIONS { fun(f) = f ~ a U _: a othrewise: X f }
}
MAIN
{
  INPUTS { x; }
  OUTPUTS { y; }
  GUARANTEES { fun(x U y); }
}
EOF

cat >badguard2.tlsf <<'EOF'
// A definition that is never called is checked as well, since the
// resolution does not depend on any call.
INFO
{
  TITLE:       "bad guard"
  DESCRIPTION: "in a definition that is never called"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL
{
  DEFINITIONS { unused(x) = othrewise : a; }
}
MAIN
{
  INPUTS { x; }
  OUTPUTS { y; }
  GUARANTEES { G(x); }
}
EOF

cat >quantguard.tlsf <<'EOF'
// A variable a quantifier inside the guard binds is not an undeclared
// name, so this file is diagnosed by the translator, for the unrelated
// reason that it cannot evaluate such a guard statically -- and not by
// the name resolution above.
INFO
{
  TITLE:       "quantifier guard"
  DESCRIPTION: "a guard with a bound variable"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL
{
  DEFINITIONS { quant(x) = (&&[0 <= i < 2] i == 1) : a otherwise : b; }
}
MAIN
{
  INPUTS { x; }
  OUTPUTS { o; }
  GUARANTEE { G(o <-> quant(1)); }
}
EOF

cat >goodguard.tlsf <<'EOF'
// What a guard is allowed to name, on the other hand: `otherwise`, the
// Boolean literals, the formals of the definition, a parameter, a
// definition, a signal, an enumeration name or tag, and a variable
// bound by a quantifier inside the guard.  A name in a clause VALUE is
// not restricted, and keeps becoming a fresh atomic proposition.
INFO
{
  TITLE:       "good guards"
  DESCRIPTION: "everything a guard may name"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    enum E = T0:0 T1:1;
    lit(x) = true : a otherwise : b;
    fal(x) = false : a otherwise : b;
    par(x) = n : a otherwise : b;
    cmp(x) = (x == n) : a otherwise : b;
    mem(x) = (x IN {0, 1}) : a otherwise : b;
    two(x, y) = (x == y) : a otherwise : b;
    // An undeclared name in a value is a fresh AP, as always.
    fresh(x) = (x == 0) : nosuchvalue;
  }
}
MAIN {
  INPUTS { x; y; E s; }
  OUTPUTS { o; }
  GUARANTEE {
    G(o <-> (lit(x) && fal(x) && par(x) && cmp(1) && mem(1)
             && two(1, 1) && fresh(0)));
  }
}
EOF

cat >pattern.tlsf <<'EOF'
// Pattern matching (TLSF v1.2 SS4.6): a clause guard `eP = phi ~ phi'`
// holds when the two expressions are structurally equivalent, and every
// identifier of the pattern binds to the subexpression it matched,
// visible only in the value on the right of the `:`.  The `_` wildcard
// matches anything and stays unbound.
//
// Each arm gets a pair of its OWN output signals -- one for the match,
// one for the fallthrough -- and the guarantee mentions all of them.
// Were the results shared signals instead, the whole conjunction would
// simplify to a couple of terms and a regression in any single arm
// would go unnoticed.  The bound forms come in pairs too: `pbd`/`pbdno`
// are the same pattern against a matching and a non-matching subject,
// so the bound comparison is pinned in both directions.
INFO {
  TITLE: "pattern matching"
  DESCRIPTION: "one clause per connective"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    pwild(x) = x ~ _ : ow otherwise : ow2;
    ptrue(x) = x ~ true : ot otherwise : ot2;
    pfalse(x) = x ~ false : of otherwise : of2;
    pnot(x) = x ~ !p : on otherwise : on2;
    pnext(x) = x ~ X p : ox otherwise : ox2;
    psnext(x) = x ~ X[!] p : os otherwise : os2;
    pfin(x) = x ~ F p : ofi otherwise : ofi2;
    pglob(x) = x ~ G p : og otherwise : og2;
    puntil(x) = x ~ (p U q) : ou otherwise : ou2;
    pweak(x) = x ~ (p W q) : ow2 otherwise : ow3;
    prel(x) = x ~ (p R q) : or otherwise : or2;
    pimpl(x) = x ~ (p -> q) : oi otherwise : oi2;
    pequiv(x) = x ~ (p <-> q) : oe otherwise : oe2;
    pport(x) = x ~ (p || q) : oo otherwise : oo2;
    pand(x) = x ~ (p && q) : oa otherwise : oa2;
    ptwo(x) = x ~ G (p && X q) : ot2 otherwise : ot3;
    pnested(x) = x ~ G (p || F q) : on2 otherwise : on3;
    pbnd(x) = x ~ F[1:2] p : ob otherwise : ob2;
    pbndno(x) = x ~ F[1:2] p : ob3 otherwise : ob4;
    pbnd2(x) = x ~ G[!1:2] p : obr otherwise : obr2;
    pbndparam(x) = x ~ F[n:2] p : obp otherwise : obp2;
    pstack(x) = x ~ X[2] p : ost otherwise : ost2;
    pstack2(x) = x ~ X[!2] p : oss otherwise : oss2;
    pquant(x) = x ~ &&[0 <= i < 2] p : oq otherwise : oq2;
  }
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS {
    ow; ow2; ow3;
    ot; ot2; ot3;
    of; of2;
    on; on2; on3;
    ox; ox2;
    os; os2;
    ofi; ofi2;
    og; og2;
    ou; ou2;
    or; or2;
    oi; oi2;
    oe; oe2;
    oo; oo2;
    oa; oa2;
    ob; ob2; ob3; ob4;
    obr; obr2;
    obp; obp2;
    ost; ost2;
    oss; oss2;
    oq; oq2;
    z;
  }
  GUARANTEE {
    G(pwild(a)
      && ptrue(true) && pfalse(false)
      && pnot(!a) && pnext(X a) && psnext(X[!] a) && pfin(F a)
      && pglob(G a) && puntil(a U b) && pweak(a W b) && prel(a R b)
      && pimpl(a -> b) && pequiv(a <-> b) && pport(a || b)
      && pand(a && b) && ptwo(G(a && X b)) && pnested(G(a || F b))
      && pbnd(F[1:2] a) && pbndno(F[2:2] a) && pbnd2(G[!1:2] a)
      && pbndparam(F[n:2] a) && pstack(X[2] a) && pstack2(X[!2] a)
      && pquant(&&[0 <= i < 2] a));
  }
}
EOF

cat >patmatch.tlsf <<'EOF'
// The shape of SS4.6's own example: `f ~ (a U _) : a` yields phi1 when f
// is an until formula, and the `otherwise` clause yields X f when it is
// not.  The pattern's operand is spelled m and the signals u, v here:
// spelled as the specification does, with the operand sharing its name
// with a declared signal, the pattern would be rejected for binding a
// name that is already taken (see pap in patbad.tlsf).
INFO {
  TITLE: "pattern match"
  DESCRIPTION: "until-shaped subject and otherwise fallthrough"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    fun(f) = f ~ (q U _) : q
             otherwise : X f;
  }
}
MAIN {
  INPUTS { u; v; }
  OUTPUTS { y; }
  GUARANTEE { G(y <-> (fun(u U v) && fun(G u))); }
}
EOF

cat >patorder.tlsf <<'EOF'
// A pattern that fails to match falls through to the next clause, and
// the first matching clause wins when two would match.
INFO {
  TITLE: "clause order"
  DESCRIPTION: "first match wins, otherwise is the fallthrough"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    first(x) = x ~ m : o1
                x ~ m : o2
                otherwise : o3;
    fallthru(x) = x ~ G p : o4
                 otherwise : o5;
  }
}
MAIN {
  INPUTS { a; b; c; }
  OUTPUTS { z; o1; o2; o3; o4; o5; }
  GUARANTEE { G(first(a) && fallthru(F a) && fallthru(G a)); }
}
EOF

cat >patsubj.tlsf <<'EOF'
// The subject of a pattern is the substituted, expanded expression: a
// plain macro is flattened away before the match, while the call to a
// guarded definition survives as an App node and therefore does not
// match a formula-shaped pattern.
INFO {
  TITLE: "pattern subject"
  DESCRIPTION: "macro flattening versus a guarded call"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    Mac(x) = G x;
    Guarded(x) = (x == 0) : a
                 x == 1 : b;
    P(x) = x ~ G p : p otherwise : c;
  }
}
MAIN {
  INPUTS { a; b; c; }
  OUTPUTS { z; }
  GUARANTEE { G(P(Mac(a)) && P(Guarded(0))); }
}
EOF

cat >patshape.tlsf <<'EOF'
// A pattern is rejected at parse time when its SHAPE is wrong, even in a
// definition that is never called: a metavariable bound twice, a nested
// `~`, and every connective SS4.6 does not list -- arithmetic,
// comparison, membership, a bare integer literal, and a set literal.
INFO {
  TITLE: "bad pattern shapes"
  DESCRIPTION: "connectives SS4.6 does not list in a pattern"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    pdbl(x) = x ~ (p && p) : p;
    pnested(x) = x ~ (a ~ p) : p;
    pcmp(x) = x ~ (p < 2) : p;
    parith(x) = x ~ (p + 1) : p;
    pint(x) = x ~ 3 : p;
    pset(x) = x ~ {0, 1} : p;
    pcall(x) = x ~ (p == 0) : p;
    pbus(x) = x ~ (p[0]) : p;
  }
}
MAIN {
  INPUTS { a; b[2]; }
  OUTPUTS { w; }
  GUARANTEE { G(w <-> a); }
}
EOF

cat >patstale.tlsf <<'EOF'
// A metavariable that is already bound is rejected at translate time
// instead: its freshness depends on what the definition body knows, so
// the parser cannot see it.  This is a divergence from syfco, which
// binds such a name silently; see SPEC.md SS4.6.
INFO {
  TITLE: "stale metavariables"
  DESCRIPTION: "a pattern cannot bind a name that is taken"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    enum E = T0:0 T1:1;
    pformal(x) = x ~ G x : x;
    pparam(x) = x ~ G n : n;
    pdef(x) = x ~ G pdef : pdef;
    pap(x) = x ~ G a : a;
    penum(x) = x ~ G E : E;
    ptag(x) = x ~ G T0 : T0;
  }
}
MAIN {
  INPUTS { a; b; E z; }
  OUTPUTS { w; }
  GUARANTEE { G(w <-> (pformal(a) && pparam(a) && pdef(a)
                      && pap(b) && penum(a) && ptag(a))); }
}
EOF

cat >patname.tlsf <<'EOF'
// The wildcard does not shadow a declared name: the scanner reserves
// `_` only in expression position, so a signal spelled `_` is still that
// signal when it is used, and a name that merely begins with an
// underscore is an ordinary identifier.
GLOBAL {
  DEFINITIONS {
    Wid(x) = x ~ _ : a;
  }
}
MAIN {
  INPUTS { _; a; _foo; x_1; }
  OUTPUTS { w; }
  GUARANTEE { G(w <-> (Wid(G a) && _ && _foo && x_1)); }
}
EOF

cat >intok.tlsf <<'EOF'
// A zero-argument definition used as a bus size evaluates in integer
// position: ALL of MIN/MAX/SUM/PROD, the logical-not of a literal, a
// membership, and the comparison operators are usable as sizes.
GLOBAL {
  DEFINITIONS {
    siz3() = MIN(3, 5);
    siz5() = MAX(3, 5);
    tot6() = SUM(1, 2, 3);
    prd24() = PROD(2, 3, 4);
    one() = !0;
    in3() = 2 IN {0, 1, 2};
    lt1() = 2 < 3;
    le1() = 2 <= 2;
  }
}
MAIN {
  INPUTS { sc; }
  OUTPUTS {
    o1[siz3()];
    o2[siz5()];
    o3[tot6()];
    o4[prd24()];
    o5[one()];
    o6[in3()];
    o7[lt1()];
    o8[le1()];
  }
  GUARANTEE { G (sc -> o1[0]); }
}
EOF

cat >interr.tlsf <<'EOF'
// Invalid integer positions: SIZEOF of a literal/scalar/unknown/output
// AP, a set, a Boolean And, MIN() with no argument, and a bus index.
GLOBAL {
  DEFINITIONS {
    q1() = SIZEOF 3;
    q3() = SIZEOF scalar;
    q6() = SIZEOF nope;
    q7() = SIZEOF bout;
    q4() = {0, 1};
    q5() = 1 && 1;
    q8() = MIN();
    q9() = a0[0];
  }
}
MAIN {
  INPUTS {
    a0[2];
    scalar;
    r2[q1()];
    r3[q3()];
    r4[q6()];
    r5[q7()];
    r6[q4()];
    r7[q5()];
    r8[q8()];
    r9[q9()];
  }
  OUTPUTS { bout; }
  GUARANTEE { G a0[0]; }
}
EOF

cat >defbare.tlsf <<'EOF'
// A definition that requires an argument, used bare in an integer
// position (bus index), is diagnosed.
GLOBAL {
  DEFINITIONS {
    gen(x) = x >= 1 : a;
  }
}
MAIN {
  INPUTS { a[2]; }
  OUTPUTS { z; }
  GUARANTEE { G(a[gen]); }
}
EOF

cat >cyclic.tlsf <<'EOF'
// Cyclic parameters are diagnosed (once per actor in the cycle);
// forward-referenced parameters evaluate fine; an unresolvable
// parameter used in a bus size propagates a failure.
GLOBAL {
  PARAMETERS {
    A = B + 1;
    B = A + 1;
  }
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF

