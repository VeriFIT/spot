# The expectation is the printed translation, which also exercises the
# print -> reparse -> print round-trip done internally by the tool, and
# which re-emits every strong operator in the trailing-`!` spelling.
# It is longer than 80 columns, so both sides are folded at 70 and the
# blanks at a break are stripped from both.
../parsetlsf strong.tlsf > strong.f
cat >strong.exp <<'EOF'
b_9 & (b_0 -> X[!]X[!](a | X[!]a)) & (b_1 -> X[!]X[!](a | X[!]a)) & (b
_2 -> X[!](a & X[!]a)) & (b_3 -> X[!](a & X[!]a)) & (b_4 -> X[!]X[!]a)
 & (b_5 -> X[!]X[!]a) & (b_6 -> (a | X[!](a | X[!]a))) & (b_7 -> (a &
X[!]a)) & (b_8 -> X[!]X[!]X[!]a)
EOF
fold -w 70 strong.f | sed 's/ *$//' > strong.fold
diff -u strong.exp strong.fold
# The `!` marker is glued to its bracket, as in syfco: a space between
# `[` and `!`, or between `!` and `]`, is a syntax error, while a space
# *before* the trailing `!` is fine.  Both markers at once is a syntax
# error, and so is a `[`-bound operator with a stray `!` and nothing
# else in it.
#
# `F[ !1:3] a` is the odd one out: the scanner hands the `!` back as
# the negation of the lower bound, which is how this used to be read
# (and silently translated to `F[0:3] a`).  Printing that AST emits
# `F[!1:3]`, which now reads as a strong bound and prints differently,
# so the round-trip check every conversion performs catches it and the
# file is refused.  That indirect message is why the case is listed
# here rather than among the plain syntax errors above it.
( set +x
  run 2 ../parsetlsf strong1.tlsf strong2.tlsf strong3.tlsf \
    strong4.tlsf strong5.tlsf strong6.tlsf strong7.tlsf strong8.tlsf \
    > /dev/null 2>strong.err )
cat >strong.err.exp <<'EOF'
strong1.tlsf:11.15-22: syntax error, unexpected !]
strong2.tlsf:11.15-22: syntax error, unexpected !]
strong3.tlsf:11.15-20: syntax error, unexpected !]
strong4.tlsf:11.15-21: syntax error, unexpected ;
strong5.tlsf:11.15-19: syntax error, unexpected ;
strong6.tlsf:11.15-20: syntax error, unexpected !
printer output for strong7.tlsf is not stable
strong8.tlsf:11.15-18: syntax error, unexpected ]
8 of 8 files failed
EOF
fold -w 70 strong.err | sed 's/ *$//' > strong.err.fold
