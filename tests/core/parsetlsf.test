# Truisms in LTL position (true/false, R, W, a membership turning into
# a constant) translate to a constant instead of a diagnostic.
cat >ltltru.tlsf <<'EOF'
INFO {
  TITLE: "LTL position constants"
  DESCRIPTION: "no diagnostics expected"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
}
MAIN {
  INPUTS { a; b; }
  OUTPUTS { z; }
  GUARANTEE {
    G(true);
    G(false);
    G(a R b);
    G(a W b);
    G(2 IN {0, 1, 2} -> a);
  }
}
EOF
../parsetlsf -q ltltru.tlsf

# A comparison between two integer expressions is a constant, so it
# is a valid LTL expression: SS4.3 defines an LTL expression as a
# boolean expression -- which includes eN <eN> -- plus signals and
# temporal operators.  Both operands are known at translation time, so
# the comparison folds, exactly like the `IN` membership above.  The
# definition `lte` covers a Boolean-valued body reached through
# expansion (`G lte(1, 2)`), the same way `m(2) == 2` covers an
# integer-valued one.
cat >intcmp.tlsf <<'EOF'
INFO {
  TITLE: "integer comparisons in LTL position"
  DESCRIPTION: "constant comparisons fold"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { N = 4; }
  DEFINITIONS {
    m(x) = x;
    lte(x, y) = x <= y;
  }
}
MAIN {
  INPUTS { a; bus[N]; }
  OUTPUTS { o; }
  GUARANTEE {
    G((SIZEOF bus) == 4);
    G(N >= 4);
    G(N > 5);
    G(m(2) == 2);
    G(m(2) != 2);
    G(lte(1, 2));
    G(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3);
  }
}
EOF
run 0 ../parsetlsf -e 'false' intcmp.tlsf

# A folded false is a false subterm, not a rejected one: the
# comparison simply disappears from the disjunction it guards.
cat >intcmpf.tlsf <<'EOF'
INFO {
  TITLE: "false integer comparison"
  DESCRIPTION: "folded to ff, not rejected"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS { N = 4; }
}
MAIN {
  INPUTS { a; bus[N]; }
  OUTPUTS { o; }
  GUARANTEE {
    G((SIZEOF bus) == 5 || a);
  }
}
EOF
run 0 ../parsetlsf -e 'G a' intcmpf.tlsf

# A comparison that involves a signal is still rejected, and a
# mistake inside an operand is reported before the rejection of the
# comparison containing it.  `lte(a, b)` is the same rejection reached
# through the expansion of a definition body.
cat >intcmpbad.tlsf <<'EOF'
INFO {
  TITLE: "non-constant comparisons"
  DESCRIPTION: "still rejected in LTL position"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    lte(x, y) = x <= y;
  }
}
MAIN {
  INPUTS { a; b; s; }
  OUTPUTS { o; }
  GUARANTEE {
    G(SIZEOF(s) == 1);
    G(a == b);
    G(lte(a, b));
  }
}
EOF
( set +x
  run 2 ../parsetlsf intcmpbad.tlsf > /dev/null 2>intcmpbad.err )
# One diagnostic for the signal-to-signal comparison, two for the
# SIZEOF one (its own reason, then the rejection), one for the
# definition body reached by expansion.  (The tool's "conversion
# failed" summary carries no location, so the count is of the located
# diagnostics only.)
# The reason inside the operand is reported before the comparison.
cat >intcmpbad.err.exp <<'EOF'
intcmpbad.tlsf:16.5-12: SIZEOF of scalar AP 's'
intcmpbad.tlsf:16.5-6: arithmetic/comparison op '==' is not supported
in LTL position
intcmpbad.tlsf:17.5-6: arithmetic/comparison op '==' is not supported
in LTL position
intcmpbad.tlsf:9.19-20: arithmetic/comparison op '<=' is not supported
 in LTL position
conversion of intcmpbad.tlsf failed
EOF
fold -w 70 intcmpbad.err | sed 's/ *$//' > intcmpbad.err.fold
diff -u intcmpbad.err.exp intcmpbad.err.fold

# Membership over set algebra: CUP / CAP / SETMINUS in the right-hand
# side of a membership bound evaluate to an integer set.  These are the
# infix spellings: the `CUP[`/`CAP[`/`SETMINUS[` bracket forms are big
# operators taking a binder list (see the bigop tests below).
cat >sets.tlsf <<'EOF'
INFO {
  TITLE: "set algebra membership"
  DESCRIPTION: "CUP/CAP/SETMINUS quantifier bounds"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {}
MAIN {
  INPUTS { a[5]; }
  OUTPUTS { z; }
  GUARANTEE {
    &&[i IN {0} CUP {3}] a[i];
    &&[i IN {0, 2} CAP {2, 4}] a[i];
    &&[i IN {0, 2, 4} SETMINUS {2}] a[i];
  }
}
EOF
../parsetlsf sets.tlsf > sets.f
# The three bounds are {0,3}, {2}, and {0,4}, so the conjunction of the
# unfolded quantifiers covers a_0, a_2, a_3, and a_4.
cat >sets.f.exp <<'EOF'
a_0 & a_2 & a_3 & a_4
EOF
diff -u sets.f.exp sets.f

# Set cardinality `|eSX|` and its `SIZE eSX` spelling, plus the
# prefix extrema `MIN eSX` / `MAX eSX`.  All four are integer-valued
# and fold at translation time.
cat >setsize.tlsf <<'EOF'
INFO {
  TITLE: "set cardinality and extrema"
  DESCRIPTION: "|eSX|, SIZE eSX, MIN eSX and MAX eSX"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a[5]; }
  OUTPUTS { z; }
  GUARANTEE {
    |{1, 2, 3}| == 3;
    SIZE {1, 2, 3} == 3;
    |{1, 2, 3}| == SIZE {1, 2, 3};
    |{}| == 0;
    MIN {3, 1, 2} == 1;
    MAX {3, 1, 2} == 3;
    MIN {7} == 7;
    MAX {7} == 7;
    MIN {1, 2, 3} == MIN(1, 2, 3);
    MAX {1, 2, 3} == MAX(1, 2, 3);
  }
}
EOF
../parsetlsf setsize.tlsf > setsize.f
cat >setsize.f.exp <<'EOF'
1
EOF
diff -u setsize.f.exp setsize.f

# `SIZE` is a canonicalisation alias: both spellings fold to the same
# operator, so the deparser emits the `|` form for either.  The
# canonical print itself is checked through the Python binding, which
# exposes the deparser; here we only pin that the file parses and
# translates.
cat >sizealias.tlsf <<'EOF'
INFO {
  TITLE: "SIZE is an alias for the bars"
  DESCRIPTION: "SIZE eSX prints as |eSX|"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a[5]; }
  OUTPUTS { z; }
  GUARANTEE { SIZE {1, 2, 3} == 3; }
}
EOF
../parsetlsf sizealias.tlsf > sizealias.out
cat >sizealias.out.exp <<'EOF'
1
EOF
diff -u sizealias.out.exp sizealias.out

# The extrema of an empty set have no value, and the cardinality of a
# non-set has no meaning: both are diagnosed where they happen.
cat >badsetop.tlsf <<'EOF'
INFO {
  TITLE: "ill-typed set operators"
  DESCRIPTION: "MIN/MAX of an empty set, SIZE of an AP"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a[5]; }
  OUTPUTS { z; }
  GUARANTEE {
    MIN {} == 1;
    MAX {} == 1;
    SIZE a == 3;
  }
}
EOF
run 2 ../parsetlsf badsetop.tlsf > badsetop.err 2>&1
grep -q "MIN of an empty set has no value" badsetop.err
grep -q "MAX of an empty set has no value" badsetop.err
grep -q "expected an integer set" badsetop.err
# An integer-valued operator has no LTL counterpart, so using one as a
# subterm is diagnosed too.  (A comparison whose two sides both fold,
# like `|{1, 2}| == 2`, is not such a case: the comparison itself is a
# constant and collapses before its operands are ever inspected.)
cat >setsizeltl.tlsf <<'EOF'
INFO {
  TITLE: "set cardinality in LTL position"
  DESCRIPTION: "|eSX| is not a Boolean operator"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G |{1, 2}|; }
}
EOF
run 2 ../parsetlsf setsizeltl.tlsf > setsizeltl.err 2>&1
grep -q "operator '|' is not supported in LTL position" setsizeltl.err

# The same for the prefix extrema.
sed 's/G |{1, 2}|;/MIN {1, 2} \&\& a;/' setsizeltl.tlsf > setminltl.tlsf
run 2 ../parsetlsf setminltl.tlsf > setminltl.err 2>&1
grep -q "operator 'MIN' is not supported in LTL position" setminltl.err

# A big operator accepts a comma-separated binder list, which is
# shorthand for nested single-binder quantifiers: `&&[i, j] phi` means
# `&&[i] &&[j] phi`, with the outermost binder listed first.  All six
# heads take a list.  Each case gets its own file because the tool
# conjoins the GUARANTEE section of a file into one formula.
oneguards() {
  cat > "$1" <<EOF
INFO {
  TITLE: "a minimal spec with one GUARANTEE"
  DESCRIPTION: "used by the multiple-binder tests"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    N = 1;
    M = 1;
  }
}
MAIN {
  INPUTS { a[4]; b[2]; }
  OUTPUTS { z; }
  GUARANTEE { $2; }
}
EOF
}
oneguards mb1.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb2.tlsf  '&&[i IN {0, 1}] &&[j IN {0, 1}] a[i + j]'
oneguards mb3.tlsf  '||[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb4.tlsf  'OR[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb5.tlsf  'EXISTS[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb6.tlsf  'FORALL[i IN {0, 1}, j IN {0, 1}] a[i + j]'
oneguards mb7.tlsf  '&&[0 <= i < 2, 0 <= j < 2] a[i + j]'
oneguards mb8.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] ||[k IN {0, 1}] a[i + j]'
oneguards mb9.tlsf  '&&[i IN {0, 1}, j IN {0, 1}] a[i] && b[0]'
oneguards mb10.tlsf 'AND[i IN {0, 1}, j IN {0, 1}, k IN {0, 1}] a[i + j + k]'
# mb1 and mb2 are the same formula written two ways; the AND-folding
# heads share one translation and the OR-folding heads share the dual.
# mb7 mixes a range bound with a list, mb8 chains two heads.
run 0 ../parsetlsf mb1.tlsf mb2.tlsf mb3.tlsf mb4.tlsf mb5.tlsf mb6.tlsf \
            mb7.tlsf mb8.tlsf mb9.tlsf mb10.tlsf > multibind.out
cat >multibind.out.exp <<'EOF'
=== mb1.tlsf ===
a_0 & a_1 & a_2
=== mb2.tlsf ===
a_0 & a_1 & a_2
=== mb3.tlsf ===
a_0 | a_1 | a_2
=== mb4.tlsf ===
a_0 | a_1 | a_2
=== mb5.tlsf ===
a_0 | a_1 | a_2
=== mb6.tlsf ===
a_0 & a_1 & a_2
=== mb7.tlsf ===
a_0 & a_1 & a_2
=== mb8.tlsf ===
a_0 & a_1 & a_2
=== mb9.tlsf ===
a_0 & a_1 & b_0
=== mb10.tlsf ===
a_0 & a_1 & a_2 & a_3
EOF
diff -u multibind.out.exp multibind.out

# A binder list is not an argument list: it may not end with a comma.
# `X[n] phi` is a next-stack length rather than a binder, so its
# bracket takes no list either.
oneguards mberr1.tlsf '&&[i IN {0, 1},] a[0]'
oneguards mberr2.tlsf 'X[N, N] a[0]'
oneguards mberr3.tlsf 'F[1:2, 3:4] a[0]'
run 2 ../parsetlsf mberr1.tlsf mberr2.tlsf mberr3.tlsf > multibad.err 2>&1
grep -q 'mberr1.tlsf:16.27-30: syntax error, unexpected \]' multibad.err
grep -q 'mberr2.tlsf:16.15-18: syntax error, unexpected ","' multibad.err
grep -q 'mberr3.tlsf:16.15-20: syntax error, unexpected ","' multibad.err

# A bounded temporal operator in the body of a quantifier is not
# another binder: `X[i]`, `F[i:j]` and `G[i:j]` are Quantifier nodes of
# their own, carrying their two bounds and their body.  The binder run
# stops at them, so the loop variable stays bound and remains readable
# in the temporal bounds.
oneguards bnd1.tlsf '&&[0 <= i < 2] X[i] a[0]'
oneguards bnd2.tlsf '&&[0 <= i < 2] F[i:1] a[0]'
oneguards bnd3.tlsf '||[i IN {0, 1}, j IN {0, 1}] X[i + j] a[0]'
oneguards bnd4.tlsf '||[i IN {0, 1}] &&[j IN {0, 1}] G[j:1] a[0]'
run 0 ../parsetlsf bnd1.tlsf bnd2.tlsf bnd3.tlsf bnd4.tlsf > boundbody.out
cat >boundbody.out.exp <<'EOF'
=== bnd1.tlsf ===
a_0 & Xa_0
=== bnd2.tlsf ===
Xa_0 & (a_0 | Xa_0)
=== bnd3.tlsf ===
a_0 | Xa_0 | XXa_0
=== bnd4.tlsf ===
Xa_0 | (a_0 & Xa_0)
EOF
diff -u boundbody.out.exp boundbody.out

# `X[n] X[m] phi` is a stack of two nexts, not one head with two
# binders.  The tool reprints and reparses every spec it converts, so
# converting this file already pins the two-head canonical spelling.
oneguards xstack.tlsf 'X[N] X[M] a[0]'
run 0 ../parsetlsf xstack.tlsf > xstack.out
cat >xstack.out.exp <<'EOF'
XXa_0
EOF
diff -u xstack.out.exp xstack.out

# Big operators: a prefix head, a binder list, and a body folded over
# every combination the list ranges over.  N is 3 and M is 2.
bigop() {
  cat > "$1" <<EOF
INFO {
  TITLE: "a minimal spec with one GUARANTEE"
  DESCRIPTION: "used by the big-operator tests"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    N = 3;
    M = 2;
  }
}
MAIN {
  INPUTS { a[4]; }
  OUTPUTS { z; }
  GUARANTEE { $2; }
}
EOF
}
# The numeric heads, spelled both ways: `SUM[`/`PROD[` and the `+[`/
# `*[` forms.  bo1 and bo3 are the same formula.
bigop bo1.tlsf  'SUM[i IN {0..N-1}] i == 3'
bigop bo2.tlsf  'PROD[i IN {0..N-1}] (i + 1) == 6'
bigop bo3.tlsf  '+[i IN {0..N-1}] i == 3'
bigop bo4.tlsf  '*[i IN {0..N-1}] (i + 1) == 6'
# bo5 uses a comparison-chain bound rather than a membership one, and
# bo6 nests two binders whose inner bound names the outer variable.
bigop bo5.tlsf  'SUM[0 <= i < N] i == 3'
bigop bo6.tlsf  'SUM[i IN {0, 1}, j IN {0..i}] j == 1'
# The set heads, again under both spellings.  bo7 unions six distinct
# values, bo8 intersects down to two, bo9 differs left to right down to
# none.
bigop bo7.tlsf  '|CUP[i IN {0..N-1}] {i, i + N}| == 6'
bigop bo8.tlsf  '|CAP[i IN {0..N-1}] {0, 1, i}| == 2'
bigop bo9.tlsf  '|SETMINUS[i IN {0..N-1}] {0, 1, i}| == 0'
bigop bo10.tlsf '|(+)[i IN {0..N-1}] {i, i + N}| == 6'
bigop bo11.tlsf '|(*)[i IN {0..N-1}] {0, 1, i}| == 2'
bigop bo12.tlsf '|(-)[i IN {0..N-1}] {0, 1, i}| == 0'
# An empty binder domain folds to the operation's identity: 0 for a
# sum and a union, 1 for a product.
bigop bo13.tlsf 'SUM[i IN {1..0}] i == 0'
bigop bo14.tlsf 'PROD[i IN {1..0}] i == 1'
bigop bo15.tlsf '|CUP[i IN {1..0}] {i}| == 0'
# The big operators expand the same binder runs as the Boolean heads, so
# they stop at a bounded temporal operator in the body as well.
bigop bnd5.tlsf 'SUM[i IN {0, 1}] (i + 1) == 5'
bigop bnd6.tlsf '|CUP[i IN {0, 1}, j IN {0, 1}] {i, j}| == 2'
run 0 ../parsetlsf bnd5.tlsf bnd6.tlsf > boundbody2.out
cat >boundbody2.out.exp <<'EOF'
=== bnd5.tlsf ===
0
=== bnd6.tlsf ===
1
EOF
diff -u boundbody2.out.exp boundbody2.out
run 0 ../parsetlsf bo1.tlsf bo2.tlsf bo3.tlsf bo4.tlsf bo5.tlsf bo6.tlsf \
            bo7.tlsf bo8.tlsf bo9.tlsf bo10.tlsf bo11.tlsf bo12.tlsf \
            bo13.tlsf bo14.tlsf bo15.tlsf > bigop.out
cat >bigop.out.exp <<'EOF'
=== bo1.tlsf ===
1
=== bo2.tlsf ===
1
=== bo3.tlsf ===
1
=== bo4.tlsf ===
1
=== bo5.tlsf ===
1
=== bo6.tlsf ===
1
=== bo7.tlsf ===
1
=== bo8.tlsf ===
1
=== bo9.tlsf ===
1
=== bo10.tlsf ===
1
=== bo11.tlsf ===
1
=== bo12.tlsf ===
1
=== bo13.tlsf ===
1
=== bo14.tlsf ===
1
=== bo15.tlsf ===
1
EOF
diff -u bigop.out.exp bigop.out

# The intersection and the difference have no representable identity
# element -- the first is the universal set, the second the first
# operand -- so an empty binder domain is diagnosed for them, as is a
# big operator in LTL position and a bound with no iteration variable.
# Each of the first, second, and fourth guards is guarded by a
# comparison so that it is evaluated rather than reported as sitting in
# LTL position; each file's first diagnostic is the one pinned below.
bigop boerr1.tlsf '|CAP[i IN {1..0}] {i}| == 0'
bigop boerr2.tlsf '|SETMINUS[i IN {1..0}] {i}| == 0'
bigop boerr3.tlsf 'SUM[i IN {0..N-1}] a[i]'
bigop boerr4.tlsf 'SUM[N] i == 0'
bigop boerr5.tlsf 'CUP[i IN {0, 1}] a[i]'
run 2 ../parsetlsf boerr1.tlsf boerr2.tlsf boerr3.tlsf boerr4.tlsf \
             boerr5.tlsf > bigopbad.err 2>&1
grep -q "boerr1.tlsf:16.15-18: intersection over an empty binder domain" \
     bigopbad.err
grep -q "boerr2.tlsf:16.15-23: difference over an empty binder domain" \
     bigopbad.err
grep -q "boerr3.tlsf:16.15-17: operator 'SUM\[' is not supported in LTL" \
     bigopbad.err
grep -q "boerr4.tlsf:16.15-19: invalid binder; a binder must have the" \
     bigopbad.err
grep -q "boerr5.tlsf:16.15-17: operator 'CUP\[' is not supported in LTL" \
     bigopbad.err

# Unknown bus references and non-positive-sized buses are diagnosed.
cat >busbad.tlsf <<'EOF'
INFO {
  TITLE: "bad buses"
  DESCRIPTION: "undeclared bus and zero-sized bus"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { zero[0]; }
  OUTPUTS { z; }
  GUARANTEE {
    G none_bus[0];
    G z && zero[0];
  }
}
EOF
# Enum comparisons: a wildcard pattern (don't-care `*`) in a compared
# tag skips its bit, and a typed bus on the RHS of `==` is accepted.
cat >enumcmp.tlsf <<'EOF'
INFO {
  TITLE: "enum comparisons"
  DESCRIPTION: "wildcards and swapped operands"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    enum hburst =
      SINGLE: 01
      INCR:   00
      BURST4: 10;
    enum cover = COV: 11*, 1*1, *11;
  }
}
MAIN {
  INPUTS {
    hburst HBURST;
    cover CB;
  }
  OUTPUTS { z; }
  GUARANTEE {
    G((HBURST != SINGLE) || z);
    G(CB == COV);
  }
}
EOF
../parsetlsf enumcmp.tlsf > enumcmp.f
# A wildcard pattern skips its bit, so the COV tag leaves CB_1 free and
# the folded comparison is the whole formula compared below.
cat >enumcmp.f.exp <<'EOF'
G(((CB_0 & CB_1) | (CB_0 & CB_2) | (CB_1 & CB_2)) & (!HBURST_0 | !HBUR
ST_1)) -> (G(z | !(!HBURST_0 & HBURST_1)) & G((CB_0 & CB_1) | (CB_0 &
CB_2) | (CB_1 & CB_2)))
EOF
fold -w 70 enumcmp.f | sed 's/ *$//' > enumcmp.f.fold
diff -u enumcmp.f.exp enumcmp.f.fold

# A tag that no enum value names is diagnosed; so is a swapped
# `tag == bus` (the tag is read from the second operand).
cat >enumtaggerr.tlsf <<'EOF'
INFO {
  TITLE: "enum tag errors"
  DESCRIPTION: "unknown tag and swapped operands"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    enum hburst =
      SINGLE: 01
      INCR:   00
      BURST4: 10;
  }
}
MAIN {
  INPUTS {
    hburst HBURST;
  }
  OUTPUTS { z; }
  GUARANTEE {
    G(HBURST == NOPE);
    G(INCR == HBURST);
  }
}
EOF
( set +x
  run 2 ../parsetlsf busbad.tlsf enumtaggerr.tlsf > /dev/null 2>bus.err )
# busbad: an undeclared bus reference and a zero-sized bus.
# enumtaggerr: an unknown tag and a swapped `tag == bus`.
cat >bus.err.exp <<'EOF'
busbad.tlsf:11.7-14: indexed reference uses undeclared bus 'none_bus'
busbad.tlsf:12.12-15: bus 'zero' has non-positive size
conversion of busbad.tlsf failed
enumtaggerr.tlsf:21.5-6: enum 'hburst' has no value named 'NOPE'
enumtaggerr.tlsf:22.5-6: enum 'hburst' has no value named 'HBURST'
conversion of enumtaggerr.tlsf failed
2 of 2 files failed
EOF
fold -w 70 bus.err | sed 's/ *$//' > bus.err.fold
diff -u bus.err.exp bus.err.fold

# A wide (21-bit) enum typed bus is skipped by the missing-valuation
# constraint generator, not miscompiled.
cat >wideenum.tlsf <<'EOF'
INFO {
  TITLE: "wide enum"
  DESCRIPTION: "21-bit enum typed bus"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    enum wide = X: 111111111111111111111;
  }
}
MAIN {
  INPUTS {
    wide WB;
  }
  OUTPUTS { z; }
  GUARANTEE { G z; }
}
EOF
../parsetlsf -q wideenum.tlsf

# A constant actual nested inside another macro's actual is folded to
# a literal during eager expansion (before substitution).
cat >nestedfold.tlsf <<'EOF'
INFO {
  TITLE: "nested constant actual"
  DESCRIPTION: "fold inside expand_ast"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    wrap2(y) = y;
    inner(x) = a[x];
  }
}
MAIN {
  INPUTS { a[3]; }
  OUTPUTS { z; }
  GUARANTEE { G(wrap2(inner(2)) && a); }
}
EOF
../parsetlsf nestedfold.tlsf > nestedfold.f
cat >nestedfold.f.exp <<'EOF'
G(a & a_2)
EOF
diff -u nestedfold.f.exp nestedfold.f

# A quantifier is not an integer expression even when a definition
# shoves it into a bus size.
cat >qint.tlsf <<'EOF'
INFO {
  TITLE: "quantifier in integer position"
  DESCRIPTION: "quantifier as a bus size"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    qn() = &&[0 <= i < 1] 1;
  }
}
MAIN {
  INPUTS {
    a[qn()];
  }
  OUTPUTS { z; }
  GUARANTEE { G z; }
}
EOF
# A set-literal quantifier bound introduces no iteration variable, which
# TLSF v1.2 does not allow: the parser rejects it, so the file never
# reaches the substitution pass or the translator.
cat >varset.tlsf <<'EOF'
INFO {
  TITLE: "set-literal quantifier bound"
  DESCRIPTION: "substitution and translation of a set-bound quantifier"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  DEFINITIONS {
    pick(x) = &&[{0, 1}] x[0];
  }
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { pick(1); }
}
EOF
# A set-imaging operator in an LTL subterm reaches the binary-op
# switch as an unsupported operator: the grammar admits sets in any
# expression, so `CUP` surfaces the generic "unknown binary op"
# diagnostic.
cat >setltl.tlsf <<'EOF'
INFO {
  TITLE: "set operator in LTL position"
  DESCRIPTION: "CUP in an LTL subterm is not a Boolean operator"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G({0} CUP {1}); }
}
EOF
# A set literal used as a quantifier bound whose element is not
# evaluable as an integer: eval_set propagates the eval_int failure.
cat >badsetelem.tlsf <<'EOF'
INFO {
  TITLE: "set bound with a non-integer element"
  DESCRIPTION: "a set element that cannot be evaluated as an integer"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { &&[i IN {0, 1/0}] a; }
}
EOF
( set +x
  run 2 ../parsetlsf qint.tlsf varset.tlsf setltl.tlsf badsetelem.tlsf \
    > /dev/null 2>set.err )
# qint: a quantifier is not an integer expression.
# varset: a set-literal quantifier bound has no iteration variable.  It is
# a parse error, so it is reported on its own: the tool stops before
# translating, and there is no "conversion failed" line for it.
# setltl: a set operator in LTL position.
# badsetelem: a set element that cannot be evaluated as an integer.
cat >set.err.exp <<'EOF'
qint.tlsf:9.12-13: quantifier is not an integer expression
conversion of qint.tlsf failed
varset.tlsf:9.15-18: invalid binder; a binder must have the form `id I
N set` or `lo <= id < hi`
setltl.tlsf:10.15-16: unknown binary op
conversion of setltl.tlsf failed
badsetelem.tlsf:10.27-28: division by zero
conversion of badsetelem.tlsf failed
4 of 4 files failed
EOF
fold -w 70 set.err | sed 's/ *$//' > set.err.fold
diff -u set.err.exp set.err.fold

# TLSF v1.2 SS4.7-4.8 gives a binder one of two shapes: `id IN set` and
# the range `lo <= id < hi`.  Every head rejects anything else while
# parsing, so a variable-less bound, a count bound, and a chain spelled
# with a relational operator outside `<`/`<=` are all syntax errors.  Each
# head is listed so that a head added without the check, or without the
# recovery rule, shows up here.
for head in '&&' '||' 'AND' 'OR' 'FORALL' 'EXISTS' 'CUP' 'CAP' \
            'SETMINUS' '(+)' '(*)' '(-)' 'SUM' '+' 'PROD' '*'; do
  for bound in '{0, 2, 4}' '3' '{}' 'i > 0' 'i == 3' 'i >= 3'; do
    cat >badbind.tlsf <<EOF
INFO {
  TITLE: "an invalid binder"
  DESCRIPTION: "$head[$bound] has no iteration variable"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { $head[$bound] a; }
}
EOF
    run 2 ../parsetlsf badbind.tlsf > /dev/null 2>badbind.err
    grep -q 'invalid binder; a binder must have the form' badbind.err \
      || { echo "no binder diagnostic for $head[$bound]"; exit 1; }
  done
  # A binder list that does not parse at all is reported by the head's
  # recovery rule instead, one diagnostic per malformed list.
  cat >badbind.tlsf <<EOF
INFO {
  TITLE: "a malformed binder list"
  DESCRIPTION: "$head[0..2] does not parse"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { $head[0..2] a; }
}
EOF
  run 2 ../parsetlsf badbind.tlsf > /dev/null 2>badbind.err
  grep -q 'malformed binder list' badbind.err \
    || { echo "no recovery diagnostic for $head[0..2]"; exit 1; }
done

# Only the shape is checked while parsing.  A well shaped bound whose ends
# are not integers is a translation diagnostic, so a set literal in a
# range still reaches eval_int.
cat >badbind2.tlsf <<'EOF'
INFO {
  TITLE: "a range whose end is not an integer"
  DESCRIPTION: "the binder shape is valid, its bounds are not"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { &&[{0} <= i < 3] a; }
}
EOF
run 2 ../parsetlsf badbind2.tlsf > /dev/null 2>badbind2.err
grep -q 'set is not an integer expression' badbind2.err
grep -q 'conversion of badbind2.tlsf failed' badbind2.err

# Non-Mealy semantics are parsed, printed (the printer uses
# format_semantics to normalize them), and translated like any other.
for S in Moore "Moore,Strict" "Moore,Finite"; do
  cat >"$S spec.tlsf" <<EOF
INFO {
  TITLE: "$S semantics"
  DESCRIPTION: "parse/print/translate with the $S semantics"
  SEMANTICS:   $S
  TARGET:      Moore
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF
  ../parsetlsf "$S spec.tlsf"
done

# The keyword forms of the arithmetic operators (PLUS, MINUS, MUL,
# DIV, MOD, and the literal PERCENT token) are accepted in any
# integer expression, here a parameter.
cat >kwops.tlsf <<'EOF'
INFO {
  TITLE: "keyword arithmetic operators"
  DESCRIPTION: "PLUS MINUS MUL DIV MOD and % in a parameter"
  SEMANTICS: Mealy
  TARGET: Mealy
}
GLOBAL {
  PARAMETERS {
    N = 8 % 2 PLUS 1 MUL 2 MINUS 1 DIV 1 % 5;
  }
  DEFINITIONS {
  }
}
MAIN {
  INPUTS { a[N]; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF
../parsetlsf kwops.tlsf > kwops.out
cat >kwops.out.exp <<'EOF'
Ga
EOF
diff -u kwops.out.exp kwops.out

# The ELEM keyword is a synonym for IN in quantifier bounds.
cat >elem.tlsf <<'EOF'
INFO {
  TITLE: "ELEM keyword bound"
  DESCRIPTION: "translation of a bound using the ELEM keyword"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { &&[i ELEM {0, 1}] a; }
}
EOF
../parsetlsf elem.tlsf > elem.out
cat >elem.out.exp <<'EOF'
a
EOF
diff -u elem.out.exp elem.out

# An empty set literal is allowed in a bound; the quantifier then
# ranges over no value at all and the conjunction collapses to tt.
cat >emptyset.tlsf <<'EOF'
INFO {
  TITLE: "empty set bound"
  DESCRIPTION: "an IN bound over the empty set"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { &&[i IN {}] a; }
}
EOF
../parsetlsf emptyset.tlsf > emptyset.out
# The quantifier ranges over no value, so the conjunction is tt.
cat >emptyset.out.exp <<'EOF'
1
EOF
diff -u emptyset.out.exp emptyset.out

# A big operator head takes a binder list, which cannot be empty: the
# `CUP[]`-style empty list that the former n-ary set-operator forms
# accepted is gone, so a bare head is a syntax error, reported by the
# head's own recovery rule like any other malformed binder list.
cat >cupset.tlsf <<'EOF'
INFO {
  TITLE: "bare big-operator head"
  DESCRIPTION: "CUP[] without a binder list"
  SEMANTICS: Mealy
  TARGET: Mealy
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { &&[i IN CUP[]] a; }
}
EOF
run 2 ../parsetlsf cupset.tlsf > /dev/null 2>cupset.err
grep -q 'syntax error, unexpected ]' cupset.err
grep -q 'cupset.tlsf:10.23-25: malformed binder list' cupset.err

# Parsing a nonexistent file reports "cannot open file" (optionally
# raised as an exception) and leaves a null AST for tlsf_to_ltl.
run 2 ../parsetlsf --tl-empty nosuch.tlsf > tl.empty.err 2>&1
grep -q "tlsf_to_ltl: empty AST" tl.empty.err

# An unknown section is a parse-time error; with -R the parser
# raises instead of collecting it.
cat >parsefail.tlsf <<'EOF'
INFO {
  TITLE: "parse failure"
  DESCRIPTION: "an unknown section is a syntax error"
  SEMANTICS: Mealy
  TARGET: Mealy
}
FROB {
}
EOF
( set +x
  run 2 ../parsetlsf nosuch.tlsf parsefail.tlsf > /dev/null 2>parse.err )
# nosuch: a nonexistent file.
# parsefail: an unknown section.
# The same two failures, with -R so that the parser raises instead of
# collecting the diagnostic.
cat >parse.err.exp <<'EOF'
nosuch.tlsf:1.1: cannot open file: nosuch.tlsf
parsefail.tlsf:7.1-4: syntax error, unexpected identifier, expecting e
nd of file or INFO or MAIN or GLOBAL
2 of 2 files failed
EOF
fold -w 70 parse.err | sed 's/ *$//' > parse.err.fold
diff -u parse.err.exp parse.err.fold
( set +x
  run 2 ../parsetlsf -R nosuch.tlsf -R parsefail.tlsf > /dev/null 2>parseR.err )
grep -q "caught: " parseR.err
grep -q "cannot open file: nosuch.tlsf" parseR.err
grep -q "syntax error" parseR.err

# The fd-based parse_tlsf entry point follows the same behavior; it
# is exercised on a valid spec, on an unreadable descriptor, and on
# a spec that fails to parse.
run 0 ../parsetlsf --from-fd -1 small.tlsf > fromfd.out
grep -q "G(request_0" fromfd.out
# On GNU libc, running --from-fd 999 will fail with EBADF returned by
# fdopen(999, "r").  But fdopen is not required by POSIX to check that
# a file descriptor exist (it "may fail", not "shall fail").  On
# Alpine Linux with Musl, fdopen will ignore the fact that the file
# descriptor does not exist, and will later fail when the scanner
# attempts fread().
run 2 ../parsetlsf --from-fd 999 -R x.tlsf > fromfdR.err 2>&1
grep -Eq 'cannot open descriptor|input in flex scanner failed' fromfdR.err
run 2 ../parsetlsf --from-fd -1 -R parsefail.tlsf > fromfde.err 2>&1
grep -q "caught: " fromfde.err
grep -q "syntax error" fromfde.err

# TLSF v1.2 SS1.2/SS1.3/SS1.4: the cross-section validations that
# cannot be decided by the grammar alone.  This tool leaves the
# mandatory INFO items alone by default (--check-info asks for them),
# because most fixtures above only spell out the INFO items they are
# about.

# One symbol, one definition: a name declared in two of PARAMETERS,
# DEFINITIONS, the enumerations, INPUTS, and OUTPUTS is reported on
# both declarations.
cat >clash.tlsf <<'EOF'
INFO {
  TITLE:       "clash"
  DESCRIPTION: "a parameter redefined by a definition"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { p = 1; }
  DEFINITIONS {
    p = 2;
  }
}
MAIN {
  INPUTS  { q; }
  OUTPUTS { o; }
  GUARANTEE { G(q); }
}
EOF
# The diagnostic points at the declaration written first, whichever
# declaration space each of the two belongs to.
cat >clash2.tlsf <<'EOF'
INFO {
  TITLE:       "clash2"
  DESCRIPTION: "a signal in both INPUTS and OUTPUTS"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { sig; }
  OUTPUTS { sig; }
  GUARANTEE { G(sig); }
}
EOF
# An enumeration and a definition of the same name collide too, and
# the enumeration is reported as the later one only when it is
# written after the definition.
cat >clash3.tlsf <<'EOF'
INFO {
  TITLE:       "clash3"
  DESCRIPTION: "an enumeration shadowing a definition"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    e = 2;
    enum e = E: 0*;
  }
}
MAIN {
  INPUTS  { q; }
  OUTPUTS { o; }
  GUARANTEE { G(q); }
}
EOF
( set +x
  run 2 ../parsetlsf clash.tlsf clash2.tlsf clash3.tlsf \
    > /dev/null 2>clash.err )
# clash: a parameter redefined by a definition.
# clash2: a signal in both INPUTS and OUTPUTS.
# clash3: an enumeration shadowing a definition.
cat >clash.err.exp <<'EOF'
clash.tlsf:8.16: 'p' is shadowed by a later declaration as a definitio
n
clash.tlsf:10.5: 'p' is already declared as a parameter
clash2.tlsf:10.13-15: 'sig' is shadowed by a later declaration as an o
utput signal
clash2.tlsf:11.13-15: 'sig' is already declared as an input signal
clash3.tlsf:9.5: 'e' is shadowed by a later declaration as an enumerat
ion
clash3.tlsf:10.5-18: 'e' is already declared as a definition
3 of 3 files failed
EOF
fold -w 70 clash.err | sed 's/ *$//' > clash.err.fold
diff -u clash.err.exp clash.err.fold

# The four mandatory INFO items are required under --check-info, and
# each missing one is named once, at the INFO section.
cat >noinfo.tlsf <<'EOF'
INFO {
  TITLE: "no info"
}
GLOBAL {
  PARAMETERS { N = 2; }
}
MAIN {
  INPUTS  { a[N]; }
  OUTPUTS { b[N]; }
  GUARANTEE { &&[0 <= i < N] (a[i] -> b[i]); }
}
EOF
# --no-check-info is the default of this tool, and says so.
run 0 ../parsetlsf --no-check-info noinfo.tlsf > nocheckinfo.out 2>&1

# A file without an INFO section at all reports the four items at the
# start of the file.
cat >noinfosection.tlsf <<'EOF'
GLOBAL {
}
MAIN {
}
EOF
# The two files are told apart by the name that prefixes each diagnostic.
( set +x
  run 2 ../parsetlsf --check-info noinfo.tlsf noinfosection.tlsf \
    > /dev/null 2>info.err )
# noinfo is missing exactly DESCRIPTION, SEMANTICS and TARGET -- the
# expectation has no TITLE line and no syntax error -- and noinfosection,
# which has no INFO section at all, reports all four items exactly once.
cat >infocheck.err.exp <<'EOF'
noinfo.tlsf:1.1-4: missing mandatory INFO item 'DESCRIPTION:'
noinfo.tlsf:1.1-4: missing mandatory INFO item 'SEMANTICS:'
noinfo.tlsf:1.1-4: missing mandatory INFO item 'TARGET:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'TITLE:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'DESCRIPTION:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'SEMANTICS:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'TARGET:'
2 of 2 files failed
EOF
fold -w 70 info.err | sed 's/ *$//' > infocheck.err.fold
diff -u infocheck.err.exp infocheck.err.fold

# A duplicated INFO item is a mistake whatever --check-info says.  The
# grammar already knows the item, so the second one is reported and
# dropped, and the first one keeps the value it set.
cat >dupinfo.tlsf <<'EOF'
INFO {
  TITLE:       "first"
  TITLE:       "second"
  TAGS:        t1
  TAGS:        t2
  DESCRIPTION: "duplicate INFO items"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
run 2 ../parsetlsf dupinfo.tlsf > dupinfo.err 2>&1
grep -q "dupinfo.tlsf:3.3-8: duplicate INFO item 'TITLE:'" dupinfo.err
grep -q "dupinfo.tlsf:5.3-7: duplicate INFO item 'TAGS:'" dupinfo.err
run 2 ../parsetlsf --no-check-info dupinfo.tlsf > dupinfo2.err 2>&1
grep -q "dupinfo.tlsf:3.3-8: duplicate INFO item 'TITLE:'" dupinfo2.err

# A `TAGS:` list is a list of identifiers and nothing else: syfco reads
# each entry with a raw identifier parser, so a tag may be spelled like
# any word of the language, keyword or not, and it may even be the name
# of a section.  The list is scanned in a state of its own in which no
# keyword is recognized; the five INFO item keys are the only way out
# of it, and the bare `Mealy`/`Moore`/`Strict`/`Finite` words are only
# ever the value of SEMANTICS or TARGET, so in tag position they are
# ordinary identifiers.
#
# The words are checked with a direct call rather than through `run`:
# there are far too many of them to pay for valgrind, and nothing here
# is new memory management, only a start condition.
for w in G F X NOT SIZEOF true false U R W IN AND OR IMPLIES EQUIV \
         EQ NEQ LE GE LEQ GEQ ELEM CUP CAP SETMINUS PLUS MINUS MUL \
         DIV MOD FORALL EXISTS MIN MAX SUM PROD Mealy Moore Strict \
         Finite MAIN GLOBAL INFO PARAMETERS DEFINITIONS INPUTS \
         OUTPUTS INITIALLY PRESET REQUIRE REQUIREMENTS ASSERT \
         INVARIANTS GUARANTEE GUARANTEES ASSUME ASSUMPTIONS TAGS; do
  cat >tags.tlsf <<EOF
INFO {
  TITLE:       "a tag spelled like a word"
  DESCRIPTION: "one word at a time"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS: $w
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
  ../parsetlsf tags.tlsf > tags.f
  grep -q "G(a -> b)" tags.f
  if $test_syfco; then
    syfco -c tags.tlsf > /dev/null
  fi
done
# Several of them at once, and with the comments and newlines that a
# list may contain; the words around it stay words.
cat >tagsmany.tlsf <<'EOF'
INFO {
  TITLE:       "many tags"
  DESCRIPTION: "every entry is an identifier"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  /* a comment */ TAGS: G, U, // another one
    AND, true, MAIN, TAGS /* and one more */
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
../parsetlsf tagsmany.tlsf > tagsmany.f
grep -q "G(a -> b)" tagsmany.f
if $test_syfco; then
  syfco -c tagsmany.tlsf > /dev/null
fi
# The list may be empty -- syfco builds it with `commaSep`, which takes
# no element at all -- and an entry need not name anything the file
# declares.
cat >tagsnone.tlsf <<'EOF'
INFO {
  TITLE:       "no tags"
  DESCRIPTION: "an empty list, then a name of nothing"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS:
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
../parsetlsf tagsnone.tlsf > tagsnone.f
grep -q "G(a -> b)" tagsnone.f
sed 's/  TAGS:/  TAGS: nosuchdefinition/' tagsnone.tlsf > tagsundef.tlsf
../parsetlsf tagsundef.tlsf > tagsundef.f
cmp tagsnone.f tagsundef.f
if $test_syfco; then
  syfco -c tagsnone.tlsf > /dev/null
  syfco -c tagsundef.tlsf > /dev/null
fi
# `TAGS:` is not the only thing a tag list may be followed by, and the
# item it is followed by is read as that item, not as a tag.
cat >tagsmid.tlsf <<'EOF'
INFO {
  TAGS:        X
  TITLE:       "tags first"
  DESCRIPTION: "the list ends at the next item"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
../parsetlsf tagsmid.tlsf > tagsmid.f
grep -q "G(a -> b)" tagsmid.f
# A colon that no item key explains is diagnosed where it is, and the
# state is left behind, so the rest of the INFO section is not
# mis-lexed.
cat >tagscolon.tlsf <<'EOF'
INFO {
  TITLE:       "stray colon"
  DESCRIPTION: "a word that is not an item key"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS: FOO: "x"
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
( set +x
  ! ../parsetlsf tagscolon.tlsf > /dev/null 2>tagscolon.err )
cat >tagscolon.exp <<EOF
tagscolon.tlsf:6.9-12: syntax error, unexpected :
EOF
diff tagscolon.err tagscolon.exp

# An entry is an identifier, not a number and not a string, and a
# missing comma is a syntax error: syfco rejects all three too.
for bad in '5' '"arbiter"' 'a b' 'a,'; do
  sed "s/  TAGS: FOO: \"x\"/  TAGS: $bad/" tagscolon.tlsf > tagsbad.tlsf
  ( set +x
    ! ../parsetlsf tagsbad.tlsf > /dev/null 2>/dev/null )
  if $test_syfco; then
    ! syfco -c tagsbad.tlsf > /dev/null 2>/dev/null
  fi
done
# SEMANTICS and TARGET must agree on the system model.  A file that
# contradicts itself is ambiguous, not unusable: the composition named
# by SEMANTICS is built, and the mismatch is a warning, so the
# translation still succeeds.
cat >mismatch.tlsf <<'EOF'
INFO {
  TITLE:       "mismatch"
  DESCRIPTION: "Moore semantics with a Mealy target"
  SEMANTICS:   Moore
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
# The strict and finite modifiers do not change the system model, so
# they are matched against the target the same way.
cat >mismatch2.tlsf <<'EOF'
INFO {
  TITLE:       "mismatch2"
  DESCRIPTION: "Mealy,Finite semantics with a Moore target"
  SEMANTICS:   Mealy,Finite
  TARGET:      Moore
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
# A specification that spells out only one of the two cannot be
# compared, so the missing one is not an ambiguity (it is a missing
# mandatory item, which the tools below diagnose).
cat >nosemantics.tlsf <<'EOF'
INFO {
  TITLE:       "nosemantics"
  DESCRIPTION: "a Mealy target with no SEMANTICS item"
  TARGET:      Mealy
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
# Both of its streams are compared as a whole.  Two of the warnings are
# one line each, and the absence of a warning is pinned by the
# expectation not holding one: nosemantics has no SEMANTICS item, so it is
# not ambiguous.
( set +x
  run 0 ../parsetlsf enumjoin3.tlsf noinfo.tlsf mismatch.tlsf \
    mismatch2.tlsf nosemantics.tlsf > info.all 2>info.err )
cat >info.exp <<'EOF'
=== enumjoin3.tlsf ===
G(grant <-> req)
=== noinfo.tlsf ===
(a_0 -> b_0) & (a_1 -> b_1)
=== mismatch.tlsf ===
G(a -> b)
=== mismatch2.tlsf ===
G(a -> b)
=== nosemantics.tlsf ===
G(a -> b)
EOF
diff -u info.exp info.all
# The two warnings are long, so the expectation is written already folded
# at 70 columns and the actual stream is folded the same way.
cat >info.err.exp <<'EOF'
mismatch.tlsf:4.3-12: SEMANTICS declares a Moore system model, but TAR
GET declares Mealy; the specification is ambiguous, the Moore composit
ion is used
mismatch2.tlsf:4.3-12: SEMANTICS declares a Mealy system model, but TA
RGET declares Moore; the specification is ambiguous, the Mealy composi
tion is used
EOF
fold -w 70 info.err | sed 's/ *$//' > info.err.fold
diff -u info.err.exp info.err.fold
run 2 ../parsetlsf --check-info nosemantics.tlsf > nosemantics2.err 2>&1
grep -q "nosemantics.tlsf:1.1-4: missing mandatory INFO item" nosemantics2.err
grep -q "missing mandatory INFO item 'SEMANTICS:'" nosemantics2.err
# A warning is not an error: the tools that diagnose it keep going.
cat >ambiguous.tlsf <<'EOF'
INFO {
  TITLE:       "ambiguous"
  DESCRIPTION: "Mealy,Finite semantics with a Moore target"
  SEMANTICS:   Mealy,Finite
  TARGET:      Moore
}
GLOBAL {
  PARAMETERS { N = 1; }
}
MAIN {
  INPUTS  { a[N]; }
  OUTPUTS { b[N]; }
  GUARANTEE { &&[0 <= i < N] (a[i] -> b[i]); }
}
EOF
run 0 ltlf2dfa --tlsf=ambiguous.tlsf > ambiguous.hoa 2> ambiguous.err
grep -q "ambiguous.tlsf:4.3-12: SEMANTICS declares a Mealy" ambiguous.err
grep -q ".* but TARGET declares Moore" ambiguous.err
grep -q "^HOA: v1" ambiguous.hoa
# A collision, on the other hand, is fatal everywhere.
run 2 ltlf2dfa --tlsf=clash2.tlsf > clash3.out 2> clash4.err
grep -q "'sig' is already declared as an input signal" clash4.err
# And so is a file without the mandatory INFO items, which is what
# the tools diagnose.
run 2 ltlf2dfa --tlsf=nosemantics.tlsf > nosem2.out 2> nosem2.err
grep -q "missing mandatory INFO item 'SEMANTICS:'" nosem2.err

# A diagnostic raised by the translation, as opposed to by the parser,
# is prefixed with the file name by the tools as well, not only by
# ../parsetlsf: a spot::location does not record a file name, so the
# printer supplies it, and bin/common_tlsf.cc does the same as
# ../parsetlsf does.  The spec must be Finite for ltlf2dfa, which is
# what gets it as far as the translation.
cat >clidiag.tlsf <<'EOF'
INFO {
  TITLE:       "translation diagnostic through a CLI"
  DESCRIPTION: "the name is printed by the tool, not stored"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    enum E = A: 00 B: 01;
  }
}
MAIN {
  INPUTS  { E b; }
  OUTPUTS { z; }
  GUARANTEE { G((b == NOPE) -> z); }
}
EOF
run 2 ltlf2dfa --tlsf=clidiag.tlsf > clidiag.hoa 2> clidiag.err
grep -q "^clidiag\.tlsf:15\.15-17: enum 'E' has no value named 'NOPE'" \
  clidiag.err

# --- argument substitution semantics -------------------------------------
#
# The substitution pass is single-pass with a lexical scope stack
# (subst_expr in translate.cc).  These cases pin the behaviours that
# the rewrite had to preserve, because each one is a way the old
# per-formal `shadowed` set could have been miscompiled.

# A formal used more than once in the body is replaced everywhere,
# and the actual tree is spliced in without being re-substituted.
cat >subst_multi.tlsf <<'EOF'
INFO {
  TITLE:       "formal used twice"
  DESCRIPTION: "single actual, two occurrences of the formal"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    both(x) = x && x;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { both(a); }
}
EOF
run 0 ../parsetlsf subst_multi.tlsf > subst_multi.f
test "a" = "`cat subst_multi.f`"   # a && a simplifies to a

# Two formals in one definition: each occurrence maps to its own
# actual, and the order of the bindings does not matter.
cat >subst_two.tlsf <<'EOF'
INFO {
  TITLE:       "two formals"
  DESCRIPTION: "distinct actuals per formal"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    pair(x, y) = x -> y;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { pair(a, b); }
}
EOF
run 0 ../parsetlsf subst_two.tlsf > subst_two.f
test "a -> b" = "`cat subst_two.f`"

# A formal bound inside an actual must NOT be substituted again by
# the outer definition: the actual is spliced verbatim, so the inner
# parameter keeps its own name and is bound by the inner call.
cat >subst_nested.tlsf <<'EOF'
INFO {
  TITLE:       "nested definition call"
  DESCRIPTION: "inner call passes its own formal through"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    inner(u) = u && u;
    outer(v) = inner(v);
  }
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { z; }
  GUARANTEE { outer(a); }
}
EOF
run 0 ../parsetlsf subst_nested.tlsf > subst_nested.f
test "a" = "`cat subst_nested.f`"

# A quantifier inside the body binds its own loop variable: the loop
# variable is local to the body and must not be captured by the
# formal.  Here the body quantifies over `b`, which is also a formal
# name, so the two would be indistinguishable without the scope.
cat >subst_capture.tlsf <<'EOF'
INFO {
  TITLE:       "quantifier loop variable shadows a formal"
  DESCRIPTION: "the loop variable is local to the body"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  DEFINITIONS {
    wrap(b) = FORALL[b IN {0, 1}] b;
  }
}
MAIN {
  INPUTS  { a; b; }
  OUTPUTS { z; }
  GUARANTEE { wrap(a); }
}
EOF
# The loop variable `b` stays local: the diagnostic must name `b`, not
# the formal's actual, which pins the capture behaviour.
run 2 ../parsetlsf subst_capture.tlsf > subst_capture.f 2> subst_capture.err
grep -q "loop variable 'b' used in LTL position" subst_capture.err

# A BusRef base that names a formal is renamed when the actual is a
# plain identifier, and left alone otherwise (its index is resolved
# later, in integer position).
cat >subst_busref.tlsf <<'EOF'
INFO {
  TITLE:       "busref base rename"
  DESCRIPTION: "a formal used as a bus base"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { n = 2; }
  DEFINITIONS {
    use(s) = s[0];
  }
}
MAIN {
  INPUTS  { a[n]; b[n]; }
  OUTPUTS { z; }
  GUARANTEE { use(a); }
}
EOF
run 0 ../parsetlsf subst_busref.tlsf > subst_busref.f
test "a_0" = "`cat subst_busref.f`"

# Round-trip stability on the substitution cases above.
for f in subst_multi subst_two subst_nested subst_busref; do
  run 0 ../parsetlsf $f.tlsf > $f.f2
  cmp $f.f $f.f2
done

# A specification pathological enough to blow past spot's formula
# child limit must produce a diagnostic, not take the tool down: the
# fnode layer throws std::runtime_error once a formula reaches
# max_formula_children, and tlsf_to_ltl turns that into an error
# entry.  A binder over 70000 values folds into a single conjunction
# with one child per value, which is the cheapest way past the limit.
cat >toomany.tlsf <<'EOF'
INFO {
  TITLE:       "too many children"
  DESCRIPTION: "child-limit stress via a binder fold"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { n = 70000; }
}
MAIN {
  INPUTS  { a[n]; }
  OUTPUTS { g; }
  GUARANTEE { &&[0 <= i < n] a[i]; }
}
EOF
# Exercised through ltlf2dfa rather than ../parsetlsf: the test binary
# ends with assert(fnode::instances_check()), which legitimately
# reports the half-built formula nodes still alive while the exception
# unwound out of tlsf_to_ltl.  A shipped tool carries no such assertion
# and simply reports the error.
run 2 ltlf2dfa --tlsf=toomany.tlsf > toomany.hoa 2> toomany.err
grep -q "quantifier instantiation count exceeds" toomany.err
test ! -s toomany.hoa
