# Non-Mealy semantics are parsed, printed (the printer uses
# format_semantics to normalize them), and translated like any other.
for S in Moore "Moore,Strict" "Moore,Finite"; do
  cat >"$S spec.tlsf" <<EOF
INFO {
  TITLE: "$S semantics"
  DESCRIPTION: "parse/print/translate with the $S semantics"
  SEMANTICS:   $S
  TARGET:      Moore
}
MAIN {
  INPUTS { a; }
  OUTPUTS { z; }
  GUARANTEE { G a; }
}
EOF
  ../parsetlsf "$S spec.tlsf"
done

../parsetlsf kwops.tlsf > kwops.out
cat >kwops.out.exp <<'EOF'
Ga
EOF
diff -u kwops.out.exp kwops.out

../parsetlsf elem.tlsf > elem.out
cat >elem.out.exp <<'EOF'
a
EOF
diff -u elem.out.exp elem.out

../parsetlsf emptyset.tlsf > emptyset.out
# The quantifier ranges over no value, so the conjunction is tt.
cat >emptyset.out.exp <<'EOF'
1
EOF
diff -u emptyset.out.exp emptyset.out
# Parsing a nonexistent file reports "cannot open file" (optionally
# raised as an exception) and leaves a null AST for tlsf_to_ltl.
run 2 ../parsetlsf --tl-empty nosuch.tlsf > tl.empty.err 2>&1
grep -q "tlsf_to_ltl: empty AST" tl.empty.err

# nosuch.tlsf (a nonexistent file) and parsefail.tlsf (an unknown
# section) are translated above, in the batch of files the tool rejects.
# The same two failures with -R are raised instead of collected, so the
# parser gets a chance to recover.
( set +x
  run 2 ../parsetlsf -R nosuch.tlsf -R parsefail.tlsf > /dev/null 2>parseR.err )
grep -q "caught: " parseR.err
grep -q "cannot open file: nosuch.tlsf" parseR.err
grep -q "syntax error" parseR.err
# The fd-based parse_tlsf entry point follows the same behavior; it
# is exercised on a valid spec, on an unreadable descriptor, and on
# a spec that fails to parse.
run 0 ../parsetlsf --from-fd -1 small.tlsf > fromfd.out
grep -q "G(request_0" fromfd.out
# On GNU libc, running --from-fd 999 will fail with EBADF returned by
# fdopen(999, "r").  But fdopen is not required by POSIX to check that
# a file descriptor exist (it "may fail", not "shall fail").  On
# Alpine Linux with Musl, fdopen will ignore the fact that the file
# descriptor does not exist, and will later fail when the scanner
# attempts fread().
run 2 ../parsetlsf --from-fd 999 -R x.tlsf > fromfdR.err 2>&1
grep -Eq 'cannot open descriptor|input in flex scanner failed' fromfdR.err
run 2 ../parsetlsf --from-fd -1 -R parsefail.tlsf > fromfde.err 2>&1
grep -q "caught: " fromfde.err
grep -q "syntax error" fromfde.err
# --check-info requires all four mandatory INFO items, so the three
# files below are each reported once per item they are missing.  They
# are told apart by the name that prefixes each diagnostic, and
# nosemantics, which spells out only one of the two, is told that the
# other is missing rather than that the two disagree.
( set +x
  run 2 ../parsetlsf --check-info noinfo.tlsf noinfosection.tlsf \
    nosemantics.tlsf > /dev/null 2>info.err )
cat >infocheck.err.exp <<'EOF'
noinfo.tlsf:3.1-4: missing mandatory INFO item 'DESCRIPTION:'
noinfo.tlsf:3.1-4: missing mandatory INFO item 'SEMANTICS:'
noinfo.tlsf:3.1-4: missing mandatory INFO item 'TARGET:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'TITLE:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'DESCRIPTION:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'SEMANTICS:'
noinfosection.tlsf:1.1: missing mandatory INFO item 'TARGET:'
nosemantics.tlsf:4.1-4: missing mandatory INFO item 'SEMANTICS:'
3 of 3 files failed
EOF
fold -w 70 info.err | sed 's/ *$//' > infocheck.err.fold
diff -u infocheck.err.exp infocheck.err.fold
# A `TAGS:` list is a list of identifiers and nothing else: syfco reads
# each entry with a raw identifier parser, so a tag may be spelled like
# any word of the language, keyword or not, and it may even be the name
# of a section.  The list is scanned in a state of its own in which no
# keyword is recognized; the five INFO item keys are the only way out
# of it, and the bare `Mealy`/`Moore`/`Strict`/`Finite` words are only
# ever the value of SEMANTICS or TARGET, so in tag position they are
# ordinary identifiers.
#
# The words are checked with a direct call rather than through `run`:
# there are far too many of them to pay for valgrind, and nothing here
# is new memory management, only a start condition.
for w in G F X NOT SIZEOF true false U R W IN AND OR IMPLIES EQUIV \
         EQ NEQ LE GE LEQ GEQ ELEM CUP CAP SETMINUS PLUS MINUS MUL \
         DIV MOD FORALL EXISTS MIN MAX SUM PROD Mealy Moore Strict \
         Finite MAIN GLOBAL INFO PARAMETERS DEFINITIONS INPUTS \
         OUTPUTS INITIALLY PRESET REQUIRE REQUIREMENTS ASSERT \
         INVARIANTS GUARANTEE GUARANTEES ASSUME ASSUMPTIONS TAGS; do
  cat >tags.tlsf <<EOF
INFO {
  TITLE:       "a tag spelled like a word"
  DESCRIPTION: "one word at a time"
  SEMANTICS:   Mealy
  TARGET:      Mealy
  TAGS: $w
}
GLOBAL {
}
MAIN {
  INPUTS  { a; }
  OUTPUTS { b; }
  GUARANTEE { G(a -> b); }
}
EOF
  ../parsetlsf tags.tlsf > tags.f
true   grep -q "G(a -> b)" tags.f
  if $test_syfco; then
    syfco -c tags.tlsf > /dev/null
  fi
done

../parsetlsf tagsnone.tlsf > tagsnone.f
grep -q "G(a -> b)" tagsnone.f
../parsetlsf tagsundef.tlsf > tagsundef.f
cmp tagsnone.f tagsundef.f
if $test_syfco; then
  syfco -c tagsnone.tlsf > /dev/null
  syfco -c tagsundef.tlsf > /dev/null
fi

../parsetlsf tagsmid.tlsf > tagsmid.f
grep -q "G(a -> b)" tagsmid.f

( set +x
  ! ../parsetlsf tagscolon.tlsf > /dev/null 2>tagscolon.err )
cat >tagscolon.exp <<EOF
tagscolon.tlsf:9.9-12: syntax error, unexpected :
EOF
diff tagscolon.err tagscolon.exp
# An entry is an identifier, not a number and not a string, and a
# missing comma is a syntax error: syfco rejects all three too.
for bad in '5' '"arbiter"' 'a b' 'a,'; do
  sed "s/  TAGS: FOO: \"x\"/  TAGS: $bad/" tagscolon.tlsf > tagsbad.tlsf
  ( set +x
    ! ../parsetlsf tagsbad.tlsf > /dev/null 2>/dev/null )
  if $test_syfco; then
    ! syfco -c tagsbad.tlsf > /dev/null 2>/dev/null
  fi
done
# A collision, on the other hand, is fatal everywhere.
run 2 ltlf2dfa --tlsf=clash2.tlsf > clash3.out 2> clash4.err
grep -q "'sig' is already declared as an input signal" clash4.err
# And so is a file without the mandatory INFO items, which is what
# the tools diagnose.
run 2 ltlf2dfa --tlsf=nosemantics.tlsf > nosem2.out 2> nosem2.err
grep -q "missing mandatory INFO item 'SEMANTICS:'" nosem2.err



run 2 ltlf2dfa --tlsf=clidiag.tlsf > clidiag.hoa 2> clidiag.err
grep -q "^clidiag\.tlsf:21\.15-17: enum 'E' has no value named 'NOPE'" \
  clidiag.err
# --- argument substitution semantics -------------------------------------
#
# The substitution pass is single-pass with a lexical scope stack
# (subst_expr in translate.cc).  These cases pin the behaviours that
# the rewrite had to preserve, because each one is a way the old
# per-formal `shadowed` set could have been miscompiled.
# Round-trip stability on the substitution cases above: reading back
# what the printer wrote must print the same thing again.  Each file is
# named twice in one invocation, so the stream is the same sequence of
# blocks twice, which is what the comparison below asks.
( set +x
  run 0 ../parsetlsf subst_multi.tlsf subst_two.tlsf subst_nested.tlsf \
    subst_busref.tlsf subst_multi.tlsf subst_two.tlsf subst_nested.tlsf \
    subst_busref.tlsf > subst.f2 )
$AWK '/^=== / { out = ++n > 4 ? "subst.b" : "subst.a" }
      out { print > out }' subst.f2
cmp subst.a subst.b
# Exercised through ltlf2dfa rather than ../parsetlsf: the test binary
# ends with assert(fnode::instances_check()), which legitimately
# reports the half-built formula nodes still alive while the exception
# unwound out of tlsf_to_ltl.  A shipped tool carries no such assertion
# and simply reports the error.
run 2 ltlf2dfa --tlsf=toomany.tlsf > toomany.hoa 2> toomany.err
grep -q "quantifier instantiation count exceeds" toomany.err
test ! -s toomany.hoa
# Cross-checks against syfco, the external TLSF compiler.  They are
# opt-in: see the note next to the TEST_SYFCO probe at the top of this
# file.
# --------------------------------------------------------------------------

( set +x
  run 0 ../parsetlsf nested.tlsf nestedplain.tlsf > nested.all )
cat >nested.exp <<'EOF'
=== nested.tlsf ===
G(req_0 -> Fack)
=== nestedplain.tlsf ===
G(req_0 -> Fack)
EOF
diff -u nested.exp nested.all
if $test_syfco; then
  syfco -c nested.tlsf > /dev/null
  syfco -f ltlxba -m fully nested.tlsf > syfco-nested.f
  ../parsetlsf -e "`cat syfco-nested.f`" nested.tlsf > /dev/null
fi

if $test_syfco; then
  # syfco counts the newlines of the comment too, and says so on the
  # same line we do.
  syfco -c nestedlines.tlsf 2>&1 | grep -q "(line 15, column 7)"
fi
( set +x
  run 2 ../parsetlsf nestedlines.tlsf nestedunclosed.tlsf \
    > /dev/null 2>nested.err )
cat >nested.err.exp <<'EOF'
nestedlines.tlsf:15.7: syntax error, unexpected identifier, expecting
}
nestedunclosed.tlsf:13.15-16.1: unclosed comment
nestedunclosed.tlsf:13.15-16.1: syntax error, unexpected end of file,
expecting }
2 of 2 files failed
EOF
fold -w 70 nested.err | sed 's/ *$//' > nested.err.fold
diff -u nested.err.exp nested.err.fold

if $test_syfco; then
  syfco -c sigsecshadow.tlsf > /dev/null
  syfco -c enumkwstate.tlsf > /dev/null
fi
( set +x
  run 0 ../parsetlsf sigsecshadow.tlsf enumkwstate.tlsf > sigsecshadow.all )

../parsetlsf tagsmany.tlsf > tagsmany.f
grep -q "G(a -> b)" tagsmany.f
if $test_syfco; then
  syfco -c tagsmany.tlsf > /dev/null
fi
# The formula of the first file is folded like the other long outputs
# of this test.
fold -w 70 sigsecshadow.all | sed 's/ *$//' > sigsecshadow.fold
cat >sigsecshadow.exp <<'EOF'
=== sigsecshadow.tlsf ===
p_0 & p_1 & (G((p_0 & p_1) | (!p_0 & !p_1)) -> G(MAIN -> (b_0 & !p_0 &
 !p_1 & !(p_0 & p_1))))
=== enumkwstate.tlsf ===
G(!p_0 & !p_1) -> G(!p_0 & !p_1 & (enum -> b))
EOF
diff -u sigsecshadow.exp sigsecshadow.fold

# syfco rejects the unterminated comment too, with its own wording.
if $test_syfco; then
  ! syfco -c nestedunclosed.tlsf
fi

# With TEST_SYFCO set, cross-check signals, target, and formula.
if $test_syfco; then
  syfco -f ltlxba -m fully small.tlsf > syfco-small.f
  ../parsetlsf -e "`cat syfco-small.f`" small.tlsf
  # Compare signal sets, not their order: syfco and spot are free to
  # list signals in different orders.  Ask syfco for the signals in the
  # same `ltlxba` format as the formula: in that syntax upper-case
  # letters are reserved for LTL operators, so syfco lower-cases the
  # signal names, whereas spot preserves the case declared in the TLSF.
  # Hence the case-insensitive comparison.
  syfco -f ltlxba --print-input-signals small.tlsf \
    | tr ', ' '\n' | tr 'A-Z' 'a-z' | sort -u > syfco-small.in
  ../parsetlsf --print-input-signals small.tlsf \
    | tr ', ' '\n' | tr 'A-Z' 'a-z' | sort -u > our-small.in
true   cmp syfco-small.in our-small.in
  syfco -f ltlxba --print-output-signals small.tlsf \
    | tr ', ' '\n' | tr 'A-Z' 'a-z' | sort -u > syfco-small.out
  ../parsetlsf --print-output-signals small.tlsf \
    | tr ', ' '\n' | tr 'A-Z' 'a-z' | sort -u > our-small.out
true   cmp syfco-small.out our-small.out
  test "`syfco --print-target small.tlsf`" = \
       "`../parsetlsf --print-target small.tlsf`"

  for spec in chomp tictactoe scutella1 scutella2 scutella3 scutella4; do
    case $spec in
      chomp) opts="-op N=2 -op M=2";;
      *) opts="";;
    esac
    syfco -f ltlxba-fin -m fully $opts "$spec.tlsf" > syfco-$spec.f
    ../parsetlsf -e "`cat syfco-$spec.f`" $opts "$spec.tlsf"
    # Every native signal must be listed by syfco.
    ../parsetlsf $opts --print-input-signals "$spec.tlsf" \
      > our-in
    syfco -f ltlxba $opts --print-input-signals "$spec.tlsf" > syfco-in
    tr ', ' '\n' < our-in | tr 'A-Z' 'a-z' | sort -u > our-in.sorted
    tr ', ' '\n' < syfco-in | tr 'A-Z' 'a-z' | sort -u > syfco-in.sorted
    test -z "`comm -23 our-in.sorted syfco-in.sorted`"
    ../parsetlsf $opts --print-output-signals "$spec.tlsf" \
      > our-out
    syfco -f ltlxba $opts --print-output-signals "$spec.tlsf" > syfco-out
    tr ', ' '\n' < our-out | tr 'A-Z' 'a-z' | sort -u > our-out.sorted
    tr ', ' '\n' < syfco-out | tr 'A-Z' 'a-z' | sort -u > syfco-out.sorted
    test -z "`comm -23 our-out.sorted syfco-out.sorted`"
    test "`syfco $opts --print-target "$spec.tlsf"`" = \
         "`../parsetlsf $opts --print-target "$spec.tlsf"`"
  done
fi

# No "conversion ... failed" line: the name is resolved while parsing,
# so neither file is ever handed to the translator.
cat >badguard.err.exp <<'EOF'
badguard.tlsf:10.39-47: 'othrewise' is not declared, so it cannot be u
sed as the guard of a definition clause
badguard2.tlsf:10.29-37: 'othrewise' is not declared, so it cannot be
used as the guard of a definition clause
2 of 2 files failed
EOF
if $test_syfco; then
  ! syfco -c badguard.tlsf
  ! syfco -c badguard2.tlsf
fi

# syfco cannot be used to cross-check ANY pattern: its type inference
# has no case for the pattern constructor, so it never processes one
# successfully.  Depending on the file it either reports a type error
# ("expecting: pattern expression", or "Formulas are not allowed on
# the right hand side of a pattern match") or dies with
# `Prelude.undefined`.  Every file below is therefore pinned as
# REJECTED by syfco.  Were a future syfco to start accepting patterns,
# these checks would fail and the cross-checks would have to be
# revisited -- which is the intent.
if $test_syfco; then
  ! syfco -c pattern.tlsf
  ! syfco -c patmatch.tlsf
  ! syfco -c patorder.tlsf
  ! syfco -c patsubj.tlsf
  ! syfco -c patshape.tlsf
  ! syfco -c patstale.tlsf
fi
