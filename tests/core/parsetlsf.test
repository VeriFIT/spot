../parsetlsf goodguard.tlsf > goodguard.f
# Each guard selects its own branch: lit/par/mem/two hold and give a,
# fal and cmp fail and fall through to otherwise's b, and fresh's value
# is the fresh AP nosuchvalue.
cat >goodguard.f.exp <<'EOF'
G(o <-> (a & b & nosuchvalue))
EOF
diff -u goodguard.f.exp goodguard.f
# The `ob`/`ob4` pair is the bound comparison pinned in both
# directions: pbnd matches F[1:2] against F[1:2] and yields ob, while
# pbndno tests the very same pattern against F[2:2] and must fall
# through to ob4.  Every other arm yields its FIRST signal.
cat >pattern.f.exp <<'EOF'
G(oa & ob & ob4 & obp & obr & oe & of & ofi & og & oi & on & on2 & oo & oq & or
& os & oss & ost & ot & ot2 & ou & ow & ow2 & ox)
EOF
fold -w 80 pattern.f.exp | sed 's/ *$//' > pattern.f.fold
../parsetlsf pattern.tlsf | fold -w 80 | sed 's/ *$//' > pattern.f
diff -u pattern.f.fold pattern.f
# The output signals are exactly the ones the file declares: no
# metavariable leaked out of a pattern and registered a signal of its
# own name, which is the visible symptom of a binding not being applied.
cat >pattern.s.exp <<'EOF'
ow,ow2,ow3,ot,ot2,ot3,of,of2,on,on2,on3,ox,ox2,os,os2,ofi,ofi2,og,og2,ou,ou2,or,
or2,oi,oi2,oe,oe2,oo,oo2,oa,oa2,ob,ob2,ob3,ob4,obr,obr2,obp,obp2,ost,ost2,oss,os
s2,oq,oq2,z
EOF
fold -w 80 pattern.s.exp | sed 's/ *$//' > pattern.s.fold
../parsetlsf --print-output-signals pattern.tlsf \
  | tr '\n' ' ' | fold -w 80 | sed 's/ *$//' > pattern.s.fold.raw
echo >> pattern.s.fold.raw
mv pattern.s.fold.raw pattern.s

cat >patmatch.f.exp <<'EOF'
G(y <-> (u & XGu))
EOF
../parsetlsf patmatch.tlsf > patmatch.f
diff -u patmatch.f.exp patmatch.f

