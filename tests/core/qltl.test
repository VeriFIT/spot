# Check several options of ltlfilt

. ./defs || exit 1

set -e

checkopt()
{
  cat >exp
  run 0 ltlfilt "$@" formulas > out
  diff -u exp out
}

cat >formulas <<\EOF
\exists a: a U b
\exists a, b: a U b
\forall a: \exists b: a U b
\forall a, b: a U b
\exists c: a U b
\exists a, c: a U b
\forall a, e: \exists b, c: (a -> b) & (c xor d)
EOF

checkopt -r1 <<\EOF
Fb
1
1
0
a U b
Fb
\exists c: ((c & !d) | (!c & d))
EOF
