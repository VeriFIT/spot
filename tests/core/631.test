. ./defs

set -e

# Issue #631.  The hashing function used in tgba_determinize was quite
# poor, consing robin_hood to abort on formulas such as the following.
# In practice the error was not seen very often, because other
# optimizations (such as simulation-based reduction, or
# wdba-minimization) would be used before resorting to
# tgba_determinize.

genltl --tv-f1=10..11 --tv-f2=10..11 |
  ltl2tgba -x wdba-minimize=0,simul=0,new-oblig=0 -GDC --low --stats=%s >out
cat >exp <<EOF
31522
107618
31522
107618
EOF
diff exp out
