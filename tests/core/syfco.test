#! /bin/sh
# -*- coding: utf-8 -*-
# Copyright (C) by the Spot authors, see the AUTHORS file for details.
#
# This file is part of Spot, a model checking library.
#
# Spot is free software; you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 3 of the License, or
# (at your option) any later version.
#
# Spot is distributed in the hope that it will be useful, but WITHOUT
# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY
# or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public
# License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

. ./defs || exit 1
set -e

# Test that we can pass a TLSF specification to any tool that reads
# LTL or LTLf formulas, via its --tlsf option.  This used to require
# the external syfco tool; it now works with the TLSF parser embedded
# in Spot.  When syfco is installed, the same checks are also run with
# the SPOT_TLSF_PARSER environment variable set to syfco, to make sure
# that backend is still functional.

backends=spot
if syfco --version >/dev/null 2>&1; then
  backends="spot syfco"
  # Absolute path of the real syfco, resolved here, before the shim of
  # the invocation-counting section below is created.  Resolving it
  # later would find the shim instead, and the shim would exec itself.
  syfco_real=`command -v syfco`
fi

for backend in $backends; do
  export SPOT_TLSF_PARSER=$backend

cat >test.tlsf <<EOF
INFO {
  TITLE:       "example"
  DESCRIPTION: "test case"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
GLOBAL {
  PARAMETERS { n=2; }
}
MAIN {
  INPUTS { in; }
  OUTPUTS { out[n]; }
  GUARANTEE { &&[0 <= x < n] G((in) <-> X(out[x])); }
}
EOF

test REALIZABLE = `ltlsynt --tlsf test.tlsf --realizability`
test UNREALIZABLE = `ltlsynt --tlsf test.tlsf --outs=foo --realizability`
test UNREALIZABLE = `ltlsynt --outs=foo --tlsf test.tlsf --realizability`

# --tlsf can be used several time
ltlsynt --tlsf test.tlsf >out1
ltlsynt --tlsf test.tlsf --tlsf test.tlsf >out2
cat out1 out1 > out11
diff out11 out2

# Do it again, without decomposition, also try changing the parameter
ltlsynt --tlsf test.tlsf/n=1 --tlsf test.tlsf/n=3 --decompose=no \
        --obligation=false > out2

ltlsynt --tlsf test.tlsf/n=1 --tlsf test.tlsf/n=3 --decompose=no \
        --print-game >pgame.hoa
ltlsynt --from-pgame pgame.hoa > out3
diff out2 out3

# Make sure the parameters were actually used
test 2 = `grep out_0 out3 | wc -l`
test 1 = `grep out_1 out3 | wc -l`
test 1 = `grep out_2 out3 | wc -l`

# Signals declared with upper-case letters must be handled
# consistently: the built-in parser preserves their case, while syfco
# lower-cases the atomic propositions of the LTL formula it outputs
# (upper-case letters may be confused with LTL operators in the
# ltlxba syntax).  When the syfco backend is used, the list of output
# signals is therefore requested with the same "-f ltlxba" option as
# the formula, so that the signal names match the formula's APs.
cat >upper.tlsf <<EOF
INFO {
  TITLE:       "upper"
  DESCRIPTION: "signals with upper-case letters"
  SEMANTICS:   Mealy
  TARGET:      Mealy
}
MAIN {
  INPUTS { AIn; }
  OUTPUTS { BOut; }
  GUARANTEE { G(AIn <-> X BOut); }
}
EOF
if test $backend = spot; then
  expected_aps='AP: 2 "AIn" "BOut"'
else
  expected_aps='AP: 2 "ain" "bout"'
fi
test REALIZABLE = `ltlsynt --tlsf upper.tlsf --realizability`
ltlsynt --tlsf upper.tlsf >upper.hoa
test "$expected_aps" = "`grep '^AP:' upper.hoa`"
# In both cases the only output signal is the controllable AP.
test "controllable-AP: 1" = "`grep '^controllable-AP:' upper.hoa`"

# Finite semantics
sed '/SEMANTICS:/s/Mealy/&,Finite/' test.tlsf >testf.tlsf
test `ltlfsynt --tlsf testf.tlsf/n=3 --real` = "UNREALIZABLE"

# Exit statuses: 0 = realizable, 1 = unrealizable, 2 = error.
# Commands exiting 0 or 1 are expected here, so disable "set -e"
# while running them, and check the recorded statuses afterwards.
set +e
ltlsynt --tlsf test.tlsf --realizability >/dev/null
s1=$?
ltlsynt --outs=foo --tlsf test.tlsf --realizability >/dev/null
s2=$?
ltlsynt --tlsf nonexistent.tlsf --realizability 2>err
s3=$?
ltlfsynt --tlsf testf.tlsf/n=3 --real >/dev/null
s4=$?
ltlfsynt --tlsf test.tlsf --real 2>err    # not a Finite spec
s5=$?
ltlf2dfa --tlsf test.tlsf 2>err           # not a Finite spec
s6=$?
set -e
test $s1 = 0
test $s2 = 1
test $s3 = 2
test $s4 = 1
test $s5 = 2
test $s6 = 2

ltlf2dfa --tlsf testf.tlsf/n=4 >out.hoa
test "3,5" = `autfilt --stats=%s,%x out.hoa`

# --tlsf is not limited to the synthesis tools: every tool that reads
# LTL or LTLf formulas accepts it, and just processes the formula the
# specification is translated to.
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = "`ltlfilt --tlsf test.tlsf`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = "`ltlfilt --tlsf testf.tlsf`"

# The INPUTS and OUTPUTS of the specification are declared as the I/O
# partition while its formula is processed, so --relabel=io renames
# the inputs to i0, i1,... and the outputs to o0, o1,...
test 'G(i0 <-> Xo0) & G(i0 <-> Xo1)' = \
  "`ltlfilt --tlsf test.tlsf --relabel=io`"
test 'G(i0 <-> Xo0) & G(i0 <-> Xo1)' = \
  "`ltlfilt --tlsf testf.tlsf --relabel=io`"

# ... and --save-part-file writes that same partition.
ltlfilt --tlsf test.tlsf --save-part-file=out.part >/dev/null
cat >expected <<\EOF
.inputs in
.outputs out_0 out_1
EOF
diff out.part expected

# An explicit --ins/--outs takes precedence over the specification.
test 'G(i0 <-> Xo0) & G(i0 <-> Xo1)' = "`ltlfilt --tlsf test.tlsf \
  --relabel=io --ins=in --outs=out_0,out_1`"

# The partition declared by the specification is only in effect while
# its own formula is processed, and does not leak to the other inputs.
ltlfilt --tlsf test.tlsf -f 'Gzz' --relabel=io >out 2>err && exit 1
test 'G(i0 <-> Xo0) & G(i0 <-> Xo1)' = "`cat out`"
grep "does not start with 'i' or 'o'" err

# ltl2tgba accepts both kinds of specification; --ltlf is only needed
# to translate the LTLf one with finite-trace semantics.
ltl2tgba --tlsf test.tlsf >out.hoa
test "3,3" = `autfilt --stats=%s,%x out.hoa`
ltl2tgba --tlsf testf.tlsf >out.hoa
test "3,3" = `autfilt --stats=%s,%x out.hoa`
ltl2tgba --ltlf --tlsf testf.tlsf >out.hoa
test "3,3" = `autfilt --stats=%s,%x out.hoa`

# ltlgrind and ltlmix do not care whether they work on LTL or LTLf.
test 'G(in <-> Xout_0)' = "`ltlgrind --tlsf test.tlsf | head -1`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlmix --tree-size=1 --tlsf test.tlsf`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlmix --tree-size=1 --tlsf testf.tlsf`"

# ltlcross and ltldo only accept infinite specifications.
ltlcross --tlsf test.tlsf 'ltl2tgba -f %f >%O' 2>&1 |
  grep -q 'No problem detected.'
ltldo --tlsf test.tlsf 'ltl2tgba -f %f >%O' > out.hoa
grep -q 'AP: 3' out.hoa

set +e
ltlcross --tlsf testf.tlsf 'ltl2tgba -f %f >%O' 2>err
s7=$?
ltldo --tlsf testf.tlsf 'ltl2tgba -f %f >%O' 2>>err
s8=$?
ltlfilt --tlsf nonexistent.tlsf 2>>err
s9=$?
set -e
test $s7 = 2
test $s8 = 2
test $s9 = 2
# The spot backend diagnoses the semantics mismatch itself.  The syfco
# backend asks syfco for an infinite formula, and syfco is the one
# complaining.
if test $backend = spot; then
  test 2 = `grep -c 'declares Finite semantics' err`
fi
grep 'cannot open\|File does not exist' err

# --tlsf-input declares that every input is a TLSF specification, so
# that a whole set of them can be processed at once (as in
# "ltlfilt --tlsf-input *.tlsf") without repeating --tlsf.  Every
# formula source is accepted, and all of them produce the same formula
# as --tlsf.
mkdir -p tlsfs
cp test.tlsf tlsfs/a.tlsf
cp test.tlsf tlsfs/b.tlsf

test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt --tlsf-input -F test.tlsf`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt --tlsf-input test.tlsf`"

# The flag may be given after the inputs that it applies to.
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt -F test.tlsf --tlsf-input`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt test.tlsf --tlsf-input`"

# Several specifications at once, which is the point of the option.
# Both the tools whose positional arguments are file names and the
# ones that also accept formula strings accept a glob here.
ltlfilt --tlsf-input tlsfs/a.tlsf tlsfs/b.tlsf > out
cat >expected <<\EOF
G(in <-> Xout_0) & G(in <-> Xout_1)
G(in <-> Xout_0) & G(in <-> Xout_1)
EOF
diff out expected
test 2 = "`ltlfilt --tlsf-input tlsfs/*.tlsf | wc -l`"
test 2 = "`ltl2tgba --tlsf-input tlsfs/*.tlsf | grep -c '^HOA:'`"

# The standard input holds a single specification, whether it is named
# explicitly or read by default because no other input was given.
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt --tlsf-input - < test.tlsf`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlfilt --tlsf-input < test.tlsf`"
test 1 = "`ltl2tgba --tlsf-input < test.tlsf | grep -c '^HOA:'`"

# The partition declared by the specification is honored as usual.
test 'G(i0 <-> Xo0) & G(i0 <-> Xo1)' = \
  "`ltlfilt --tlsf-input -F test.tlsf --relabel=io`"

# Parameter assignments still work, on a file as well as on the
# standard input.
ltlfilt --tlsf-input test.tlsf/n=4 > out
cat >expected <<\EOF
G(in <-> Xout_0) & G(in <-> Xout_1) & G(in <-> Xout_2) & G(in <-> Xout_3)
EOF
diff out expected
ltlf2dfa --tlsf-input testf.tlsf/n=3 > out.hoa
test '"G(in <-> Xout_0) & G(in <-> Xout_1) & G(in <-> Xout_2)"' = \
  "`sed -n 's/^name: //p' out.hoa`"

# --tlsf-input is accepted by every tool that accepts --tlsf, and it
# does not change how a specification is processed.
test REALIZABLE = "`ltlsynt --tlsf-input -F test.tlsf --realizability`"
test REALIZABLE = "`ltlsynt --tlsf-input < test.tlsf --realizability`"
# ltlsynt takes positional arguments as well, so several
# specifications can be processed without repeating --tlsf-input.
test REALIZABLE = "`ltlsynt --tlsf-input test.tlsf --realizability`"
test REALIZABLE = "`ltlsynt --tlsf-input test.tlsf test.tlsf \
                    --realizability | head -1`"
test 2 = "`ltlsynt --tlsf-input test.tlsf test.tlsf --realizability | \
           wc -l`"
test 2 = "`ltlsynt --tlsf-input tlsfs/*.tlsf --realizability | wc -l`"
test UNREALIZABLE = "`ltlfsynt --tlsf-input -F testf.tlsf/n=3 --real`"
test 'G(in <-> Xout_0)' = "`ltlgrind --tlsf-input test.tlsf | head -1`"
test 'G(in <-> Xout_0) & G(in <-> Xout_1)' = \
  "`ltlmix --tree-size=1 --tlsf-input test.tlsf`"
ltlcross --tlsf-input -F test.tlsf 'ltl2tgba -f %f >%O' 2>&1 |
  grep -q 'No problem detected.'
ltldo --tlsf-input -F test.tlsf 'ltl2tgba -f %f >%O' > out.hoa
grep -q 'AP: 3' out.hoa

# An unreadable specification is an error, as with --tlsf.
ltlfilt --tlsf-input nonexistent.tlsf 2>>err && exit 1
grep 'cannot open\|File does not exist' err

# -f and --lbt-input cannot be combined with --tlsf-input, in either
# order.
set +e
ltlfilt --tlsf-input -f 'G p' 2>err
s10=$?
ltlfilt -f 'G p' --tlsf-input 2>>err
s11=$?
ltlfilt --tlsf-input --lbt-input -F test.tlsf 2>>err
s12=$?
ltlfilt --lbt-input --tlsf-input -F test.tlsf 2>>err
s13=$?
set -e
test $s10 = 2
test $s11 = 2
test $s12 = 2
test $s13 = 2
test 2 = `grep -c 'formula string is not a TLSF specification' err`
test 2 = `grep -c 'mutually exclusive' err`

# The syfco backend invokes the external tool once per requested item.
# Check that each tool only asks syfco for what it actually uses, by
# putting a syfco that logs its arguments first in $PATH.
if test $backend = syfco; then
  # A subshell, so that neither the shim nor the modified $PATH leaks
  # into the rest of this iteration or the next one.
  (
    # Print how many times syfco was invoked by the given command.
    count_syfco()
    {
      : > syfco.log
      "$@" >/dev/null 2>&1 || true
      wc -l < syfco.log
    }

    cat >syfco <<EOF
#!/bin/sh
echo "\$*" >> syfco.log
exec $syfco_real "\$@"
EOF
    chmod +x syfco
    PATH=".:$PATH"
    export PATH

    # ltlfilt asks for the I/O partition only for --relabel=io and
    # --save-part-file, and never for the TARGET of the specification:
    # the semantics probe plus the formula, and one more call for the
    # output signals.
    test 2 = "`count_syfco ltlfilt --tlsf test.tlsf -p`"
    test 3 = "`count_syfco ltlfilt --tlsf test.tlsf --relabel=io -p`"
    test 3 = "`count_syfco ltlfilt --tlsf test.tlsf --save-part-file=- -p`"

    # These two need neither the partition nor the TARGET.
    test 2 = "`count_syfco ltl2tgba --tlsf test.tlsf`"
    test 2 = "`count_syfco ltlgrind --tlsf test.tlsf`"

    # ltlmix needs neither the partition nor the TARGET either, and it
    # only asks for the partition when '-A N,M' is used without a
    # partition of our own.  It still probes the SEMANTICS, because it
    # accepts both finite and infinite specifications and so has to
    # choose between ltlxba and ltlxba-fin.
    test 2 = "`count_syfco ltlmix --tlsf test.tlsf`"
    test 3 = "`count_syfco ltlmix -A 1,1 --tlsf test.tlsf`"
    test 2 = "`count_syfco ltlmix -A 1,1 --tlsf test.tlsf --ins in`"

    # ltlcross and ltldo know the semantics is infinite, so they do not
    # need the probe either, and they use neither the partition nor the
    # TARGET: the formula alone is enough.
    test 1 = "`count_syfco ltlcross --tlsf test.tlsf 'ltl2tgba -f %f >%O'`"
    test 1 = "`count_syfco ltldo --tlsf test.tlsf 'ltl2tgba -f %f >%O'`"

    # The synthesis tools need the partition, the semantics and the
    # TARGET.
    test 3 = "`count_syfco ltlsynt --tlsf test.tlsf --realizability`"
    test 3 = "`count_syfco ltlfsynt --tlsf testf.tlsf --real`"

    # ltlf2dfa needs neither.
    test 1 = "`count_syfco ltlf2dfa --tlsf testf.tlsf`"

    # --tlsf-input costs no extra invocation, whether it is used to
    # read a file, a glob, or the standard input.
    test 2 = "`count_syfco ltlfilt --tlsf-input -p test.tlsf`"
    test 3 = "`count_syfco ltlfilt --tlsf-input -p test.tlsf --relabel=io`"
    test 2 = "`count_syfco ltlfilt --tlsf-input -p - < test.tlsf`"

    rm -f syfco syfco.log
  )
fi

cat >chomp.tlsf <<EOF
INFO {
  TITLE:       "Chomp Game"
  DESCRIPTION: "Parameteric Chomp Game over a NxM grid"
  SEMANTICS:   Mealy,Finite
  TARGET:      Mealy
}

GLOBAL {
  PARAMETERS {
    N = 3;
    M = 3;
  }
  DEFINITIONS {
    Pos(grid, i, j) = grid[i + j * N];
    PickOne(sel) = ||[0 <= k < (SIZEOF sel)] sel[k];
    // if sel[i] is true, sel[i+1] should be too.
    AboveToo(sel) = &&[0 <= i < ((SIZEOF sel) - 1)] (sel[i] -> sel[i+1]);
    // if it's the other's turn, all values of sel should be false
    OtherTurn(other, sel) = other -> (&&[0 <= k < (SIZEOF sel)](!sel[k]));
    // if it's the other's turn and square (0,0) still exists, our
    // choices for sx and sy on next turn depend on what square is
    // available in the grid.
    NextChoices(grid, other, sx, sy) =
      (Pos(grid, 0, 0) && other) ->
        (||[0 <= x < N] ||[0 <= y < M] (Pos(grid, x, y) && X(sx[x] && sy[y])));
    // Rules that both players should obey
    PlayerRules(grid, other, sx, sy) =
       AboveToo(sx) &&
       AboveToo(sy) &&
       OtherTurn(other, sx) &&
       OtherTurn(other, sy) &&
       NextChoices(grid, other, sx, sy);
  }
}

MAIN {
  INPUTS {
    // When it's the input player's turn, they
    // use ix[I] iy[J] to select square (I,J).
    ix[N];
    iy[M];
  }
  OUTPUTS {
    // When it's the output player's turn, they
    // use ox[I] oy[J] to select square (I,J).
    ox[N];
    oy[M];
    // whether a square is available
    os[N*M];
    // turn
    oti; // input turn
    oto; // output turn
  }
  PRESET {
    // The output player is the first player.
    !oti && oto;
    // The output player has to choose a square.
    PickOne(ox);
    PickOne(oy);
    // The squares that are taken initially depend on the first choice.
    &&[0 <= i < N] &&[0 <= j < M] (Pos(os, i, j) <-> !(ox[i] && oy[j]));

    // Turns alternate between players.
    // (Writing G(oto <-> X oti) would be ok in LTL, but not LTLf.)
    G(oti <-> !oto);
    G(oto -> X oti);
    G(oti -> X oto);
  }
  REQUIRE {
    PlayerRules(os, oto, ix, iy);
  }
  ASSERT {
    PlayerRules(os, oti, ox, oy);
    // If (i,j) is selected by either player, then (i,j) should become false.
    &&[0 <= i < N] &&[0 <= j < M]
      (((ox[i] && oy[j]) || (ix[i] && iy[j])) -> !Pos(os,i,j));
    // if (i,j) is not available now, it's not available on next turn.
    &&[0 <= i < N] &&[0 <= j < M] ((!Pos(os,i,j)) -> X !(Pos(os,i,j)));
    // if (i,j) is available now, it might not be on next turn.
    &&[0 <= i < N] &&[0 <= j < M]
      (Pos(os,i,j) -> X(Pos(os,i,j) || (ox[i] && oy[j]) || (ix[i] && iy[j])));
  }
  GUARANTEE {
    // The game finishes once square (0, 0) has been taken, and since
    // this square is poisonous, we want the input player to take it.
    Pos(os,0,0) U (!Pos(os,0,0) && oti);
  }
}
EOF
ltlf2dfa --tlsf chomp.tlsf/N=2,M=2 --mtdfa-stats=paths >out
cat >expected <<\EOF
states: 18
aps: 14
internal nodes: 226
terminal nodes: 17
constant nodes: 1 (true)
total nodes: 244 (4KB)
paths: 1235
edges: 68
BuDDy nodenum: 524288 (8192KB)
BuDDy freenodes: 513306 (97.91%)
BuDDy produced: 10980
BuDDy cachesize: 16384 (256KB * 6 = 1536KB)
BuDDy hashsize: 524288 (2048KB)
BuDDy gbcnum: 0
EOF
diff out expected

done
